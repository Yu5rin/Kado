<Window x:Class="AppBarProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppBar 検証"
        Width="352" Height="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="12"
        Background="#FBFBFC">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#585F6E">
            ピン留めすると画面端にワークエリアを確保します。<LineBreak />
            <Bold>他のウィンドウを最大化しても重ならないこと</Bold>を確認してください。
        </TextBlock>

        <!-- 辺と幅 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="辺" VerticalAlignment="Center" Foreground="#8F96A4" Margin="0,0,6,0" />
            <ComboBox x:Name="EdgeBox" Width="84" SelectedIndex="1" SelectionChanged="OnEdgeChanged">
                <ComboBoxItem Content="左" />
                <ComboBoxItem Content="右" />
            </ComboBox>
            <TextBlock Text="幅" VerticalAlignment="Center" Foreground="#8F96A4" Margin="14,0,6,0" />
            <TextBox x:Name="WidthBox" Width="60" Text="352" TextAlignment="Right" />
            <TextBlock Text="px" VerticalAlignment="Center" Foreground="#8F96A4" Margin="4,0,0,0" />
        </StackPanel>

        <!-- 隣のウィンドウの影で空く隙間を埋める量 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="隙間埋め" VerticalAlignment="Center" Foreground="#8F96A4" Margin="0,0,6,0" />
            <TextBox x:Name="OverlapBox" Width="46" Text="0" TextAlignment="Right" />
            <TextBlock Text="px" VerticalAlignment="Center" Foreground="#8F96A4" Margin="4,0,8,0" />
            <TextBlock Text="隣のウィンドウの影ぶん広げる" VerticalAlignment="Center"
                       Foreground="#8F96A4" FontSize="10.5" TextWrapping="Wrap" Width="150" />
        </StackPanel>

        <!-- ピン留め -->
        <ToggleButton Grid.Row="3" x:Name="PinButton" Height="36" Margin="0,0,0,10"
                      Content="ピン留めする（AppBar 登録）"
                      Checked="OnPinChecked" Unchecked="OnPinUnchecked" />

        <!-- ログ -->
        <Border Grid.Row="4" BorderBrush="#E2E4EA" BorderThickness="1" CornerRadius="4" Background="White">
            <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                     Padding="8" FontFamily="Consolas, Yu Gothic UI" FontSize="11"
                     Foreground="#1C2029" Background="Transparent" />
        </Border>

        <!-- 安全装置の検証 -->
        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="安全装置の検証" Foreground="#8F96A4" Margin="0,0,0,4" />
            <Button x:Name="CrashButton" Height="30" Content="わざと例外を出す（自動解除を確認）"
                    Click="OnCrashClick" />
            <Button x:Name="BreakButton" Height="30" Margin="0,6,0,0"
                    Content="ワークエリアをわざと削る（復旧を確認）" Click="OnBreakClick" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#8F96A4" FontSize="11">
                強制終了しても Windows 側が自動で戻すことがあります。<LineBreak />
                上のボタンは壊れた状態を意図的に作り、復旧処理だけを確かめるためのものです。<LineBreak />
                押したあとアプリを終了し、もう一度起動してください。
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
