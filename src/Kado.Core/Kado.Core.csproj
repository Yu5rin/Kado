<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kado.Core</RootNamespace>
    <!-- Core は UI 非依存。Windows 固有 API を参照しないこと -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 配布Excel（実働日ファイル.xlsx）の読み込みに使う。Core の唯一の外部依存 -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kado.Core.Tests" />
  </ItemGroup>

</Project>
