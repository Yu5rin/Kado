<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SlideinaCalendar.Google</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SlideinaCalendar.Google.Tests" />
  </ItemGroup>

  <!--
    既定のクライアント設定を組み立てのときに焼き込む。

      dotnet build -p:GoogleClientId=... -p:GoogleClientSecret=...

    ソースには書かない。リポジトリを公開しても出ないようにするため。値は配布を作る
    ワークフローが GitHub の Secrets から渡す。

    渡さずに組み立てても構わない。そのときは焼き込まれず、利用者が自分で
    client_secret_*.json を読み込ませる従来の形で動く。
  -->
  <ItemGroup Condition="'$(GoogleClientId)' != '' and '$(GoogleClientSecret)' != ''">
    <AssemblyMetadata Include="GoogleClientId" Value="$(GoogleClientId)" />
    <AssemblyMetadata Include="GoogleClientSecret" Value="$(GoogleClientSecret)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlideinaCalendar.Core\SlideinaCalendar.Core.csproj" />
    <ProjectReference Include="..\SlideinaCalendar.Data\SlideinaCalendar.Data.csproj" />
  </ItemGroup>

</Project>
