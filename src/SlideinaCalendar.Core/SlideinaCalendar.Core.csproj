<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SlideinaCalendar.Core</RootNamespace>
    <!-- Core は UI 非依存。Windows 固有 API を参照しないこと -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 配布Excel（ツール用実働日.xlsx）の読み込みに使う。Core の唯一の外部依存 -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SlideinaCalendar.Core.Tests" />
  </ItemGroup>

</Project>
