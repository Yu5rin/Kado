<!--
    コントロールの見た目。寸法は mock-window.html の CSS から取る。

      .ib       28x28 / radius 5 / hover で面を沈める
      .gbtn     h28 / padding 0 11 / 枠 1px
      .seg      外枠 1px / radius 5 / ボタン h28 padding 0 13 / 選択中はアクセントで塗る
      .wdchip   面 ai-soft / radius 5 / padding 3 10 / 数字は 14px でアクセント色
      .search   h28 / 枠 1px / radius 5 / 幅 190
      .calcbtn  幅いっぱい / 枠 1px / radius 5 / padding 6
      .box      15x15 / 枠 1.5px / radius 3.5
      .addrow   枠なし / padding 14,6 / ホバーでだけ面が付く（一覧の1行として地続きに見せる。項目1）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:views="clr-namespace:Kado.App.Views"
                    xmlns:conv="clr-namespace:Kado.App.Converters"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        アイコンはここでも読み込む。別の辞書に置いた StaticResource は、
        親をたどれる保証が無い。Theme.xaml 側の読み込みと重なるが害はない。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:HexBrushConverter x:Key="HexBrush" />

    <!--
        カレンダーの色を、いまの配色の地に合わせて明るさだけ直したブラシにする（表示専用。
        保存する色・Google に送る色・色の選択画面の見本は HexBrush のまま元の色を出す）
    -->
    <conv:DisplayHexBrushConverter x:Key="DisplayHexBrush" />

    <!--
        ポップアップ（右クリックメニュー・ツールチップ・ComboBox の一覧）、サイドバーの面、通知の影。
        8か所に同じ値を直書きしていたのを1つにまとめる（Blur 16 / Depth 2 / Opacity 0.30）。
        文字を載せる Border に直接掛けると文字が滲むので、使う側は影だけを持つ Border に掛ける。
        辞書の先頭に置く（StaticResource は定義より前から引けない）
    -->
    <DropShadowEffect x:Key="PopupShadowEffect" BlurRadius="16" ShadowDepth="2" Opacity="0.30"
                      Direction="270" Color="#000000" />

    <!--
        キーボードで辿ったときの焦点の輪（項目8）。
        Tab で回っても居場所が分からなかった。IconButtonStyle / GhostButtonStyle /
        SegmentButtonStyle / MiniDayStyle の FocusVisualStyle に共通で当てる。
        Margin を負にして、ボタン自身の縁の外側に輪を描く
    -->
    <Style x:Key="FocusRingStyle" TargetType="Control">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                               RadiusX="6" RadiusY="6" Margin="-2"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        無効表示の不透明度。0.55 でも、既に薄い Ink3 系の文字がさらに沈んで読み取れなくなる箇所が
        あったため、0.7 まで上げる（Ink3 の上でも文字として読める濃さ。押せないことは Cursor でも示す）
    -->
    <sys:Double x:Key="DisabledOpacity">0.7</sys:Double>

    <!-- アイコンボタン -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8）。ホバーより濃い面にして押し込んだと分かるようにする -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        押した状態が残るアイコンボタン（ピン）。
        入っているあいだはアクセント色で、留まっていることが一目で分かるようにする
    -->
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        スクロールバー。
        WPF の既定は Windows クラシックの見た目で、配色を切り替えても白いまま残る。
        ダークにすると画面の端だけが明るく浮いて、そこが目に付く。

        矢印のボタンは置かない。今どきのアプリには無く、押されないわりに場所を食う。
        つまみは細く、乗せたときだけ濃くする。
    -->
    <!--
        スクロールバーの太さ。
        時間軸のヘッダはこのぶんだけ場所を空けて、下の列と縦線を揃えている。
        ここを変えたら向こうもずれるので、1か所で持つ
    -->
    <sys:Double x:Key="ScrollBarThickness">11</sys:Double>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Root" CornerRadius="4" Margin="2"
                            Background="{DynamicResource LineStrongBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Ink3Brush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Ink2Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- つまみの外側。押しても飛ばないよう、透明な当たり判定だけ持たせる -->
    <Style x:Key="ScrollTrackButtonStyle" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="{StaticResource ScrollBarThickness}" />
        <Setter Property="MinWidth" Value="{StaticResource ScrollBarThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollTrackButtonStyle}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollTrackButtonStyle}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{StaticResource ScrollBarThickness}" />
                <Setter Property="MinHeight" Value="{StaticResource ScrollBarThickness}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollTrackButtonStyle}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollTrackButtonStyle}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        進捗バー（更新ウィンドウ）。
        暗黙スタイル（x:Key 無し）にする。既定のテンプレートは Aero の緑い光る
        アニメ付きで、Dark / Night の上ではそこだけ Windows クラシックのまま浮く。
        トラック（PART_Track・LineBrush・角丸2）の中に入り（PART_Indicator・
        AccentBrush・左寄せ）という素直な作りにする。ScrollBar と同じく
        PART_Track の名前は ProgressBar 自身が幅の計算に使うので変えられない
    -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" CornerRadius="2"
                            Background="{DynamicResource LineBrush}">
                        <Border x:Name="PART_Indicator" CornerRadius="2"
                                Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Left" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 枠線だけのボタン（今日・実働日計算・＋予定） -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Height" Value="28" />
        <!-- ダイアログのボタンの幅を揃える。幅を詰めたい所（ツールバーなど）は MinWidth="0" を明示する -->
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5"
                            BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                        <!--
                            無効時。SegmentButtonStyle の無効表示（Opacity 0.5 / Cursor を
                            既定へ戻す）に揃える。押せるように見えて何も起きない状態を消す
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        取り返しのつかない操作のボタン（削除・「元に戻せません」の節）。
        Ghost と同じ寸法で、文字と枠を日曜色（赤）にする。ホバーはマイルストーン（出発）の面と文字。
        Ghost のテンプレートはホバーで文字をアクセント色に替えるので、赤のまま残すためテンプレートを持つ
    -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SundayBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5"
                            BorderThickness="1" BorderBrush="{DynamicResource SundayBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource MilestoneGoFaceBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource MilestoneGoTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ビュー切替のセグメント。
        RadioButton の既定テンプレートだと丸印が出てしまうので、丸ごと差し替える。
        選択中はアクセントで塗り、区切り線は右側に引く（最後だけ BorderThickness=0）。
    -->
    <!--
        セグメント（一覧・年・月・週・日、ストリップ・カレンダー、予定・タスク）。

        RadioButton ではなく ToggleButton にしてある。RadioButton は仲間どうしで
        自動的に打ち消し合うが、その「仲間」は GroupName か親で決まる。ここは共通の
        見た目なので GroupName を1つ書いてしまい、<b>ビューの切り替えと年ビューの
        ストリップ／カレンダーが同じ仲間になって、互いに消し合っていた</b>。

        どれが選ばれているかは ViewModel が持っていて、表示は片方向に流すだけでよい。
        打ち消し合う仕掛けそのものが要らない。
    -->
    <Style x:Key="SegmentButtonStyle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="{DynamicResource PanelBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{DynamicResource LineStrongBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8）。未選択は面を、選択中は Opacity 0.8 で示す -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Opacity" Value="0.8" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                            <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- タスクのチェックボックス -->
    <Style x:Key="TaskCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <!--
            押せる範囲は 24x24（四角は 16x16、外側の透明な余白が当たりを広げる）。
            余白のぶん Margin を負にして、並べたときの占有は 16x18（本文1行の高さ）に収める
        -->
        <Setter Property="Margin" Value="-4,-3,-4,-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Width="24" Height="24" Background="Transparent">
                    <Border x:Name="Box" Width="16" Height="16" CornerRadius="3.5"
                            Background="{DynamicResource PanelBrush}"
                            BorderThickness="1.5" BorderBrush="{DynamicResource ControlBorderBrush}">
                        <!--
                            チェックが付いたときの面は DoneBrush（完了を静かに沈める中間トーン）。
                            アクセント面用の OnAccentBrush はここでは向きが逆になることがあるため、
                            DoneBrush 専用の OnDoneBrush を使う
                        -->
                        <Path x:Name="Mark" Data="{StaticResource IconCheck}"
                              Stroke="{DynamicResource OnDoneBrush}" StrokeThickness="2.2" Visibility="Collapsed"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="9" Height="9" />
                    </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DoneBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DoneBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ふつうのチェックボックス（設定と編集画面）。
        WPF の既定は面と枠を OS の色で描くので、暗い配色だと白い四角が浮き、
        文字も黒いまま残る。四角も文字もこちらで描く。
    -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3.5"
                                Margin="0,0,7,0" VerticalAlignment="Center"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderThickness="1.5" BorderBrush="{DynamicResource ControlBorderBrush}">
                            <Path x:Name="Mark" Data="{StaticResource IconCheck}"
                                  Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2.2"
                                  Visibility="Collapsed"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="9" Height="9" />
                        </Border>

                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 検索ボックス -->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Width" Value="190" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="5" Background="{DynamicResource BackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                            Padding="9,0">
                        <DockPanel>
                            <!-- アイコンの粒度を16px@1.7に揃える（項目11） -->
                            <Path DockPanel.Dock="Left" Data="{StaticResource IconSearch}"
                                  Stroke="{DynamicResource Ink3Brush}" StrokeThickness="1.7"
                                  Stretch="Uniform" Width="16" Height="16"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Grid>
                                <!-- 空のときだけ出す。既定は隠しておき、トリガで出す -->
                                <TextBlock x:Name="Placeholder" Text="予定とタスクを検索"
                                           Foreground="{DynamicResource Ink3Brush}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        クイック入力の欄。
        検索と同じ見た目にすると、上の検索欄と見分けがつかない。虫眼鏡は置かず、
        書き方の例をそのまま透かして出す。
    -->
    <Style x:Key="QuickInputBoxStyle" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="5" Background="{DynamicResource BackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                            Padding="9,0">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="例: 明日15時 打合せ @会議室A"
                                       FontSize="12"
                                       Foreground="{DynamicResource Ink3Brush}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ミニ月暦の1マス（.mg b）。
        10.5px / padding 2.5px 0 / radius 3。今日はアクセントで塗り、選択日は内枠で囲う
        （項目2が求める「今日＝塗り・選択＝枠」の形に、ここは元から合っている）。

        10.5px は5段階（項目5）のどれにも属さないモック由来の値
        （docs/README.md 5.6「ミニ月暦」表）。マスは `Margin 0.5` で隙間なく敷き詰めて
        7列ぴったりに収める作りで、11px に上げると行の高さが計算と食い違う恐れがある
        ため、ここは寄せずに据え置く
    -->
    <Style x:Key="MiniDayStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="3" Background="Transparent"
                            BorderThickness="0" BorderBrush="{DynamicResource AccentBrush}"
                            Padding="0,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                        </Trigger>

                        <!-- 押した手応え（項目8） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>

                        <!--
                            前後の月。Opacity で薄くすると Ink3 がさらに沈んで読めなく
                            なるため、Opacity は外し Ink3Brush だけで示す
                        -->
                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SaturdayBrush}" />
                        </DataTrigger>

                        <!-- 祝日は曜日に関わらず赤。土曜より後に置いてこちらを勝たせる -->
                        <DataTrigger Binding="{Binding IsSundayLike}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SundayBrush}" />
                        </DataTrigger>

                        <!-- 選択日は内枠。今日より先に置いて、今日の塗りに負けるようにする -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.5" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ミニ月暦の前月・次月（.mini-hd .ib）。押せる最小の 24x24（ツールバーの 28 より一回り小さい） -->
    <Style x:Key="SmallIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

    <!--
        カレンダー／タスクリストの1行（.ck）。
        チェックを外すと色見本が枠だけになり、文字が沈む。四角いチェックボックスを置くより、
        色見本そのものが状態を示すほうが行が短く済む。
    -->
    <Style x:Key="SourceListRowStyle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                    <!--
                        並べ替えの最中に、落とすとどこへ入るかを示す線。
                        面の上に重ねて出すので、行の高さは動かない。枠線で出すと
                        中身が 2px ずれて、掴むたびに行が揺れる
                    -->
                    <Border x:Name="DropAbove" Height="2" VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="Collapsed" Panel.ZIndex="1" />
                    <Border x:Name="DropBelow" Height="2" VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="Collapsed" Panel.ZIndex="1" />

                    <Border x:Name="RowBackground" Background="Transparent" Padding="0,3.5">
                        <DockPanel>
                            <Border x:Name="Swatch" DockPanel.Dock="Left"
                                    Width="14" Height="14" CornerRadius="4" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding SwatchColor, Converter={StaticResource DisplayHexBrush}}"
                                    BorderThickness="0" BorderBrush="{DynamicResource LineStrongBrush}" />

                            <!--
                                並べ替えの取っ手。ここを掴んだときだけ動かす。
                                行のどこでも掴めるようにすると、チェックを入り切りする
                                ふつうの押し下げと区別が付かない
                            -->
                            <Border x:Name="Grip" DockPanel.Dock="Right"
                                    Background="Transparent" Padding="4,0,0,0"
                                    Cursor="SizeNS" ToolTip="ドラッグで並べ替え">
                                <!-- 文字「⋮⋮」ではなく IconGrip（12@1.5）に揃える（項目6） -->
                                <Path Data="{StaticResource IconGrip}" Stretch="Uniform"
                                      Width="12" Height="12" VerticalAlignment="Center"
                                      Stroke="{DynamicResource LineStrongBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Border>

                            <!--
                                通知のベル。押すと、このカレンダーの予定を既定で
                                知らせるかどうかが切り替わる。予定ごとの指定があれば
                                そちらが勝つ。タスクリストには出さない
                            -->
                            <ToggleButton x:Name="Bell" DockPanel.Dock="Right"
                                          IsChecked="{Binding Notifies, Mode=TwoWay}"
                                          Cursor="Hand" Margin="4,0,0,0"
                                          Focusable="False"
                                          ToolTip="このカレンダーの予定を知らせるかどうか"
                                          Visibility="{Binding HasNotifyToggle,
                                                       Converter={StaticResource BoolToVisibility}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="2">
                                            <Path x:Name="Shape" Data="{StaticResource IconBellOff}"
                                                  Stretch="Uniform" Width="14" Height="14"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Stroke="{DynamicResource Ink3Brush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Shape" Property="Data"
                                                        Value="{StaticResource IconBell}" />
                                                <Setter TargetName="Shape" Property="Stroke"
                                                        Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shape" Property="Opacity" Value="0.7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!--
                                新しい予定の入れ先を示す印。右クリックから選び直せる。
                                どこに入るのかが一覧で分かる
                            -->
                            <Path x:Name="DefaultMark" DockPanel.Dock="Right"
                                  Data="{StaticResource IconStar}" Stretch="Uniform"
                                  Width="14" Height="14" Margin="4,0,0,0"
                                  VerticalAlignment="Center"
                                  Fill="{DynamicResource AccentBrush}"
                                  ToolTip="新しい予定はここに入ります"
                                  Visibility="Collapsed" />

                            <!--
                                「Google から外れた」カレンダー／タスクリストの印。一覧から消えたが、まだ
                                送っていない中身を残してある。説明はツールチップに出す
                            -->
                            <TextBlock x:Name="StatusMark" DockPanel.Dock="Right"
                                       Text="{Binding StatusMarkText}" Margin="4,0,0,0"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource Ink3Brush}"
                                       ToolTip="{Binding StatusNote}"
                                       Visibility="{Binding HasStatusNote,
                                                    Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock x:Name="Label" Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                  </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DropHint}" Value="Above">
                            <Setter TargetName="DropAbove" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DropHint}" Value="Below">
                            <Setter TargetName="DropBelow" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                            <Setter TargetName="DefaultMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Swatch" Property="Background" Value="Transparent" />
                            <Setter TargetName="Swatch" Property="BorderThickness" Value="1.5" />
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger SourceName="Grip" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        節の見出しのすぐ下・一覧の上に置く「＋ 予定を追加」「✓＋ タスクを追加」の行（項目1）。
        右パネル・スリムパネルの両方で使う。ボタンらしい枠は持たず、一覧の1行として
        自然に並ぶ見せ方にする。

        文字とアイコンは常にアクセント色（項目2）。押せる場所だと乗せなくても
        分かるようにする。地（PanelBrush）に対して 4.5:1 を割るテーマが無いことを
        確かめてある（Light 7.8:1・Dark 6.1:1・Night 5.0:1）。面（SunkenBrush）は
        従来どおりカーソルを乗せたときだけ付く
    -->
    <Style x:Key="SectionAddRowStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8と同じ流儀） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左パネル下の「実働日計算を開く」（.calcbtn）。幅いっぱい -->
    <Style x:Key="CalcButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!--
        編集画面の入力欄。ツールバーの .gbtn と同じ枠・角丸・高さに揃える。
        モックに編集画面は無いので、既存の部品の寸法に合わせて組み立てている。
    -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--
        入力欄の焦点は ComboBox・DatePicker と同じ見え方に揃える：枠を Accent にし（大きさは変えない）、
        キーボードで来たときは FocusRingStyle の輪も出す
    -->
    <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="5" Padding="9,0"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 複数行のメモ。高さだけ変えて、枠は入力欄と同じにする -->
    <Style x:Key="FieldNoteBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
        <Setter Property="Height" Value="64" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="5" Padding="9,5"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        読み取り専用の複数行の欄（取り込み結果の報告・同期の警告）。
        既定のテンプレートは面を OS の色で描くので、暗い配色では白い四角が浮く。面と枠は
        テーマの色に揃える。使う側が Background や BorderThickness を直に書けば、そちらが勝つ
        （報告の窓は外側の Border が枠を持つので、枠なし・透明にしている）。
        IsReadOnly は使う側が指す（ここでは決めない）
    -->
    <Style x:Key="ReadOnlyTextStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        日付を選ぶ暦（DatePicker を開いたときに出る Calendar）をテーマの色にする。
        既定は白い面と黒い文字を自前で持っていて、暗い配色にしても白いまま浮いていた。

        <b>テンプレートの PART 名と VisualState の名前は WPF 既定のままに保つ。</b>
          CalendarItem      … PART_Root・PART_PreviousButton・PART_HeaderButton・PART_NextButton・
                              PART_MonthView・PART_YearView・PART_DisabledVisual・DayTitleTemplate
          CalendarDayButton … CommonStates／SelectionStates／CalendarButtonFocusStates／ActiveStates／
                              DayStates／BlackoutDayStates
          CalendarButton    … CommonStates／SelectionStates／ActiveStates／CalendarButtonFocusStates
        状態の見た目は、面の Opacity だけを VisualState で動かす。色は DynamicResource で面に当てておく
        （Storyboard の値に DynamicResource は書けないため）。Calendar 自身のテンプレートは差し替えない。

        選択日は AccentSoft の面＋Accent の枠、今日は Accent の細い枠、マウスを載せた日は Sunken の面。
        文字の色を状態で替えられない（Storyboard に DynamicResource が書けない）ので、どの状態でも
        Ink の文字が読める面だけを使う。前後の月の日は Opacity 0.6 に落とす（暦の中の添え物なので）。
    -->
    <Style x:Key="FieldCalendarDayButtonStyle" TargetType="CalendarDayButton">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="1"
                                                         Storyboard.TargetName="HighlightBackground"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="1"
                                                         Storyboard.TargetName="HighlightBackground"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="0.4"
                                                         Storyboard.TargetName="NormalText"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="1"
                                                         Storyboard.TargetName="SelectedBackground"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CalendarButtonFocusStates">
                                <VisualState x:Name="CalendarButtonFocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0"
                                                                       Storyboard.TargetName="DayButtonFocusVisual"
                                                                       Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarButtonUnfocused" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ActiveStates">
                                <VisualState x:Name="Active" />
                                <VisualState x:Name="Inactive">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="0.6"
                                                         Storyboard.TargetName="NormalText"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DayStates">
                                <VisualState x:Name="RegularDay" />
                                <VisualState x:Name="Today">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="1"
                                                         Storyboard.TargetName="TodayBackground"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="BlackoutDayStates">
                                <VisualState x:Name="NormalDay" />
                                <VisualState x:Name="BlackoutDay">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="0.35"
                                                         Storyboard.TargetName="NormalText"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Rectangle x:Name="TodayBackground" Opacity="0" RadiusX="4" RadiusY="4"
                                   Fill="Transparent" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" />
                        <Rectangle x:Name="SelectedBackground" Opacity="0" RadiusX="4" RadiusY="4"
                                   Fill="{DynamicResource AccentSoftBrush}"
                                   Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Rectangle x:Name="HighlightBackground" Opacity="0" RadiusX="4" RadiusY="4"
                                   Fill="{DynamicResource SunkenBrush}" />
                        <ContentPresenter x:Name="NormalText"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="5,1,5,1" />
                        <Rectangle x:Name="DayButtonFocusVisual" Visibility="Collapsed" IsHitTestVisible="False"
                                   RadiusX="4" RadiusY="4"
                                   Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 月・年を選ぶ段（暦の見出しを押したときに出る 4x3 の表）のボタン -->
    <Style x:Key="FieldCalendarButtonStyle" TargetType="CalendarButton">
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="1"
                                                         Storyboard.TargetName="HighlightBackground"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="1"
                                                         Storyboard.TargetName="HighlightBackground"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="0.4"
                                                         Storyboard.TargetName="NormalText"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="1"
                                                         Storyboard.TargetName="SelectedBackground"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ActiveStates">
                                <VisualState x:Name="Active" />
                                <VisualState x:Name="Inactive">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="0.6"
                                                         Storyboard.TargetName="NormalText"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CalendarButtonFocusStates">
                                <VisualState x:Name="CalendarButtonFocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0"
                                                                       Storyboard.TargetName="CalendarButtonFocusVisual"
                                                                       Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarButtonUnfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Rectangle x:Name="SelectedBackground" Opacity="0" RadiusX="4" RadiusY="4"
                                   Fill="{DynamicResource AccentSoftBrush}"
                                   Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Rectangle x:Name="HighlightBackground" Opacity="0" RadiusX="4" RadiusY="4"
                                   Fill="{DynamicResource SunkenBrush}" />
                        <ContentPresenter x:Name="NormalText"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="1,0,1,1" />
                        <Rectangle x:Name="CalendarButtonFocusVisual" Visibility="Collapsed" IsHitTestVisible="False"
                                   RadiusX="4" RadiusY="4"
                                   Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 暦の本体（見出しの帯・前後の月のボタン・月の格子・年の格子） -->
    <Style x:Key="FieldCalendarItemStyle" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <!-- 曜日の見出し。CalendarItem が DayTitleTemplate の名前で探す -->
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource Ink3Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,4,0,6" Text="{Binding}" />
                        </DataTemplate>

                        <ControlTemplate x:Key="CalendarPreviousButtonTemplate" TargetType="Button">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="4">
                                <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform"
                                      Width="12" Height="12" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                        <ControlTemplate x:Key="CalendarNextButtonTemplate" TargetType="Button">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="4">
                                <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform"
                                      Width="12" Height="12" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                        <ControlTemplate x:Key="CalendarHeaderButtonTemplate" TargetType="Button">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="8,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ControlTemplate.Resources>

                    <Grid x:Name="PART_Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="1"
                                                         Storyboard.TargetName="PART_DisabledVisual"
                                                         Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid Margin="8,6,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button x:Name="PART_PreviousButton" Grid.Column="0" Grid.Row="0"
                                        Focusable="False" HorizontalAlignment="Left" Height="24" Width="28"
                                        Foreground="{DynamicResource Ink2Brush}"
                                        Template="{StaticResource CalendarPreviousButtonTemplate}" />
                                <Button x:Name="PART_HeaderButton" Grid.Column="1" Grid.Row="0"
                                        Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        FontWeight="SemiBold" FontSize="13"
                                        Foreground="{DynamicResource InkBrush}"
                                        Template="{StaticResource CalendarHeaderButtonTemplate}" />
                                <Button x:Name="PART_NextButton" Grid.Column="2" Grid.Row="0"
                                        Focusable="False" HorizontalAlignment="Right" Height="24" Width="28"
                                        Foreground="{DynamicResource Ink2Brush}"
                                        Template="{StaticResource CalendarNextButtonTemplate}" />

                                <Grid x:Name="PART_MonthView" Grid.ColumnSpan="3" Grid.Row="1"
                                      Margin="0,2,0,0" HorizontalAlignment="Center" Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                </Grid>

                                <Grid x:Name="PART_YearView" Grid.ColumnSpan="3" Grid.Row="1"
                                      Margin="0,2,0,0" HorizontalAlignment="Center" Visibility="Hidden">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                </Grid>
                            </Grid>
                        </Border>

                        <Rectangle x:Name="PART_DisabledVisual" Opacity="0" Visibility="Collapsed"
                                   IsHitTestVisible="False" RadiusX="8" RadiusY="8"
                                   Fill="{DynamicResource PanelBrush}" Stretch="Fill" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 見出しを押して月・年の表に切り替えたとき -->
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}"
                                     Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}"
                                     Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        暦。テンプレートは既定のまま（StackPanel の PART_Root に CalendarItem を1つ置くだけ）にして、
        面・枠・文字と、下の3つのスタイルを差し替える。FieldDatePickerStyle の CalendarStyle に付ける
    -->
    <Style x:Key="FieldCalendarStyle" TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource FieldCalendarItemStyle}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource FieldCalendarDayButtonStyle}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource FieldCalendarButtonStyle}" />
    </Style>

    <!--
        日付欄。既定の DatePicker は枠も高さも周りと揃わないので、外側だけ差し替える。
        ポップアップの暦は FieldCalendarStyle（上）でテーマの色にする。
    -->
    <!--
        日付欄の中の入力部分。
        DatePicker の中身は DatePickerTextBox という別のコントロールで、既定の
        テンプレートが白い面と黒い文字を自前で持っている。外側の色を変えても
        ここが残るので、テンプレートごと差し替える。
    -->
    <Style x:Key="FieldDatePickerTextBoxStyle" TargetType="primitives:DatePickerTextBox">
        <!--
            年・月・日を区切りで扱う。押したところがまるごと選ばれるので、そのまま
            打てば置き換わる。上下キーで増減、左右キーで隣の区切りへ
        -->
        <Setter Property="views:DateSegments.Enabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:DatePickerTextBox">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 無効時。FieldTextBoxStyle と同じく文字を補助色へ落とす（面は外側の FieldDatePickerStyle が持つ） -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldDatePickerStyle" TargetType="DatePicker">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CalendarStyle" Value="{StaticResource FieldCalendarStyle}" />

        <!-- 中の入力部分にも当てる。型で指すので、この欄の中だけに効く -->
        <Style.Resources>
            <Style TargetType="primitives:DatePickerTextBox"
                   BasedOn="{StaticResource FieldDatePickerTextBoxStyle}" />
        </Style.Resources>

        <!--
            無効時。FieldTextBoxStyle の無効表示に揃える（背景を沈め、枠と文字を補助色にし、
            カーソルを既定へ戻す）。通知・期限の付随欄が「押せるのに開かない」ように見える問題への対応
        -->
        <Style.Triggers>
            <!--
                キーボードで来たときも枠が変わるようにする。FieldTextBoxStyle は
                IsFocused、TimeComboBoxStyle は IsKeyboardFocusWithin で枠を変えており、
                DatePicker はテキスト欄と開閉ボタンの2つを内に持つのでそれに倣う
            -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 一覧に出す行 -->
    <Style x:Key="FieldComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 開閉ボタンの山形。既定のものは周りと太さが揃わない -->
    <Style x:Key="ComboToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path Data="M6 9l6 6 6-6" Stretch="Uniform" Width="11" Height="11"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource Ink3Brush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        選ぶだけの欄（カレンダー・タスクリスト・繰り返し）。
        既定のテンプレートは枠も高さも周りと揃わないので差し替える。
    -->
    <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="5"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" />

                        <ToggleButton HorizontalAlignment="Stretch" Width="Auto" Background="Transparent"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <DockPanel Margin="9,0,4,0" IsHitTestVisible="False">
                            <Path DockPanel.Dock="Right" Data="M6 9l6 6 6-6" Stretch="Uniform"
                                  Width="11" Height="11" Margin="4,0,0,0"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource Ink3Brush}" VerticalAlignment="Center" />
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" />
                        </DockPanel>

                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" Margin="6,2,6,6">
                                <Border CornerRadius="8" Background="{DynamicResource PanelBrush}"
                                Effect="{StaticResource PopupShadowEffect}" />
                                <Border MaxHeight="240"
                                        CornerRadius="8" Background="{DynamicResource PanelBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!--
                            キーボードで来たときも枠が変わるようにする。FieldTextBoxStyle は
                            IsFocused、TimeComboBoxStyle は IsKeyboardFocusWithin で枠を
                            変えており、こちらはトグルボタン越しに開くのでそれに倣う
                        -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!--
                            無効時。FieldTextBoxStyle の無効表示に揃える。
                            期限を付けない・通知OFFのときの選択欄が押せるように見えてしまう問題への対応
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        打っても選んでもよい欄（時刻）。
        打ち込みは「9」「930」「9:30」のどれでも読むので、候補は目安として出すだけ。
    -->
    <Style x:Key="TimeComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="IsEditable" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Root" Grid.ColumnSpan="2" CornerRadius="5"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" />

                        <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                 Margin="9,0,0,0" Padding="0"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource InkBrush}"
                                 CaretBrush="{DynamicResource InkBrush}"
                                 Typography.NumeralAlignment="Tabular" />

                        <ToggleButton Grid.Column="1" Style="{StaticResource ComboToggleStyle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />

                        <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" Margin="6,2,6,6">
                                <Border CornerRadius="8" Background="{DynamicResource PanelBrush}"
                                Effect="{StaticResource PopupShadowEffect}" />
                                <Border MaxHeight="240"
                                        CornerRadius="8" Background="{DynamicResource PanelBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 期限の早入れ（今日・明日・来週）。小さめの枠線ボタン -->
    <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <!-- 小さい枠線ボタンなので、Ghost の MinWidth 80 は打ち消す -->
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- 保存ボタン。押すべき先がひとつだと分かるようアクセントで塗る -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="5" Background="{DynamicResource AccentBrush}"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <!-- 押した手応え（項目8） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <!--
                            無効時。面を沈め、文字を補助色にして枠を引く。以前は LineStrong の面に
                            OnAccent の文字で、Light では白文字が灰色の面に溶けて読めなかった
                            （Ink3 は Sunken 上でも 4.5:1 以上）
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 行に重ねる削除ボタン。並んでいるときは出さず、指した行にだけ出す -->
    <Style x:Key="RowDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <!-- 押せる範囲 24x24 のうち、はみ出す余白ぶんを引いて、行の高さを変えない（行の上下の余白 6 の中に収まる） -->
        <Setter Property="Margin" Value="0,-3" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTip" Value="削除" />
    </Style>

    <!--
        右上の同期表示。押すと同期する。
        ボタンらしく見せすぎると、ツールバーの中で目立ちすぎる。枠は乗せたときだけ出す。
    -->
    <Style x:Key="SyncStatusButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="5" Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- 繋いでいないときは押せない。押せないことを薄さで示す -->
                            <Setter Property="Opacity" Value="0.75" />
                            <Setter TargetName="Root" Property="Background" Value="Transparent" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ペインの境目（.splitter）。
        つまんで幅を変えられることが分かるよう、線の上に乗せて左右の矢印を出す。
        当たりは 6px。見えている線は 1px のままで、残りは透明な余白
    -->
    <Style x:Key="PaneSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Width" Value="6" />
        <!-- 向きは既定だと見た目から推し量られる。左右に動くことを明示しておく -->
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Rectangle x:Name="Line" Width="1" Fill="{DynamicResource LineBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Width" Value="2" />
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Width" Value="2" />
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        右クリックメニューとツールチップ。
        暗黙スタイル（x:Key 無し）にする。ScrollBar・CheckBox（ふつうのチェックボックス）と
        同じ書き方で、アプリ全体の ContextMenu / MenuItem / Separator / ToolTip に効く。
        月ビューのチップ・左パネルの行・⚙ボタン・▥ボタンのメニューは自前で ContextMenu を
        組んでおり、ここに書かなければ Windows 既定の明色（白地）のまま出てしまう。

        ポップアップ（ComboBox・DatePicker系）と枠・背景の書きぶりを揃えている
        （BorderThickness 1 / LineStrongBrush / PanelBrush）。角丸はポップアップは 8、
        コントロール（ボタン・入力欄）は 5 のまま（項目7）。

        影は Windows 11 のフライアウトに揃えて柔らかく落とす。文字を載せる Border に
        直接 Effect を掛けると文字が滲む（docs/README.md）ため、後ろに影だけを持つ
        Border、前に中身を載せる Effect 無しの Border を Grid で重ねてある。
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!--
                        ContextMenu 自身の開閉・位置決めはフレームワークが Popup を
                        使ってやってくれる。ここに書くのは中身（枠と背景と影）だけでよい
                    -->
                    <Grid Margin="6">
                        <Border CornerRadius="8" Background="{DynamicResource PanelBrush}"
                                Effect="{StaticResource PopupShadowEffect}" />
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- メニューの区切り線 -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource LineBrush}" />
        <Setter Property="Margin" Value="4,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        メニューの1行。
        ContextMenu からしか使わないので、Menu バーに出るときだけの見た目
        （TopLevelHeader のアイコン無し表示など）は考えない。IsCheckable の
        チェック印・サブメニュー（「詳細」のような入れ子）・無効表示の3つは扱う。

        サブメニューの開閉先は既定の名前どおり x:Name="PART_Popup" にしておく。
        MenuItem 自身がコードでこの名前を探して開閉・位置合わせに使うため、
        名前を変えると入れ子のメニューが正しく振る舞わない
    -->
    <Style TargetType="MenuItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="4,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>

                            <!-- チェック印。IsCheckable のときだけ出す -->
                            <Path x:Name="Check" Grid.Column="0" Data="{StaticResource IconCheck}"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                               RecognizesAccessKey="True"
                                               VerticalAlignment="Center" Margin="6,4,10,4" />

                            <!-- ショートカットキーの文字（Ctrl+Z など）。今のところ使っていないが受け皿は置く -->
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource Ink3Brush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />

                            <!-- サブメニューがあることを示す山形。「詳細」のような入れ子だけに出す -->
                            <Path x:Name="Arrow" Grid.Column="3" Data="{StaticResource IconChevronRight}"
                                  Width="9" Height="9" Stretch="Uniform"
                                  Stroke="{DynamicResource Ink3Brush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <Popup x:Name="PART_Popup" Placement="Right" Focusable="False"
                                   AllowsTransparency="True"
                                   HorizontalOffset="2" VerticalOffset="-6"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Grid Margin="6">
                                    <Border CornerRadius="8" Background="{DynamicResource PanelBrush}"
                                Effect="{StaticResource PopupShadowEffect}" />
                                    <Border CornerRadius="8" Padding="4"
                                            Background="{DynamicResource PanelBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                                        <StackPanel IsItemsHost="True" />
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- IsCheckable の後に置き、チェックが外れているときはこちらを勝たせる -->
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- 子を持つ行（TopLevelHeader・SubmenuHeader どちらも HasItems は True） -->
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        予定・タスクの右クリックメニューに足す「リンクを開く」「添付を開く」。

        開ける先があるときだけ出す。出し分けのために、項目自身の DataContext に「開ける先」
        （OpenTargets）を置く。右クリックされた行の DataContext から OpenTargetsConverter が読む。
        行の型は画面ごとに違う（月のチップ・右ペインの行・時間軸のブロックなど）が、振り分けは
        OpenTargets.From が持つので、メニュー側は同じ書き方で済む。

        使う側は <MenuItem Style="{StaticResource EventLinkMenuItemStyle}" /> と
        <MenuItem Style="{StaticResource OpenAttachmentMenuItemStyle}" /> と書くだけ。
        Command は、他の項目と同じく Tag に入れた MainViewModel を PlacementTarget 経由で引く。
        ただし「添付を開く」の子メニューは別のポップアップに出て ContextMenu をたどれないので、
        項目ごとの Command と CommandParameter は AttachmentMenuItemsConverter が項目に持たせる。

        暗黙スタイル（上の MenuItem / Separator）を BasedOn で引き継ぐ。Style を明示すると暗黙の
        スタイルは当たらなくなり、枠や色が Windows 既定に戻ってしまう。
    -->
    <conv:OpenTargetsConverter x:Key="OpenTargetsConverter" />
    <conv:AttachmentMenuItemsConverter x:Key="AttachmentMenuItemsConverter" />

    <Style x:Key="OpenLinkMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Header" Value="リンクを開く" />
        <Setter Property="DataContext"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu},
                        Converter={StaticResource OpenTargetsConverter}}" />
        <Setter Property="Visibility"
                Value="{Binding HasLink, Converter={StaticResource BoolToVisibility}}" />
        <!-- 渡すのは URL そのもの。コマンド側でも http/https かを確かめ直す -->
        <Setter Property="CommandParameter" Value="{Binding LinkUrl}" />
    </Style>

    <Style x:Key="EventLinkMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource OpenLinkMenuItemStyle}">
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.OpenEventLinkCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <Style x:Key="TaskLinkMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource OpenLinkMenuItemStyle}">
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.OpenTaskLinkCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <!--
        添付は1件でも子メニューに並べる（件数で形を変えると、押す場所が変わって迷う）。
        予定もタスクも同じスタイルで、子の項目が起こすコマンドだけがそれぞれ違う
    -->
    <Style x:Key="OpenAttachmentMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Header" Value="添付を開く" />
        <Setter Property="DataContext"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu},
                        Converter={StaticResource OpenTargetsConverter}}" />
        <Setter Property="Visibility"
                Value="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" />
        <Setter Property="ItemsSource">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource AttachmentMenuItemsConverter}">
                    <Binding Path="PlacementTarget.Tag"
                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                    <Binding />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding Label}" />
                    <Setter Property="Command" Value="{Binding Command}" />
                    <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        右クリックメニュー（予定・タスク・日付と空き時間）。画面ごとに別々に持たず、ここの4つを全部の画面で
        共有する（EventContextMenu・TaskContextMenu・TaskRowContextMenu・DayContextMenu）。以前は画面ごとに
        同じ並びのメニューを書いていて、1つ足すたびに足し忘れる画面が出た
        （tests/Kado.App.Tests/ContextMenuOpenItemsTests が、並びと使われ方を見張っている）。

        ContextMenu は画面の木から外れて出るので、祖先をたどっても Window に届かない。使う側は、
        メニューを付ける要素の Tag に MainViewModel（Window の DataContext）を入れ、項目は
        PlacementTarget 経由でそれを引く。コマンドの引数は右クリックされた行（PlacementTarget.DataContext）
        そのもの。行の型は画面ごとに違う（月のチップ・時間軸のブロック・右ペインの行・一覧の行など）が、
        どの行かの読み取りは MainViewModel（EntryRefs）が持つので、メニュー側は全部同じ書き方で済む。

        項目の出し分け（編集か詳細か・押せるか・押せない理由・子メニューの中身）は、項目自身の DataContext に
        MainViewModel が組み立てた情報（EventMenuInfo・TaskMenuInfo・DayMenuInfo）を置いて読む。
        リンク・添付の項目（OpenTargets）と同じ作り。押せない項目は隠さず灰色にして、理由をツールチップに出す
        （灰色の項目にツールチップを出すには ToolTipService.ShowOnDisabled が要る）。

        子メニュー（別のカレンダーへ移す・期限を変える・別のリストへ移す）の項目は別のポップアップに出て
        ContextMenu をたどれないので、押したときのコマンドと渡すものは項目自身（MenuChoice）が持つ。

        ここは MenuItem / Separator の暗黙スタイルより後ろに置く。StaticResource は前方参照できず、
        暗黙スタイルを BasedOn で引き継ぐ（Style を明示すると暗黙のスタイルは当たらなくなり、枠や色が
        Windows 既定に戻る）ため。
    -->
    <conv:EventMenuInfoConverter x:Key="EventMenuInfoConverter" />
    <conv:TaskMenuInfoConverter x:Key="TaskMenuInfoConverter" />
    <conv:DayMenuInfoConverter x:Key="DayMenuInfoConverter" />

    <!-- 子メニューの1件。名前の前に色見本（カレンダー・リストの色）を出す。色が無ければ名前だけ -->
    <DataTemplate x:Key="MenuChoiceTemplate">
        <StackPanel Orientation="Horizontal">
            <Border Width="14" Height="14" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center"
                    Background="{Binding Color, Converter={StaticResource DisplayHexBrush}}"
                    Visibility="{Binding HasColor, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="MenuChoiceItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="HeaderTemplate" Value="{StaticResource MenuChoiceTemplate}" />
        <Setter Property="Command" Value="{Binding Command}" />
        <Setter Property="CommandParameter" Value="{Binding Parameter}" />
        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <!-- 予定のメニューの項目の土台。DataContext に EventMenuInfo を置く -->
    <Style x:Key="EventMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="DataContext">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource EventMenuInfoConverter}">
                    <Binding Path="PlacementTarget.Tag"
                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                    <Binding Path="PlacementTarget.DataContext"
                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <!-- 「編集」。編集できない予定（読み取り専用のカレンダー・Google 側で変えられないもの）では「詳細を見る」 -->
    <Style x:Key="EventEditMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource EventMenuItemStyle}">
        <Setter Property="Header" Value="{Binding EditLabel}" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.EditEventEntryCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <Style x:Key="EventDuplicateMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource EventMenuItemStyle}">
        <Setter Property="Header" Value="複製" />
        <Setter Property="IsEnabled" Value="{Binding CanDuplicate}" />
        <Setter Property="ToolTip" Value="{Binding DuplicateDisabledReason}" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.DuplicateEventCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <!-- 子メニューに、書き込めるカレンダーを左パネルと同じ並びで出す。移せない予定は親ごと灰色（理由はツールチップ） -->
    <Style x:Key="EventMoveMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource EventMenuItemStyle}">
        <Setter Property="Header" Value="別のカレンダーへ移す" />
        <Setter Property="IsEnabled" Value="{Binding CanMove}" />
        <Setter Property="ToolTip" Value="{Binding MoveDisabledReason}" />
        <Setter Property="ItemsSource" Value="{Binding MoveChoices}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource MenuChoiceItemStyle}" />
    </Style>

    <Style x:Key="EventCopyMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource EventMenuItemStyle}">
        <Setter Property="Header" Value="題名と日時をコピー" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.CopyEventTextCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <Style x:Key="EventDeleteMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource EventMenuItemStyle}">
        <Setter Property="Header" Value="削除" />
        <Setter Property="IsEnabled" Value="{Binding CanDelete}" />
        <Setter Property="ToolTip" Value="{Binding DeleteDisabledReason}" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.DeleteEventEntryCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <!-- タスクのメニューの項目の土台。DataContext に TaskMenuInfo を置く -->
    <Style x:Key="TaskMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="DataContext">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource TaskMenuInfoConverter}">
                    <Binding Path="PlacementTarget.Tag"
                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                    <Binding Path="PlacementTarget.DataContext"
                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="TaskEditMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource TaskMenuItemStyle}">
        <Setter Property="Header" Value="編集…" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.EditTaskEntryCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <!-- 文言は完了・未完了で切り替える（TaskMenuInfo.DoneLabel） -->
    <Style x:Key="TaskDoneMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource TaskMenuItemStyle}">
        <Setter Property="Header" Value="{Binding DoneLabel}" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.ToggleTaskEntryDoneCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <!-- 今日・明日・次の実働日・来週の週始め・期限なし。いまの期限と同じ項目は灰色 -->
    <Style x:Key="TaskDueMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource TaskMenuItemStyle}">
        <Setter Property="Header" Value="期限を変える" />
        <Setter Property="ItemsSource" Value="{Binding DueChoices}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource MenuChoiceItemStyle}" />
    </Style>

    <!-- サブタスク・サブタスクを持つタスクは、Google がリストをまたいで移させない。項目ごとに灰色にして理由を出す -->
    <Style x:Key="TaskListMoveMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource TaskMenuItemStyle}">
        <Setter Property="Header" Value="別のリストへ移す" />
        <Setter Property="IsEnabled" Value="{Binding CanMoveToList}" />
        <Setter Property="ToolTip" Value="{Binding ListMoveDisabledReason}" />
        <Setter Property="ItemsSource" Value="{Binding ListChoices}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource MenuChoiceItemStyle}" />
    </Style>

    <Style x:Key="TaskDuplicateMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource TaskMenuItemStyle}">
        <Setter Property="Header" Value="複製" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.DuplicateTaskCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <Style x:Key="TaskCopyMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource TaskMenuItemStyle}">
        <Setter Property="Header" Value="題名をコピー" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.CopyTaskTitleCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <Style x:Key="TaskDeleteMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource TaskMenuItemStyle}">
        <Setter Property="Header" Value="削除" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.DeleteTaskEntryCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <!--
        右ペインの行だけが持つ「上へ移動」「下へ移動」。同じ期限日の中で入れ替える。
        グループの端では無効になる（MainViewModel.CanMoveTaskInGroup。コマンドの CanExecute）。
        引数は TaskListItemViewModel（右ペインの行の DataContext）
    -->
    <Style x:Key="TaskMoveUpMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Header" Value="上へ" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.MoveTaskUpCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <Style x:Key="TaskMoveDownMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Header" Value="下へ" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.MoveTaskDownCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter"
                Value="{Binding PlacementTarget.DataContext,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </Style>

    <!--
        日付・空き時間のメニューの項目の土台。DataContext に DayMenuInfo を置く。
        値は、本体・右クリックされた場所の中身・時間軸の上の時刻（DayMenu.Time。時間軸の列だけが付ける）・
        いま出しているビュー。最後のビューは出し分けを作り直させる目印で、右ペインのように、ビューが
        変わっても残る場所で「今いるビューと同じものは出さない」を保つのに要る
    -->
    <Style x:Key="DayMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="DataContext">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource DayMenuInfoConverter}">
                    <Binding Path="PlacementTarget.Tag"
                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                    <Binding Path="PlacementTarget.DataContext"
                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                    <Binding Path="PlacementTarget.(views:DayMenu.Time)"
                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                    <Binding Path="PlacementTarget.Tag.CurrentView"
                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 時間帯の上なら、その時刻（15分に丸めた）から1時間の予定。それ以外はふつうの「予定を追加」 -->
    <Style x:Key="DayAddEventMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource DayMenuItemStyle}">
        <Setter Property="Header" Value="予定を追加…" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.AddEventAtCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter" Value="{Binding Target}" />
    </Style>

    <Style x:Key="DayAddTaskMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource DayMenuItemStyle}">
        <Setter Property="Header" Value="タスクを追加…" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.AddTaskOnCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter" Value="{Binding Date}" />
    </Style>

    <!-- 今いるビューと同じものは出さない（DayMenuInfo.ShowsDay・ShowsWeek・ShowsMonth） -->
    <Style x:Key="DayShowDayMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource DayMenuItemStyle}">
        <Setter Property="Header" Value="1日で見る" />
        <Setter Property="Visibility"
                Value="{Binding ShowsDay, Converter={StaticResource BoolToVisibility}}" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.ShowDayOfCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter" Value="{Binding Date}" />
    </Style>

    <Style x:Key="DayShowWeekMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource DayMenuItemStyle}">
        <Setter Property="Header" Value="週で見る" />
        <Setter Property="Visibility"
                Value="{Binding ShowsWeek, Converter={StaticResource BoolToVisibility}}" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.ShowWeekOfCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter" Value="{Binding Date}" />
    </Style>

    <Style x:Key="DayShowMonthMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource DayMenuItemStyle}">
        <Setter Property="Header" Value="月で見る" />
        <Setter Property="Visibility"
                Value="{Binding ShowsMonth, Converter={StaticResource BoolToVisibility}}" />
        <Setter Property="Command"
                Value="{Binding PlacementTarget.Tag.ShowMonthOfCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Setter Property="CommandParameter" Value="{Binding Date}" />
    </Style>

    <!--
        予定の右クリックメニュー。月のチップ・週と日の終日レーン・時間軸のブロック・一覧・右ペイン・
        日付の行のラベル（マイルストーン）の全部で使う。並びを変えるときは、ここだけを直す。

        編集…（編集できなければ「詳細を見る…」）/ リンクを開く / 添付を開く ▸ / ― / 別のカレンダーへ移す ▸ / 複製 /
        題名と日時をコピー / ― / 削除
        （リンク・添付は、あるときだけ。窓やファイル選択が開く項目には「…」を付ける）
    -->
    <ContextMenu x:Key="EventContextMenu">
        <MenuItem Style="{StaticResource EventEditMenuItemStyle}" />
        <MenuItem Style="{StaticResource EventLinkMenuItemStyle}" />
        <MenuItem Style="{StaticResource OpenAttachmentMenuItemStyle}" />
        <Separator />
        <MenuItem Style="{StaticResource EventMoveMenuItemStyle}" />
        <MenuItem Style="{StaticResource EventDuplicateMenuItemStyle}" />
        <MenuItem Style="{StaticResource EventCopyMenuItemStyle}" />
        <Separator />
        <MenuItem Style="{StaticResource EventDeleteMenuItemStyle}" />
    </ContextMenu>

    <!--
        タスクの右クリックメニュー。月のチップ・週と日の終日レーン・一覧で使う（右ペインの行は、
        すぐ下の TaskRowContextMenu）。並びを変えるときは、この2つを一緒に直す
        （tests/Kado.App.Tests/ContextMenuOpenItemsTests が、右ペインのものが「これに上へ・下へを足しただけ」
        であることを見張っている）。

        完了にする・完了を取り消す / 編集… / リンクを開く / 添付を開く ▸ / ― / 期限を変える ▸ / 別のリストへ移す ▸ /
        複製 / 題名をコピー / ― / 削除（リンク・添付は、あるときだけ）
    -->
    <ContextMenu x:Key="TaskContextMenu">
        <MenuItem Style="{StaticResource TaskDoneMenuItemStyle}" />
        <MenuItem Style="{StaticResource TaskEditMenuItemStyle}" />
        <MenuItem Style="{StaticResource TaskLinkMenuItemStyle}" />
        <MenuItem Style="{StaticResource OpenAttachmentMenuItemStyle}" />
        <Separator />
        <MenuItem Style="{StaticResource TaskDueMenuItemStyle}" />
        <MenuItem Style="{StaticResource TaskListMoveMenuItemStyle}" />
        <MenuItem Style="{StaticResource TaskDuplicateMenuItemStyle}" />
        <MenuItem Style="{StaticResource TaskCopyMenuItemStyle}" />
        <Separator />
        <MenuItem Style="{StaticResource TaskDeleteMenuItemStyle}" />
    </ContextMenu>

    <!--
        右ペインのタスクの行のメニュー。TaskContextMenu と同じ並びで、削除の上に、並べ替えの
        「上へ」「下へ」を区切り線で分けて足す（ドラッグが実機でうまく動かなかったときの逃げ道）。
    -->
    <ContextMenu x:Key="TaskRowContextMenu">
        <MenuItem Style="{StaticResource TaskDoneMenuItemStyle}" />
        <MenuItem Style="{StaticResource TaskEditMenuItemStyle}" />
        <MenuItem Style="{StaticResource TaskLinkMenuItemStyle}" />
        <MenuItem Style="{StaticResource OpenAttachmentMenuItemStyle}" />
        <Separator />
        <MenuItem Style="{StaticResource TaskDueMenuItemStyle}" />
        <MenuItem Style="{StaticResource TaskListMoveMenuItemStyle}" />
        <MenuItem Style="{StaticResource TaskDuplicateMenuItemStyle}" />
        <MenuItem Style="{StaticResource TaskCopyMenuItemStyle}" />
        <Separator />
        <MenuItem Style="{StaticResource TaskMoveUpMenuItemStyle}" />
        <MenuItem Style="{StaticResource TaskMoveDownMenuItemStyle}" />
        <Separator />
        <MenuItem Style="{StaticResource TaskDeleteMenuItemStyle}" />
    </ContextMenu>

    <!--
        日付・空き時間の右クリックメニュー。月のマスの空いた所・週の日見出し・週と日の時間帯の空いた所・
        年の日付・一覧の日付見出し・右ペインの空いた所で使う。予定やタスクの上で右クリックしたときは、
        その予定・タスクのメニューだけが出る（WPF は、ContextMenu を持ついちばん内側の要素のメニューを
        開いて、そこで止める。外側のこのメニューは出ない）。

        予定を追加… / タスクを追加… / ― / 1日で見る / 週で見る / 月で見る
        （今いるビューと同じものは出さない）
    -->
    <ContextMenu x:Key="DayContextMenu">
        <MenuItem Style="{StaticResource DayAddEventMenuItemStyle}" />
        <MenuItem Style="{StaticResource DayAddTaskMenuItemStyle}" />
        <Separator />
        <MenuItem Style="{StaticResource DayShowDayMenuItemStyle}" />
        <MenuItem Style="{StaticResource DayShowWeekMenuItemStyle}" />
        <MenuItem Style="{StaticResource DayShowMonthMenuItemStyle}" />
    </ContextMenu>

    <!--
        ツールチップ。
        ポップアップ系（ComboBox・DatePicker）と同じ角丸・枠・背景に揃える。
        既定テンプレートに PART_ 付きの必須要素は無いので、ここは安全に差し替えられる
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,5" />
        <!--
            HasDropShadow は Windows のクラシックな落ち方（右下にずれた濃い影）で
            他のポップアップと揃わないため使わない。ContextMenu・ComboBox 系と同じ
            柔らかい影を DropShadowEffect で自前に描く（項目7）
        -->
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Margin="6">
                        <Border CornerRadius="8" Background="{DynamicResource PanelBrush}"
                                Effect="{StaticResource PopupShadowEffect}" />
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
