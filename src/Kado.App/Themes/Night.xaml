<!--
    夜間テーマの色。キーは Light.xaml・Dark.xaml と一対一で揃える。

    ダークより明るいグレーに寄せ、文字とのコントラストを落としてある。
    真っ暗な画面を長く見ていると目が疲れる、という声に応えるための配色で、
    旧 inaCalendar の night をそのまま持ってきた。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#363B40</Color>
    <Color x:Key="PanelColor">#3E4348</Color>
    <!--
        一段沈めた面（前後の月）。以前は OffDayColor と同じ値で、休業日と見分けが
        付かなかった。休業日よりわずかに明るく留め、2つが別物だと分かるようにする
    -->
    <Color x:Key="SunkenColor">#2B2E31</Color>

    <Color x:Key="LineColor">#4A4F54</Color>
    <Color x:Key="LineStrongColor">#555555</Color>
    <!-- 入力欄・チェックボックスの枠。Panel（#3E4348）上 3:1 以上 -->
    <Color x:Key="ControlBorderColor">#8D8D8D</Color>

    <!--
        文字（主／副／補助）。
        3:1 は 18.66px 太字以上の大きい文字の基準で、Ink3 が付いているのは
        CaptionTextStyle・MicroTextStyle なので 4.5:1 が要る。
        旧 #A0A9B4 は Panel 上 4.20:1 で足りなかったため、#A7AFBA（Panel 上 4.51:1）へ上げた。

        見出し・本文・補助の3段が文字サイズでしか区別できない問題があったため、
        InkColor と Ink2Color を明度差がはっきり付くところまで引き上げた。
        InkColor は Panel 上 7.67:1（#DDE2E8）、Ink2Color は 5.49:1（#B9C1CA）。
        Ink3（4.20:1）との段差も 1.10/1.16 倍から 1.83/1.31 倍まで広がる
    -->
    <Color x:Key="InkColor">#DDE2E8</Color>
    <Color x:Key="Ink2Color">#B9C1CA</Color>
    <Color x:Key="Ink3Color">#A7AFBA</Color>

    <Color x:Key="AccentColor">#6DC1E7</Color>
    <!--
        以前は Panel（#3E4348）とほぼ同色（明度差1.3）で、実働日バッジなどの面が
        背景に溶けていた。Panel よりはっきり明るく、アクセントに寄せた色に上げる。
        さらに InkColor を引き上げたことで Ink 上 7.12:1、AccentColor 上 4.61:1 まで
        取れる値（#2E4A60）に調整
    -->
    <Color x:Key="AccentSoftColor">#2E4A60</Color>

    <!--
        アクセントの面に重ねる文字色。
        Night のアクセント #6DC1E7 も明るい水色で、白文字は約2.0:1 しか出ない。
        Dark と同じ濃紺 #0F1720 なら約9.0:1 まで上がる
    -->
    <Color x:Key="OnAccentColor">#0F1720</Color>

    <!--
        DoneColor（完了したタスクの面）に重ねるチェック印の色。
        DoneColor が中間トーンのグレーなので、白よりも濃色のほうが立つ
        （#0F1720 で約4.7:1、白だと約3.8:1）
    -->
    <Color x:Key="OnDoneColor">#0F1720</Color>

    <!-- 赤・青の文字。旧 #F0968B／#7FB3D5 は Panel 上 4.5:1 を割っていたため、#F0978C／#82B5D6 で 4.5:1 以上にする -->
    <Color x:Key="SundayColor">#F0978C</Color>
    <Color x:Key="SaturdayColor">#82B5D6</Color>

    <!-- 稼働日は塗らない（Panel と同値） -->
    <Color x:Key="WorkingDayColor">#3E4348</Color>
    <!--
        休業日。以前は SunkenColor とほぼ同じ値で、前後の月のマスと見分けが付かなかった。
        SunkenColor よりはっきり暗くし、Panel 比 1.67:1・Sunken 比 1.22:1 まで離す
    -->
    <Color x:Key="OffDayColor">#1C1E20</Color>

    <!--
        マスを押したときと、マウスを載せたときの面。
        以前は CellHover が Panel とほぼ同色（明度差2.1）で乗せても分からなかった。

        選択は「内側に引く2pxのアクセント枠」で示すので、面はもう強く塗らない。
        ホバーの面は、旧 #48545F だと Ink3 などの補助文字が 3.3:1 前後まで沈んだ
        （日曜色 3.48:1・NowLine 2.67:1）。Panel より少し暗い #333B43 にすると、
        日曜色・土曜色・Ink3 のいずれも 5:1 以上を保てる（Panel 比は 1.2:1 前後で、
        ホバーとわかる程度の差は残る）
    -->
    <Color x:Key="CellHoverColor">#333B43</Color>
    <Color x:Key="CellSelectedColor">#274257</Color>

    <Color x:Key="CategoryGreenColor">#8FDAD2</Color>
    <Color x:Key="CategoryAmberColor">#DAA54F</Color>

    <!-- 完了したタスクの文字色。取り消し線が「済み」を担うため、Ink3 と同値でよい -->
    <Color x:Key="DoneColor">#A7AFBA</Color>

    <Color x:Key="MilestoneSpecFaceColor">#4A4530</Color>
    <Color x:Key="MilestoneSpecTextColor">#E5CE8E</Color>
    <Color x:Key="MilestoneGoFaceColor">#463732</Color>
    <Color x:Key="MilestoneGoTextColor">#EB9C92</Color>
    <Color x:Key="MilestoneSFaceColor">#2F4744</Color>
    <Color x:Key="MilestoneSTextColor">#8FDAD2</Color>
    <Color x:Key="MilestoneMFaceColor">#33424C</Color>
    <Color x:Key="MilestoneMTextColor">#9CC6DF</Color>

    <!-- 実働日データから起こす2つの印。休業日は静かに、休日の実働日は目を引くように -->
    <Color x:Key="ClosedDayFaceColor">#3A3F44</Color>
    <Color x:Key="ClosedDayTextColor">#AEB4BB</Color>
    <Color x:Key="OpenDayFaceColor">#4A4530</Color>
    <!-- 旧 #D9A24A は OpenDayFace 上 4.22:1 で 4.5 を割っていたため、4.78:1 まで上げる -->
    <Color x:Key="OpenDayTextColor">#E2AE5A</Color>

    <!-- 今の時刻を示す線。暦の中でここだけが「いま」を指す -->
    <Color x:Key="NowLineColor">#E79B91</Color>

</ResourceDictionary>
