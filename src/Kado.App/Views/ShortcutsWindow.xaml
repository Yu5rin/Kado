<!--
    ショートカットの一覧。

    グローバルホットキーは、押せることを知らないと一生使われない。どこにも
    書いていなかったので、⚙ から開ける一覧にした。中身は Shortcuts が持つ。
-->
<Window x:Class="Kado.App.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ショートカット" Width="520" Height="620"
        Icon="/Assets/app.png"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource InkBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,13,16,11"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock Text="ショートカット" Style="{StaticResource SubheadingTextStyle}" FontWeight="SemiBold" />
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <Button Content="閉じる" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsCancel="True" IsDefault="True" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold"
                                       Margin="0,0,0,6"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Ink3Brush}" />

                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 押すものはキーらしく見せる。文と混ざると読み飛ばす -->
                                            <Border Grid.Column="0" CornerRadius="4" Padding="7,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="{DynamicResource SunkenBrush}"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource LineStrongBrush}">
                                                <TextBlock Text="{Binding Keys}" Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource InkBrush}" />
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{Binding What}" Style="{StaticResource BodyTextStyle}"
                                                       Margin="10,2,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Ink2Brush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
