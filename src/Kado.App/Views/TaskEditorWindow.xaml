<!--
    タスクの編集画面。項目は Google Tasks に合わせてある
    （タイトル＝title／詳細＝notes／期限＝due／完了＝status）。

    Google Tasks の期限は日付だけで時刻を持たないので、こちらも時刻は置かない。
    期限は「今日・明日・来週」から早入れできる。日付欄を開かずに決まることが多い。
-->
<Window x:Class="Kado.App.Views.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kado.App.Converters"
        Icon="/Assets/app.png"
        Title="{Binding HeaderText}" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource InkBrush}">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,13,16,11"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock Text="{Binding HeaderText}" Style="{StaticResource SubheadingTextStyle}" FontWeight="SemiBold" />
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="キャンセル" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                            IsCancel="True" />
                    <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True" IsEnabled="{Binding CanSave}"
                            Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>

                <!-- 既存のタスクを編集しているときだけ出す。新規作成では消すものが無い -->
                <Button Content="削除" DockPanel.Dock="Left" Style="{StaticResource GhostButtonStyle}"
                        Foreground="{DynamicResource SundayBrush}" Margin="0,0,10,0"
                        Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />

                <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,10,0"
                           Foreground="{DynamicResource SundayBrush}"
                           Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibility}}" />
            </DockPanel>
        </Border>

        <StackPanel Margin="16,14">
            <TextBlock Text="タイトル" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="TitleBox" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,12"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="期限を付ける" IsChecked="{Binding HasDue}" Margin="0,0,16,0" />
                <CheckBox Content="完了" IsChecked="{Binding IsDone}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="期限" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker Width="128" Style="{StaticResource FieldDatePickerStyle}"
                                IsEnabled="{Binding HasDue}"
                                SelectedDate="{Binding Due, Converter={StaticResource DateOnlyToDateTime}}" />
                </StackPanel>

                <!-- 早入れ。日付欄を開かずに決まることが多い -->
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="よく使う期限" Style="{StaticResource FieldLabelStyle}" />
                    <ItemsControl ItemsSource="{Binding DuePresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Style="{StaticResource ChipButtonStyle}"
                                        Click="OnDuePresetClicked" Tag="{Binding Date}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,0,0,12"
                        Visibility="{Binding TaskLists, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="タスクリスト" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox Width="176" HorizontalAlignment="Left"
                          Style="{StaticResource FieldComboBoxStyle}"
                          ItemsSource="{Binding TaskLists}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding TaskListId}" />
            </StackPanel>

            <TextBlock Text="詳細" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Style="{StaticResource FieldNoteBoxStyle}"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </DockPanel>
</Window>
