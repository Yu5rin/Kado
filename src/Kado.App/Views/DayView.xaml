<!--
    日ビュー。寸法は mock-window.html の .day-hd と .dayline に合わせてある。

      .day-hd  日付 18px ・ マイルストーン ・ 実働日 ・ 右端に月末までの残り
      .dayline 時刻の見出し 56px 幅 / 1時間 56px。列が1本なので週より縦に余裕を取る
-->
<UserControl x:Class="Kado.App.Views.DayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Kado.App.Converters"
             xmlns:views="clr-namespace:Kado.App.Views"
             AllowDrop="True" PreviewDragOver="OnDragMoving" PreviewDrop="OnDragFinished"
             PreviewMouseWheel="OnWheel"
             x:Name="Root"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:MilestoneBrushConverter x:Key="MilestoneBrush" />

        <!-- 日付の行のラベルの右クリックメニューは Themes/Controls.xaml の
             共有 MilestoneMenu を使う（項目13） -->

        <conv:TimelineOffsetToMarginConverter x:Key="TimelineOffsetToMargin" />

        <!--
            終日レーンの右クリックメニュー。ContextMenu は画面の木から外れて出るので、
            Tag に MainViewModel を入れておき、PlacementTarget 経由で引く。
        -->
        <ContextMenu x:Key="AllDayEventMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="削除"
                      Command="{Binding PlacementTarget.Tag.DeleteChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <ContextMenu x:Key="AllDayTaskMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditTaskChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <!-- 文言は完了・未完了で切り替える。既定は「完了にする」 -->
            <MenuItem Command="{Binding PlacementTarget.Tag.ToggleTaskChipDoneCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="完了にする" />
                        <Style.Triggers>
                            <DataTrigger Value="True"
                                         Binding="{Binding PlacementTarget.DataContext.IsDone,
                                                   RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <Setter Property="Header" Value="完了を取り消す" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem Header="削除"
                      Command="{Binding PlacementTarget.Tag.DeleteTaskChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

    </UserControl.Resources>

    <DockPanel>
        <!--
            日付ヘッダ。実働日の通し番号を出す場所のひとつ（要件書 4.3）。
            「ビュー見出し」の寸法を一覧・年ビューと揃える（項目20。Padding 12,8 /
            SubheadingTextStyle 相当）
        -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel>
                <TextBlock Style="{StaticResource BodyTextStyle}" DockPanel.Dock="Right" Text="{Binding RemainingInMonthText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Ink3Brush}"
                           Typography.NumeralAlignment="Tabular"
                           Visibility="{Binding RemainingInMonthText, Converter={StaticResource NullToVisibility}}" />

                <TextBlock Text="{Binding Title}" Style="{StaticResource SubheadingTextStyle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />

                <!-- 祝日名。予定ではなく日付の添え書きとして出す -->
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Day.HolidayName}" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SundayBrush}"
                           Visibility="{Binding Day.HolidayName,
                                       Converter={StaticResource NullToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Day.Milestones}" Margin="10,0,0,0"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="5,0" Margin="0,0,4,0"
                                    Cursor="Hand" ToolTip="ダブルクリックで編集 ・ 右クリックでメニュー"
                                    Tag="{Binding DataContext,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                    ContextMenu="{StaticResource MilestoneMenu}"
                                    MouseLeftButtonDown="OnMilestoneClicked"
                                    Background="{Binding Name, Converter={StaticResource MilestoneBrush},
                                                ConverterParameter=Face}">
                                <TextBlock Style="{StaticResource MicroTextStyle}" Text="{Binding Name}" FontWeight="SemiBold"
                                           LineHeight="15"
                                           Foreground="{Binding Name,
                                                       Converter={StaticResource MilestoneBrush}}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding WorkingDayLabel}" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"
                           Typography.NumeralAlignment="Tabular"
                           Visibility="{Binding WorkingDayLabel, Converter={StaticResource NullToVisibility}}" />
            </DockPanel>
        </Border>

        <!-- 終日レーン。ここのタスクを下へドラッグして作業時間にする（要件書 5.4） -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineStrongBrush}">
            <DockPanel>
                <TextBlock Style="{StaticResource MicroTextStyle}" DockPanel.Dock="Left" Width="56" Text="終日"
                           TextAlignment="Right" Padding="0,4,5,0"
                           Foreground="{DynamicResource Ink3Brush}" />
                <Border DockPanel.Dock="Right"
                        Width="{DynamicResource ScrollBarThickness}" />

                <Border x:Name="AllDay" Padding="3" MinHeight="30" Background="Transparent"
                        BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}"
                        AllowDrop="True" DragOver="OnAllDayDragOver" Drop="OnAllDayDropped">
                    <!-- 終日の予定・タスクが多い日でも3行ぶん程度で頭打ちにし、内側でスクロールさせる。
                         ここで抑えないと、時間軸が下へ押し出される -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="88">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Day.AllDayEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="5,1" Margin="0,0,0,2" Cursor="Hand"
                                            Tag="{Binding DataContext,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                            ContextMenu="{StaticResource AllDayEventMenu}"
                                            MouseLeftButtonDown="OnAllDayEventClicked"
                                            MouseMove="OnAllDayDragging"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Label}"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Tooltip}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Day.Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Box" CornerRadius="3" Padding="5,1" Margin="0,0,0,2" Cursor="SizeAll"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                                            Tag="{Binding DataContext,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                            ContextMenu="{StaticResource AllDayTaskMenu}"
                                            MouseLeftButtonDown="OnAllDayTaskClicked"
                                            MouseMove="OnAllDayDragging"
                                            ToolTip="ダブルクリックで編集 ・ ドラッグで別の日へ移動">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="Dot" Width="5" Height="5" Margin="0,0,4,0"
                                                     VerticalAlignment="Center"
                                                     Stroke="{DynamicResource AccentBrush}"
                                                     StrokeThickness="1.5" />
                                            <TextBlock x:Name="Title" Style="{StaticResource CaptionTextStyle}" Text="{Binding Title}"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 済みタスクは右パネル・一覧と同じ見た目に揃える（項目4） -->
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource DoneBrush}" />
                                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource DoneBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>

        <!-- 時間軸 -->
        <!-- 選んだ時間帯を、ここで測った高さに割り付ける -->
        <!-- バーは常に出す。上の段はこの幅ぶんを空けてあり、消えると列がずれる -->
        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="OnTimelineResized" PreviewMouseWheel="OnTimelineWheel">
            <Grid Height="{Binding TimelineHeight}">
                <DockPanel>
                    <ItemsControl DockPanel.Dock="Left" Width="56" ItemsSource="{Binding HourLabels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    高さは枠で取り、文字だけを線の上へずらす。
                                    文字に負の余白を付けると、その分だけ1行ずつ詰まって
                                    見出しと罫線が食い違っていく（24時間ぶんで2時間ずれる）
                                -->
                                <Border Height="{Binding DataContext.HourHeight, ElementName=Root}">
                                    <TextBlock Style="{StaticResource MicroTextStyle}" Text="{Binding}" VerticalAlignment="Top"
                                               TextAlignment="Right" Padding="0,0,6,0" Margin="0,-5,0,0"
                                               Foreground="{DynamicResource Ink3Brush}"
                                               Typography.NumeralAlignment="Tabular" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <views:TimelineColumnView DataContext="{Binding Day}"
                                              HourLabels="{Binding DataContext.HourLabels, ElementName=Root}"
                                              RowHeight="{Binding DataContext.HourHeight, ElementName=Root}"
                                              NowOffset="{Binding DataContext.NowOffset, ElementName=Root}"
                                              ShowNow="{Binding DataContext.ShowNowLine, ElementName=Root}"
                                    DayStartHour="{Binding DataContext.DayStartHour, ElementName=Root}" />
                </DockPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
