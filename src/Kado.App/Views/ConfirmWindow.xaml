<!--
    ボタンの文言を指定できる確認の窓。MessageBox の OK／キャンセルでは、何を押すと何が起きるかが
    ボタンから読めない（［削除］［キャンセル］、［破棄する］［編集に戻る］）。
    既定のボタンは取り消す側。誤って Enter を押しても、消えたり捨てたりしない。
-->
<Window x:Class="Kado.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/app.png"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource InkBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                        IsCancel="True" IsDefault="True" />
                <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnAcceptClick" />
            </StackPanel>
        </Border>

        <StackPanel Margin="16,14">
            <TextBlock x:Name="Heading" Style="{StaticResource SubheadingTextStyle}" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="Body" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Ink2Brush}" />
        </StackPanel>
    </DockPanel>
</Window>
