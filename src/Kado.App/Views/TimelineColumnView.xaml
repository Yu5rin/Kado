<!--
    時間軸の1列。週ビューと日ビューで使い回す。

      .hcell  1時間ぶんの高さ（週 44px ／ 日 56px）/ 下に 1px の罫線
      .eblk   左に 3px の帯 / radius 3 / padding 2 5 / 時刻は 9.5px

    ブロックは Canvas ではなく余白で置く。横に伸ばしたいため。
-->
<UserControl x:Class="Kado.App.Views.TimelineColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Kado.App.Converters"
             x:Name="Root">

    <UserControl.Resources>
        <conv:TimelineOffsetToMarginConverter x:Key="TimelineOffsetToMargin" />
        <conv:EventColorBrushConverter x:Key="EventColorBrush" />
        <conv:EventColorFaceConverter x:Key="EventColorFace" />
        <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVisibility" />

        <!--
            右クリックメニューは Themes/Controls.xaml の共有メニューを使う。予定のブロックは
            EventContextMenu、空いた時間帯は DayContextMenu。ContextMenu は画面の木から外れて出るので、
            祖先をたどっても Window に届かない。メニューを付ける要素の Tag に MainViewModel を入れておき、
            PlacementTarget 経由で引く。

            空いた時間帯のメニューの「この日に予定を追加」は、右クリックした時刻（15分に丸めた）から
            1時間の予定にする。メニューは離したときに開くので、押した時点で時刻を控える
            （OnColumnRightPressed → DayMenu.Time）。ブロックの上で右クリックしたときは、
            ブロックのメニューだけが開く。
        -->
    </UserControl.Resources>

    <Border x:Name="Column" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}"
            Background="Transparent"
            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
            ContextMenu="{StaticResource DayContextMenu}"
            PreviewMouseRightButtonDown="OnColumnRightPressed"
            AllowDrop="True" DragOver="OnColumnDragOver" Drop="OnColumnDropped"
            MouseLeftButtonDown="OnColumnPressed"
            MouseMove="OnColumnHovering" MouseLeave="OnColumnLeft">
        <Grid>
            <!--
                ホバー中の15分幅の帯（項目2）。ダブルクリックで何が起きるかを、
                押す前に分かるようにする。予定の上に出しても
                実害は無いので、いちばん下（罫線のすぐ上）に置く
            -->
            <Border x:Name="HoverBand"
                    VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="{DynamicResource AccentSoftBrush}" />

            <!-- 1時間ごとの罫線 -->
            <ItemsControl ItemsSource="{Binding HourLabels, ElementName=Root}" IsHitTestVisible="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="{Binding RowHeight, ElementName=Root}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource LineBrush}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                今の時刻。今日の列にだけ引く。
                線の左端に丸を置くのは、どの列の線なのかを一目で分かるようにするため。
                丸は線より背が高いので、上下にはみ出して描かれる
            -->
            <Grid VerticalAlignment="Top" Height="1.5" IsHitTestVisible="False" Panel.ZIndex="2"
                  Margin="{Binding NowOffset, ElementName=Root,
                           Converter={StaticResource TimelineOffsetToMargin}}">
                <Grid.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                        <Binding Path="IsToday" />
                        <Binding Path="ShowNow" ElementName="Root" />
                    </MultiBinding>
                </Grid.Visibility>

                <Border Background="{DynamicResource NowLineBrush}" />
                <Ellipse Width="10" Height="10" Fill="{DynamicResource NowLineBrush}"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0" />
            </Grid>

            <!-- 予定。重ねて置くので入れ物は Grid -->
            <ItemsControl ItemsSource="{Binding Blocks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Block" VerticalAlignment="Top" CornerRadius="3" Padding="5,2"
                                Cursor="Hand" ToolTip="{Binding Tooltip}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                ContextMenu="{StaticResource EventContextMenu}"
                                MouseLeftButtonDown="OnBlockClicked"
                                MouseMove="OnBlockDragging"
                                Height="{Binding Height}"
                                Margin="{Binding Top, Converter={StaticResource TimelineOffsetToMargin}}"
                                Background="{Binding Color, Converter={StaticResource EventColorFace}}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="{Binding Color, Converter={StaticResource EventColorBrush}}">
                            <!--
                                時刻は書かない。置かれている場所そのものが時刻なので、
                                短い予定だと時刻だけで埋まって題が読めなくなる。
                                正確な時刻はマウスを載せれば出る
                            -->
                            <StackPanel ClipToBounds="True">
                                <TextBlock Text="{Binding Title}" FontSize="11" LineHeight="14"
                                           Foreground="{DynamicResource InkBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <!-- 稼働する日と休業する日で面を分ける（要件書 4.3） -->
                <DataTrigger Binding="{Binding IsWorkingDayLit}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WorkingDayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OffDayBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
</UserControl>
