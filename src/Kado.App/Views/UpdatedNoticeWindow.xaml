<!--
    更新したあとの最初の起動で、トレイの知らせを押すと開く窓。変更点（リリース本文）を文字のまま見せる。
    更新の窓（UpdateWindow）が本文を文字のまま出しているのと同じ扱い。
-->
<Window x:Class="Kado.App.Views.UpdatedNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/app.png"
        Title="更新しました" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource InkBrush}">

    <!-- ほかのダイアログと同じ3段の骨組み（見出しの帯／中身／ボタンの帯） -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,13,16,11"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock x:Name="TitleText" Style="{StaticResource SubheadingTextStyle}" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="閉じる"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="96"
                        IsDefault="True" IsCancel="True" Click="Close_Click" />

                <Button x:Name="OpenPageButton" Content="リリースのページを開く" HorizontalAlignment="Left"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OpenPage_Click" />
            </DockPanel>
        </Border>

        <StackPanel Margin="16,14">
            <!-- 本文はリリース本文を文字のまま出す（Markdown としては解釈しない） -->
            <Border CornerRadius="5" Padding="10" MaxHeight="260"
                    Background="{DynamicResource SunkenBrush}"
                    BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                               Foreground="{DynamicResource Ink2Brush}" />
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource Ink3Brush}" />
        </StackPanel>
    </DockPanel>
</Window>
