<!--
    月ビュー。寸法と構造は mock-window.html の月グリッドに合わせてある。

      .cell   padding 3px 5px 4px / gap 2px / overflow hidden
      .drow   日付とマイルストーンを横に並べ、ラベルは残る領域で中央寄せ
      .dn     12px / weight 500 / 等幅数字
      .hol    10px / 日曜色
      .ms     10px / weight 600 / padding 0 5px / radius 3px
      .chip   11px / padding 1px 5px / radius 3px / 左に 3px の帯
      .more   10px / 補助色

    またがる予定は .chip では出さず、週の行ごとに段を決めた「帯」として並べる
    （EventBands）。1日ずつ切って並べると、同じ予定が日ごとに別々に入っている
    ように見える。

    実働日の通し番号はここには出さない（要件書 4.3）。
-->
<UserControl x:Class="Kado.App.Views.MonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Kado.App.Converters"
             Background="{DynamicResource BackgroundBrush}"
             AllowDrop="True" PreviewDragOver="OnDragMoving" PreviewDrop="OnDragFinished"
             PreviewMouseWheel="OnWheel">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:MilestoneBrushConverter x:Key="MilestoneBrush" />
        <conv:EventColorBrushConverter x:Key="EventColorBrush" />
        <conv:EventColorFaceConverter x:Key="EventColorFace" />

        <!--
            曜日ヘッダ（.dow）。日曜は赤、土曜は青。週の開始曜日は設定で変わるので位置では決めない。
            マスの中の補助文字（＋N）と同じく、休業日の面の上でも 4.5:1 を確保できるよう
            Ink3Brush から Ink2Brush へ寄せる
        -->
        <DataTemplate x:Key="WeekDayHeaderTemplate">
            <TextBlock Style="{StaticResource CaptionTextStyle}" x:Name="Label" Text="{Binding Name}" Padding="0,5"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource Ink2Brush}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSunday}" Value="True">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SundayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SaturdayBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>



        <!-- 予定のチップ。「09:00 計画レビュー」のように時刻を頭に付けて1行で出す -->
        <!--
            詰めた形（スリムパネル）の印。名前は出さず、予定が入っていることだけを
            色で示す。中身は下の一覧で読む
        -->
        <DataTemplate x:Key="CompactMarkTemplate">
            <Border Height="2.5" CornerRadius="1.25" Margin="1,0.75"
                    ToolTip="{Binding Tooltip}"
                    Background="{Binding Color, Converter={StaticResource EventColorBrush}}" />
        </DataTemplate>

        <DataTemplate x:Key="EventChipTemplate">
            <!--
                ダブルクリックでその予定を開く。マス側の受け手が先に取ると
                「この日に予定を足す」になってしまうので、ここで止める
            -->
            <Border CornerRadius="3" Padding="5,1" Margin="0,2,0,0"
                    Background="{Binding Color, Converter={StaticResource EventColorFace}}"
                    BorderThickness="3,0,0,0"
                    BorderBrush="{Binding Color, Converter={StaticResource EventColorBrush}}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource EventContextMenu}"
                    MouseLeftButtonDown="OnEventChipClicked"
                    MouseMove="OnChipDragging">
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Label}" LineHeight="16"
                           Foreground="{DynamicResource InkBrush}"
                           TextTrimming="CharacterEllipsis"
                           Typography.NumeralAlignment="Tabular"
                           ToolTip="{Binding Tooltip}" />
            </Border>
        </DataTemplate>

        <!--
            またがる予定の帯。1日ずつ角を丸めて左に帯を立てると、隣のマスに別の予定が
            並んでいるように見える。端だけを丸め、途中の日は左右の余白（5px）ぶん
            はみ出させて、マスの境まで伸ばす。残るのは 1px の罫線だけになる。

            途中の日は文字を出さない（EventChipViewModel.Text）。毎日タイトルを
            繰り返すのが、切れて見える一番の理由だった。週をまたぐときは行の頭で出す。
        -->
        <DataTemplate x:Key="EventBandTemplate">
            <Border x:Name="Band" CornerRadius="3,0,0,3" Padding="5,1" Margin="0,2,-5,0"
                    Background="{Binding Color, Converter={StaticResource EventColorFace}}"
                    BorderThickness="3,0,0,0"
                    BorderBrush="{Binding Color, Converter={StaticResource EventColorBrush}}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource EventContextMenu}"
                    MouseLeftButtonDown="OnEventChipClicked"
                    MouseMove="OnChipDragging">
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Text}" LineHeight="16"
                           Foreground="{DynamicResource InkBrush}"
                           TextTrimming="CharacterEllipsis"
                           Typography.NumeralAlignment="Tabular"
                           ToolTip="{Binding Tooltip}" />
            </Border>

            <DataTemplate.Triggers>
                <!-- 途中の日。左右とも隣へ繋ぐので、角も帯も立てない -->
                <DataTrigger Binding="{Binding Span}" Value="Middle">
                    <Setter TargetName="Band" Property="CornerRadius" Value="0" />
                    <Setter TargetName="Band" Property="Margin" Value="-5,2,-5,0" />
                    <Setter TargetName="Band" Property="BorderThickness" Value="0" />
                </DataTrigger>

                <!-- 最終日。右だけ丸める -->
                <DataTrigger Binding="{Binding Span}" Value="End">
                    <Setter TargetName="Band" Property="CornerRadius" Value="0,3,3,0" />
                    <Setter TargetName="Band" Property="Margin" Value="-5,2,0,0" />
                    <Setter TargetName="Band" Property="BorderThickness" Value="0" />
                </DataTrigger>

                <!--
                    週をまたいで続く行の頭。ここだけはタイトルが出るので、左は
                    はみ出させない。出すと文字が罫線の下に潜る
                -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Span}" Value="Middle" />
                        <Condition Binding="{Binding ShowsTitle}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Band" Property="Margin" Value="0,2,-5,0" />
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Span}" Value="End" />
                        <Condition Binding="{Binding ShowsTitle}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Band" Property="Margin" Value="0,2,0,0" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            帯の1段。予定が無くても高さぶんの場所を空ける。空けないと、その日だけ
            下の予定がせり上がって、隣の日と段が揃わない
        -->
        <DataTemplate x:Key="EventBandSlotTemplate">
            <ContentControl Height="20" Content="{Binding Chip}"
                            ContentTemplate="{StaticResource EventBandTemplate}"
                            HorizontalContentAlignment="Stretch" />
        </DataTemplate>

        <!-- タスクは帯を持たず、丸印を添えて予定と区別する -->
        <DataTemplate x:Key="TaskChipTemplate">
            <!-- 押せる面を作るため Background を敷く。透明でも当たり判定は残る -->
            <Border x:Name="Chip" Background="Transparent" Margin="2,2,0,0"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource TaskContextMenu}"
                    MouseLeftButtonDown="OnTaskChipClicked"
                    MouseMove="OnChipDragging">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center"
                             Stroke="{DynamicResource Ink3Brush}" StrokeThickness="1.5" />
                    <TextBlock x:Name="Title" Style="{StaticResource CaptionTextStyle}" LineHeight="16"
                               Foreground="{DynamicResource Ink2Brush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}">
                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding RepeatMark, Mode=OneWay}" Foreground="{DynamicResource Ink3Brush}" />
                    </TextBlock>
                    <!-- 遅れて完了したものが期限日に残す薄い跡だけ、完了した日を添える（「9/11 完了」）。
                         ふつうの添え書き（期限と遅れ）は幅に入らないのでツールチップで読む -->
                    <TextBlock Style="{StaticResource MicroTextStyle}" Text="{Binding FaintNote}"
                               Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Ink3Brush}"
                               Visibility="{Binding FaintNote, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>

            <!--
                済みタスクは右パネル・一覧と同じ見た目に揃える（項目4）。取り消し線＋
                DoneBrush。丸印も DoneBrush にして、同じ「済み」だと分かるようにする
            -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource DoneBrush}" />
                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource DoneBrush}" />
                </DataTrigger>

                <!-- 期限日に残した跡は薄く出す。片付けたのはこの日ではない -->
                <DataTrigger Binding="{Binding IsFaint}" Value="True">
                    <Setter TargetName="Chip" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <!--
            マイルストーン。日付の右に残る領域で中央寄せ（要件書 4.2）。
            ContextMenu は Themes/Controls.xaml の共有 EventContextMenu を使う。

            操作説明のツールチップは外した（項目12）。バッジの文字がそのまま
            マイルストーン名なので、切れて読めなくなる題も無い
        -->
        <DataTemplate x:Key="MilestoneTagTemplate">
            <Border CornerRadius="3" Padding="5,0" HorizontalAlignment="Center"
                    Background="{Binding Name, Converter={StaticResource MilestoneBrush}, ConverterParameter=Face}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource EventContextMenu}"
                    MouseLeftButtonDown="OnMilestoneClicked"
                    MouseMove="OnChipDragging"
                    Cursor="Hand">
                <TextBlock Style="{StaticResource MicroTextStyle}" Text="{Binding Name}" FontWeight="SemiBold" LineHeight="15"
                           Foreground="{Binding Name, Converter={StaticResource MilestoneBrush}}" />
            </Border>
        </DataTemplate>

        <!--
            月のマス（ふつうの形）。日付・マイルストーン・祝日名・帯・予定・タスク・＋N を並べる。

            <b>ふつうの形と詰めた形は、別のテンプレートにして、今の形のほうだけを作る。</b>以前は1つの
            テンプレートに両方の中身を入れ、片方を Collapsed にしていた。Collapsed でも中のバインドと
            コンバーターは評価されるので、見えない側の予定・帯・マイルストーンの色まで毎回引いていた
            （42マスぶん）。切り替えは <c>CellsHost</c> の Style が、MonthViewModel.IsCompact で
            ItemTemplate を差し替える（トリガーはマスごとではなく1つ）。

            操作説明のツールチップは外した（項目12）。予定・タスク・
            マイルストーンはそれぞれ自分のツールチップを持っている。

            月ビューは日を選ぶための面でもある。押しても右ペインが動かないと、
            ミニ月暦からしか日を選べない。InputBinding からは
            RelativeSource の祖先をたどれないので、コードビハインドで受ける
        -->
        <DataTemplate x:Key="MonthCellFullTemplate">
            <Border x:Name="Cell" Margin="0,0,1,1" Padding="5,3,5,4"
                    Background="{DynamicResource PanelBrush}"
                    ClipToBounds="True" Cursor="Hand"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource DayContextMenu}"
                    MouseLeftButtonDown="OnCellClicked"
                    AllowDrop="True"
                    DragOver="OnCellDragOver" DragLeave="OnCellDragLeft"
                    Drop="OnCellDropped">
                <StackPanel>
                    <!-- 日付とマイルストーン。日付は左に固定 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--
                            今日は日付の数字を丸く塗って示す（項目2）。週ビューの
                            NumberFace と同じ構造にする。選択は Cell 側の枠で示すので、
                            このマル自体は既定では透明
                        -->
                        <Border x:Name="DayNumberFace" Grid.Column="0" CornerRadius="9"
                                Width="18" Height="18" Background="Transparent"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyTextStyle}" x:Name="DayNumber"
                                       Text="{Binding DayNumber}" FontWeight="Medium"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource InkBrush}" />
                        </Border>

                        <ItemsControl Grid.Column="1" Margin="4,0,0,0"
                                      ItemsSource="{Binding Milestones}"
                                      ItemTemplate="{StaticResource MilestoneTagTemplate}" />
                    </Grid>

                    <!-- 祝日名。休みの理由が読めると予定を立てやすい -->
                    <TextBlock Style="{StaticResource MicroTextStyle}" Text="{Binding HolidayName}" LineHeight="13"
                               Foreground="{DynamicResource SundayBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HolidayName, Converter={StaticResource NullToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Bands}"
                                  ItemTemplate="{StaticResource EventBandSlotTemplate}" />
                    <ItemsControl ItemsSource="{Binding Events}"
                                  ItemTemplate="{StaticResource EventChipTemplate}" />
                    <ItemsControl ItemsSource="{Binding Tasks}"
                                  ItemTemplate="{StaticResource TaskChipTemplate}" />

                    <!--
                        入りきらなかった件数。隠れたまま気づけないのを防ぐ。
                        休業日の面の上でも 4.5:1 を確保できるよう Ink2Brush を使う
                    -->
                    <TextBlock Style="{StaticResource MicroTextStyle}" Text="{Binding OverflowLabel}" Margin="3,1,0,0"
                               Foreground="{DynamicResource Ink2Brush}"
                               Visibility="{Binding OverflowLabel, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <!--
                    実働日データを持つ日は、稼働する日と休業する日で面を分ける。
                    データを持たない日はどちらでもないので、そのままにしておく。
                    色を足すのではなく面の明るさで示す（要件書 4.3）
                -->
                <DataTrigger Binding="{Binding IsWorkingDayLit}" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource WorkingDayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource OffDayBrush}" />
                </DataTrigger>

                <!--
                    前後の月は面を沈めず、日付の Opacity だけで示す（項目3）。
                    休業日の面（OffDayBrush）と前後の月が同じ調子の灰色だと見分けが
                    付かなかったため、面を分けるのをやめて「灰色の面＝休業日」の
                    一対一にする。セル全体を薄くすると予定まで読めなくなる。
                    0.4 だと薄すぎて読みづらかったため 0.6 に上げる
                -->
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter TargetName="DayNumber" Property="Opacity" Value="0.6" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                    <Setter TargetName="DayNumber" Property="Foreground"
                            Value="{DynamicResource SaturdayBrush}" />
                </DataTrigger>

                <!--
                    祝日は日付そのものを赤にする（モックに合わせる）。土曜に重なっても
                    赤を採るので、土曜より後に置いてこちらを勝たせる
                -->
                <DataTrigger Binding="{Binding IsSundayLike}" Value="True">
                    <Setter TargetName="DayNumber" Property="Foreground"
                            Value="{DynamicResource SundayBrush}" />
                </DataTrigger>

                <!-- 前後の月と同じ色にすると、載せているのか月の外なのか読めない -->
                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource CellHoverBrush}" />
                </Trigger>

                <!--
                    今日は日付の数字を丸く塗って示す（項目2）。Cell 自体には
                    もう触れない
                -->
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="DayNumberFace" Property="Background"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="DayNumber" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="DayNumber" Property="Foreground"
                            Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>

                <!--
                    選択はマスの内側に2pxのアクセント枠（項目2）。CellSelectedColor
                    は枠の内側に敷く薄い面として、休業日（OffDayBrush）と近いと
                    紛れるので水色に寄せてある
                -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource CellSelectedBrush}" />
                    <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Cell" Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Cell" Property="Padding" Value="3,1,3,2" />
                </DataTrigger>

                <!--
                    落とし先。いちばん最後に置いて、ホバーや選択より強く出す
                    （後に書いたトリガが勝つ）。掴んだものがどこへ入るのか
                    分からないと、落とす手が止まる
                -->
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Cell" Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Cell" Property="Padding" Value="3,1,3,2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            月のマス（詰めた形）。スリムパネルの月カレンダーと、マス幅が 64px を切ったとき。
            マスに予定の名前を並べても読めないので、日付と、予定が入っていることを示す色だけにする。
            操作の説明（ツールチップ）は出さない。マスが小さいので、載せるたびに
            3行の吹き出しが開いて隣の日が隠れる。同じ説明はふつうの月ビューで読める

            ふつうの形との違いは、内側の余白（2）と、選択したマスの見せ方。詰めた形では
            選択したマスだけ内側の余白や枠が変わると中身がずれて、日付の高さが揃わなくなる。
            選択の枠は通常表示だけに使い、詰めた形では従来どおり面の色だけで示す
        -->
        <DataTemplate x:Key="MonthCellCompactTemplate">
            <Border x:Name="Cell" Margin="0,0,1,1" Padding="2"
                    Background="{DynamicResource PanelBrush}"
                    ClipToBounds="True" Cursor="Hand"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource DayContextMenu}"
                    MouseLeftButtonDown="OnCellClicked"
                    AllowDrop="True"
                    DragOver="OnCellDragOver" DragLeave="OnCellDragLeft"
                    Drop="OnCellDropped">
                <!--
                    詰めた形。年表示のカレンダーと同じ並びにする。実働日
                    カレンダー（Kado）の印は日付の上、それ以外は下。
                    点ではなく帯にするのは、色は分かっても何件あるかが
                    点ではつかめないため
                -->
                <StackPanel VerticalAlignment="Top" Margin="0,1,0,0">
                    <!--
                        日付の上は、いつも帯1本ぶんの高さを取っておく。これで
                        <b>どの日も日付の高さが揃う</b>。2本ぶん取ると、その
                        ぶん下の予定に回せる行が減る。上に出るのは実働日
                        カレンダー（Kado）の印で、日々の予定は下に並ぶ
                    -->
                    <Border Height="4" ClipToBounds="True">
                        <ItemsControl ItemsSource="{Binding Milestones}"
                                      VerticalAlignment="Bottom">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="2.5" CornerRadius="1.25" Margin="1,0.75"
                                            ToolTip="{Binding Name}"
                                            Background="{Binding Name,
                                                        Converter={StaticResource MilestoneBrush}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Style="{StaticResource BodyTextStyle}" x:Name="CompactNumber" Text="{Binding DayNumber}" LineHeight="15" Margin="0,0,0,1"
                               HorizontalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource InkBrush}" />

                    <ItemsControl ItemsSource="{Binding Bands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="2.5" CornerRadius="1.25" Margin="1,0.75"
                                        Background="{Binding Chip.Color,
                                                    Converter={StaticResource EventColorBrush}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Events}"
                                  ItemTemplate="{StaticResource CompactMarkTemplate}" />
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWorkingDayLit}" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource WorkingDayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource OffDayBrush}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                    <Setter TargetName="CompactNumber" Property="Foreground"
                            Value="{DynamicResource SaturdayBrush}" />
                </DataTrigger>

                <!-- 祝日も赤。土曜に重なっても赤を採るので、土曜より後に置く -->
                <DataTrigger Binding="{Binding IsSundayLike}" Value="True">
                    <Setter TargetName="CompactNumber" Property="Foreground"
                            Value="{DynamicResource SundayBrush}" />
                </DataTrigger>

                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource CellHoverBrush}" />
                </Trigger>

                <!--
                    今日。詰めた形の数字は丸めるだけの余地が無いので、太字とアクセント色で示す
                -->
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="CompactNumber" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="CompactNumber" Property="Foreground"
                            Value="{DynamicResource AccentBrush}" />
                </DataTrigger>

                <!-- 選択は面の色だけ。枠も余白も変えない -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource CellSelectedBrush}" />
                </DataTrigger>

                <!-- 落とし先。いちばん最後に置いて、ホバーや選択より強く出す -->
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Cell" Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Cell" Property="Padding" Value="3,1,3,2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <ItemsControl ItemsSource="{Binding WeekDayHeaders}"
                          ItemTemplate="{StaticResource WeekDayHeaderTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <Grid>
        <ItemsControl x:Name="CellsHost" ItemsSource="{Binding Cells}"
                      SizeChanged="OnCellsResized"
                      Background="{DynamicResource LineBrush}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!--
                マスの形は、MonthViewModel.IsCompact（スリムパネル・マス幅 64px 未満）で
                テンプレートごと切り替える。今の形のほうだけを作る。
                ここにだけ置く（マスごとにトリガーを持たない）
            -->
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="ItemTemplate" Value="{StaticResource MonthCellFullTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact}" Value="True">
                            <Setter Property="ItemTemplate" Value="{StaticResource MonthCellCompactTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
        </ItemsControl>

        <!--
            初めて開いた人への道案内（項目7）。予定が0件・実働日データも無い月は
            白い格子だけが出て、何から始めればいいか分からない。一覧ビューの
            空の一文（IsEmpty）と同じ、中央に重ねる形にする
        -->
        <TextBlock Style="{StaticResource BodyTextStyle}"
                   Text="ダブルクリックで予定を追加 ／ ⚙→設定→実働日データ で会社の暦を取り込む"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                   Foreground="{DynamicResource Ink3Brush}"
                   Visibility="{Binding ShowsEmptyGuide, Converter={StaticResource BoolToVisibility}}"
                   IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</UserControl>
