<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>SlideinaCalendar.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- exe 自体の絵。エクスプローラとタスクバーはこれを見る -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- ウィンドウの左上に出す用。ico から引くより素直に出る -->
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SlideinaCalendar.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlideinaCalendar.Core\SlideinaCalendar.Core.csproj" />
    <ProjectReference Include="..\SlideinaCalendar.Data\SlideinaCalendar.Data.csproj" />
    <ProjectReference Include="..\SlideinaCalendar.Google\SlideinaCalendar.Google.csproj" />
    <ProjectReference Include="..\SlideinaCalendar.Presentation\SlideinaCalendar.Presentation.csproj" />
    <ProjectReference Include="..\SlideinaCalendar.Shell\SlideinaCalendar.Shell.csproj" />
  </ItemGroup>

</Project>
