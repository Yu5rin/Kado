<!--
    ライトテーマの色。値は要件書 5.6 のデザイントークン表と 4.2 のマイルストーン配色から取る。
    ここと Dark.xaml でキーを揃えておき、切り替えは ResourceDictionary の差し替えで行う。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景・面 -->
    <Color x:Key="BackgroundColor">#FBFBFC</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <!-- 一段沈めた面。ホバーと、前後の月にはみ出したマスに使う。
         要件書 5.6 の表には無いが、モックが使っているので値をそこから取る -->
    <Color x:Key="SunkenColor">#F1F2F5</Color>

    <!-- 罫線 -->
    <Color x:Key="LineColor">#E2E4EA</Color>
    <Color x:Key="LineStrongColor">#C8CCD6</Color>

    <!-- 文字（主／副／補助） -->
    <Color x:Key="InkColor">#1C2029</Color>
    <Color x:Key="Ink2Color">#585F6E</Color>
    <Color x:Key="Ink3Color">#8F96A4</Color>

    <!-- アクセント（藍） -->
    <Color x:Key="AccentColor">#27528F</Color>
    <Color x:Key="AccentSoftColor">#E8EEF7</Color>

    <!--
        アクセントの面に重ねる文字色。
        ライトのアクセントは濃い藍なので白地で問題ない（#27528F 上の白は約7.8:1）。
        Dark / Night は逆にアクセントが明るい水色系のため、そちらでは濃色を使う
        （Themes/Dark.xaml・Night.xaml 参照）
    -->
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <!--
        DoneColor（完了したタスクの面）に重ねるチェック印の色。
        DoneColor 自身は「済みを静かに沈める」ための中間トーンなので、
        アクセントとは明暗の向きが逆になることがある。ここだけ別トークンにする
    -->
    <Color x:Key="OnDoneColor">#0F1720</Color>

    <!-- 日曜・祝日 / 土曜 -->
    <Color x:Key="SundayColor">#B03A34</Color>
    <Color x:Key="SaturdayColor">#3B6EA8</Color>

    <!--
        実働日データを持つ日の面。稼働する日と休業する日で分ける。
        どちらも色を足すのではなく面の明るさで示す（要件書 4.3）。
        データを持たない日は PanelColor のまま。ここを見れば「登録済みかどうか」も分かる
    -->
    <Color x:Key="WorkingDayColor">#FBFCFE</Color>
    <Color x:Key="OffDayColor">#E3E7EE</Color>

    <!--
        マスを押したときと、マウスを載せたときの面。
        前後の月（SunkenColor）と同じにすると、載せているのか月の外なのか読めない。
        選択は休業日（OffDayColor）と近いと紛れるので、はっきり青に寄せる。
        4つ（前後の月・休業日・ホバー・選択）が互いに見分けられることが要る
    -->
    <Color x:Key="CellHoverColor">#E6EFFA</Color>
    <Color x:Key="CellSelectedColor">#C7DCF7</Color>

    <!-- 予定のカテゴリ色。モックの ok / amber の変数に対応する -->
    <Color x:Key="CategoryGreenColor">#2F7D5B</Color>
    <Color x:Key="CategoryAmberColor">#C2762B</Color>

    <!-- 完了したタスクの文字色 -->
    <Color x:Key="DoneColor">#A3A9B5</Color>

    <!-- マイルストーン（要件書 4.2）。面と文字は対にして使う -->
    <Color x:Key="MilestoneSpecFaceColor">#FAEDC4</Color>
    <Color x:Key="MilestoneSpecTextColor">#7A5600</Color>
    <Color x:Key="MilestoneGoFaceColor">#F6DDDA</Color>
    <Color x:Key="MilestoneGoTextColor">#8F2F28</Color>
    <Color x:Key="MilestoneSFaceColor">#D7EBE0</Color>
    <Color x:Key="MilestoneSTextColor">#1F6347</Color>
    <Color x:Key="MilestoneMFaceColor">#DDE6F4</Color>
    <Color x:Key="MilestoneMTextColor">#1F4A83</Color>

    <!--
        実働日データから起こす2つの印。
        休業日は静かに、休日の実働日は目を引くように。後者は暦だけ見ていると
        休みだと思って予定を入れそこなう日なので、埋もれては意味がない
    -->
    <Color x:Key="ClosedDayFaceColor">#E7EAEF</Color>
    <Color x:Key="ClosedDayTextColor">#5C6474</Color>
    <Color x:Key="OpenDayFaceColor">#FBE3CE</Color>
    <Color x:Key="OpenDayTextColor">#8A4B12</Color>

    <!-- 今の時刻を示す線。暦の中でここだけが「いま」を指す -->
    <Color x:Key="NowLineColor">#c4372f</Color>

</ResourceDictionary>
