<!--
    アイコン。モックの SVG パスをそのまま使う。
    いずれも 24x24 の座標系で、線幅 1.7 の描き線として使う。

    文字列ではなく PathGeometry で持つ。StaticResource / DynamicResource は
    値をそのまま返して型変換を挟まないため、String を Path.Data に渡すと
    読み込み時に落ちる。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <PathGeometry x:Key="IconMenu" Figures="M4 6h16M4 12h16M4 18h16" />
    <PathGeometry x:Key="IconChevronLeft" Figures="M15 5l-7 7 7 7" />
    <PathGeometry x:Key="IconChevronRight" Figures="M9 5l7 7-7 7" />
    <PathGeometry x:Key="IconSearch" Figures="M17.5 11A6.5 6.5 0 1 1 4.5 11a6.5 6.5 0 0 1 13 0M16 16l4.5 4.5" />
    <PathGeometry x:Key="IconPlus" Figures="M12 5v14M5 12h14" />
    <PathGeometry x:Key="IconCheck" Figures="M4 12.5l5.5 5.5L20 7" />
    <PathGeometry x:Key="IconTrash" Figures="M4 7h16M10 11v6M14 11v6M5 7l1 13h12l1-13M9 7V4h6v3" />
    <PathGeometry x:Key="IconClose" Figures="M6 6l12 12M18 6L6 18" />
    <PathGeometry x:Key="IconSettings" Figures="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5v.2a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1h.2a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1z" />

    <!-- 通知のベル。押して、そのカレンダーを知らせるかどうかを切り替える -->
    <PathGeometry x:Key="IconBell"
                  Figures="M12 3a5 5 0 0 0-5 5v3.5L5.5 14h13L17 11.5V8a5 5 0 0 0-5-5zM10 17a2 2 0 0 0 4 0" />

    <!-- 知らせないときのベル。斜線を重ねる -->
    <PathGeometry x:Key="IconBellOff"
                  Figures="M12 3a5 5 0 0 0-5 5v3.5L5.5 14h13L17 11.5V8a5 5 0 0 0-5-5zM10 17a2 2 0 0 0 4 0M4 4l16 16" />

    <!-- 新しい予定の入れ先を示す印 -->
    <!-- 出しかた（ウィンドウ／スライド）。画面と、そこから出る帯 -->
    <PathGeometry x:Key="IconLayout"
                  Figures="M4 5h16v14H4zM14 5v14" />

    <!-- 年表示の出し方。ストリップは1行1か月なので、横に長い行を重ねた形 -->
    <PathGeometry x:Key="IconRows"
                  Figures="M3 5h18v14H3zM3 9.7h18M3 14.3h18" />

    <!-- 年表示の出し方。カレンダーは12枚並ぶので、格子 -->
    <PathGeometry x:Key="IconGrid"
                  Figures="M3 5h18v14H3zM3 9.7h18M3 14.3h18M9 5v14M15 5v14" />

    <!-- 出すパネルの選び方。3つの区画 -->
    <PathGeometry x:Key="IconPanes"
                  Figures="M3 5h18v14H3zM9 5v14M15 5v14" />

    <!-- ピン。押すと画面を分割し、他のウィンドウと重ならなくなる -->
    <PathGeometry x:Key="IconPin"
                  Figures="M9 4h6l-1 6 3 3H7l3-3-1-6M12 13v7" />

    <PathGeometry x:Key="IconStar"
                  Figures="M12 3.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 9.7l5.9-.9z" />

</ResourceDictionary>
