<!--
    ダークテーマの色。キーは Light.xaml と一対一で揃える。
    値は要件書 5.6 のデザイントークン表と 4.2 のマイルストーン配色から取る。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#1A1D24</Color>
    <Color x:Key="PanelColor">#20242C</Color>
    <Color x:Key="SunkenColor">#15181E</Color>

    <Color x:Key="LineColor">#2C313B</Color>
    <Color x:Key="LineStrongColor">#3A4150</Color>

    <Color x:Key="InkColor">#E6E9EF</Color>
    <Color x:Key="Ink2Color">#A8B0BE</Color>
    <Color x:Key="Ink3Color">#727A89</Color>

    <Color x:Key="AccentColor">#7AA5DF</Color>
    <Color x:Key="AccentSoftColor">#233247</Color>

    <!--
        アクセントの面に重ねる文字色。
        Dark のアクセント #7AA5DF は明るい水色で、白文字だと約2.5:1 しか出ない
        （WCAG AA の 4.5:1 を割る）。濃紺 #0F1720 なら約7.1:1 まで上がる
    -->
    <Color x:Key="OnAccentColor">#0F1720</Color>

    <!-- DoneColor（完了したタスクの面）に重ねるチェック印の色。白で約5.9:1 出るので据え置き -->
    <Color x:Key="OnDoneColor">#FFFFFF</Color>

    <Color x:Key="SundayColor">#E0827C</Color>
    <Color x:Key="SaturdayColor">#7AA5DF</Color>

    <Color x:Key="WorkingDayColor">#242A34</Color>
    <Color x:Key="OffDayColor">#12151A</Color>

    <!-- マスを押したときと、マウスを載せたときの面。前後の月・休業日と見分けられること -->
    <Color x:Key="CellHoverColor">#2B3444</Color>
    <Color x:Key="CellSelectedColor">#31486B</Color>

    <Color x:Key="CategoryGreenColor">#5FB08A</Color>
    <Color x:Key="CategoryAmberColor">#D59A55</Color>

    <Color x:Key="DoneColor">#5D6472</Color>

    <Color x:Key="MilestoneSpecFaceColor">#4A3A14</Color>
    <Color x:Key="MilestoneSpecTextColor">#E8CD7E</Color>
    <Color x:Key="MilestoneGoFaceColor">#4A2320</Color>
    <Color x:Key="MilestoneGoTextColor">#F0B3AD</Color>
    <Color x:Key="MilestoneSFaceColor">#1D3D30</Color>
    <Color x:Key="MilestoneSTextColor">#8FD3B4</Color>
    <Color x:Key="MilestoneMFaceColor">#1F3352</Color>
    <Color x:Key="MilestoneMTextColor">#A9C8EE</Color>

    <!-- 実働日データから起こす2つの印。休業日は静かに、休日の実働日は目を引くように -->
    <Color x:Key="ClosedDayFaceColor">#2A2F38</Color>
    <Color x:Key="ClosedDayTextColor">#9BA3B2</Color>
    <Color x:Key="OpenDayFaceColor">#4B3116</Color>
    <Color x:Key="OpenDayTextColor">#F0BE85</Color>

    <!-- 今の時刻を示す線。暦の中でここだけが「いま」を指す -->
    <Color x:Key="NowLineColor">#e0827c</Color>

</ResourceDictionary>
