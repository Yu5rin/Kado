<!--
    コントロールの見た目。寸法は mock-window.html の CSS から取る。

      .ib       28x28 / radius 5 / hover で面を沈める
      .gbtn     h28 / padding 0 11 / 枠 1px
      .seg      外枠 1px / radius 5 / ボタン h28 padding 0 13 / 選択中はアクセントで塗る
      .wdchip   面 ai-soft / radius 5 / padding 3 10 / 数字は 14px でアクセント色
      .search   h28 / 枠 1px / radius 5 / 幅 190
      .calcbtn  幅いっぱい / 枠 1px / radius 5 / padding 6
      .box      15x15 / 枠 1.5px / radius 3.5
      .addrow   枠なし / padding 14,6 / ホバーでだけ面が付く（一覧の1行として地続きに見せる。項目1）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:views="clr-namespace:SlideinaCalendar.App.Views"
                    xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        アイコンはここでも読み込む。別の辞書に置いた StaticResource は、
        親をたどれる保証が無い。Theme.xaml 側の読み込みと重なるが害はない。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:HexBrushConverter x:Key="HexBrush" />

    <!--
        日付の行のラベル（マイルストーン）の右クリックメニュー（項目13）。
        以前は MainWindow・MonthView・SidebarLayout・WeekView・DayView の5か所に
        一字一句同じものが重複定義されていた。ここに1つ置いて共有する。

        ContextMenu は画面の木から外れて出るので、祖先をたどっても Window に届かない。
        使う側は Tag に MainViewModel（Window の DataContext）を入れ、この定義は
        PlacementTarget 経由でそれを引く。DataContext を自分の定義スコープから
        継承する作りではないので、どの Window の Resources から呼ばれても、
        呼び出し側が同じ Tag／CommandParameter の付け方をしている限り同じように動く
    -->
    <ContextMenu x:Key="MilestoneMenu">
        <MenuItem Header="編集"
                  Command="{Binding PlacementTarget.Tag.EditMilestoneCommand,
                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext,
                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Separator />
        <MenuItem Header="削除"
                  Command="{Binding PlacementTarget.Tag.DeleteMilestoneCommand,
                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext,
                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </ContextMenu>

    <!--
        キーボードで辿ったときの焦点の輪（項目8）。
        Tab で回っても居場所が分からなかった。IconButtonStyle / GhostButtonStyle /
        SegmentButtonStyle / MiniDayStyle の FocusVisualStyle に共通で当てる。
        Margin を負にして、ボタン自身の縁の外側に輪を描く
    -->
    <Style x:Key="FocusRingStyle" TargetType="Control">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                               RadiusX="6" RadiusY="6" Margin="-2"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- アイコンボタン -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8）。ホバーより濃い面にして押し込んだと分かるようにする -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        押した状態が残るアイコンボタン（ピン）。
        入っているあいだはアクセント色で、留まっていることが一目で分かるようにする
    -->
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        スクロールバー。
        WPF の既定は Windows クラシックの見た目で、配色を切り替えても白いまま残る。
        ダークにすると画面の端だけが明るく浮いて、そこが目に付く。

        矢印のボタンは置かない。今どきのアプリには無く、押されないわりに場所を食う。
        つまみは細く、乗せたときだけ濃くする。
    -->
    <!--
        スクロールバーの太さ。
        時間軸のヘッダはこのぶんだけ場所を空けて、下の列と縦線を揃えている。
        ここを変えたら向こうもずれるので、1か所で持つ
    -->
    <sys:Double x:Key="ScrollBarThickness">11</sys:Double>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Root" CornerRadius="4" Margin="3"
                            Background="{DynamicResource LineStrongBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Ink3Brush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Ink2Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- つまみの外側。押しても飛ばないよう、透明な当たり判定だけ持たせる -->
    <Style x:Key="ScrollTrackButtonStyle" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="{StaticResource ScrollBarThickness}" />
        <Setter Property="MinWidth" Value="{StaticResource ScrollBarThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollTrackButtonStyle}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollTrackButtonStyle}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{StaticResource ScrollBarThickness}" />
                <Setter Property="MinHeight" Value="{StaticResource ScrollBarThickness}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollTrackButtonStyle}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollTrackButtonStyle}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 枠線だけのボタン（今日・実働日計算・＋予定） -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5"
                            BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                        <!--
                            無効時。SegmentButtonStyle の無効表示（Opacity 0.5 / Cursor を
                            既定へ戻す）に揃える。押せるように見えて何も起きない状態を消す
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ビュー切替のセグメント。
        RadioButton の既定テンプレートだと丸印が出てしまうので、丸ごと差し替える。
        選択中はアクセントで塗り、区切り線は右側に引く（最後だけ BorderThickness=0）。
    -->
    <!--
        セグメント（一覧・年・月・週・日、ストリップ・カレンダー、予定・タスク）。

        RadioButton ではなく ToggleButton にしてある。RadioButton は仲間どうしで
        自動的に打ち消し合うが、その「仲間」は GroupName か親で決まる。ここは共通の
        見た目なので GroupName を1つ書いてしまい、<b>ビューの切り替えと年ビューの
        ストリップ／カレンダーが同じ仲間になって、互いに消し合っていた</b>。

        どれが選ばれているかは ViewModel が持っていて、表示は片方向に流すだけでよい。
        打ち消し合う仕掛けそのものが要らない。
    -->
    <Style x:Key="SegmentButtonStyle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="{DynamicResource PanelBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{DynamicResource LineStrongBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8）。未選択は面を、選択中は Opacity 0.8 で示す -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Opacity" Value="0.8" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- タスクのチェックボックス -->
    <Style x:Key="TaskCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="15" Height="15" CornerRadius="3.5"
                            Background="{DynamicResource PanelBrush}"
                            BorderThickness="1.5" BorderBrush="{DynamicResource LineStrongBrush}">
                        <!--
                            チェックが付いたときの面は DoneBrush（完了を静かに沈める中間トーン）。
                            アクセント面用の OnAccentBrush はここでは向きが逆になることがあるため、
                            DoneBrush 専用の OnDoneBrush を使う
                        -->
                        <Path x:Name="Mark" Data="{StaticResource IconCheck}"
                              Stroke="{DynamicResource OnDoneBrush}" StrokeThickness="2.2" Visibility="Collapsed"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="9" Height="9" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DoneBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DoneBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ふつうのチェックボックス（設定と編集画面）。
        WPF の既定は面と枠を OS の色で描くので、暗い配色だと白い四角が浮き、
        文字も黒いまま残る。四角も文字もこちらで描く。
    -->
    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="3.5"
                                Margin="0,0,7,0" VerticalAlignment="Center"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderThickness="1.5" BorderBrush="{DynamicResource LineStrongBrush}">
                            <Path x:Name="Mark" Data="{StaticResource IconCheck}"
                                  Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2.2"
                                  Visibility="Collapsed"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="9" Height="9" />
                        </Border>

                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 検索ボックス -->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="Width" Value="190" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="5" Background="{DynamicResource BackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}"
                            Padding="9,0">
                        <DockPanel>
                            <!-- アイコンの粒度を16px@1.7に揃える（項目11） -->
                            <Path DockPanel.Dock="Left" Data="{StaticResource IconSearch}"
                                  Stroke="{DynamicResource Ink3Brush}" StrokeThickness="1.7"
                                  Stretch="Uniform" Width="16" Height="16"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Grid>
                                <!-- 空のときだけ出す。既定は隠しておき、トリガで出す -->
                                <TextBlock x:Name="Placeholder" Text="予定とタスクを検索"
                                           Foreground="{DynamicResource Ink3Brush}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        クイック入力の欄。
        検索と同じ見た目にすると、上の検索欄と見分けがつかない。虫眼鏡は置かず、
        書き方の例をそのまま透かして出す。
    -->
    <Style x:Key="QuickInputBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="5" Background="{DynamicResource BackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}"
                            Padding="9,0">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="例: 明日15時 打合せ @会議室A"
                                       FontSize="11"
                                       Foreground="{DynamicResource Ink3Brush}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ミニ月暦の1マス（.mg b）。
        10.5px / padding 2.5px 0 / radius 3。今日はアクセントで塗り、選択日は内枠で囲う
        （項目2が求める「今日＝塗り・選択＝枠」の形に、ここは元から合っている）。

        10.5px は5段階（項目5）のどれにも属さないモック由来の値
        （docs/README.md 5.6「ミニ月暦」表）。マスは `Margin 0.5` で隙間なく敷き詰めて
        7列ぴったりに収める作りで、11px に上げると行の高さが計算と食い違う恐れがある
        ため、ここは寄せずに据え置く
    -->
    <Style x:Key="MiniDayStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="3" Background="Transparent"
                            BorderThickness="0" BorderBrush="{DynamicResource AccentBrush}"
                            Padding="0,2.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                        </Trigger>

                        <!-- 押した手応え（項目8） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>

                        <!-- 前後の月。薄くするだけで押せるようにはしておく -->
                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SaturdayBrush}" />
                        </DataTrigger>

                        <!-- 祝日は曜日に関わらず赤。土曜より後に置いてこちらを勝たせる -->
                        <DataTrigger Binding="{Binding IsSundayLike}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SundayBrush}" />
                        </DataTrigger>

                        <!-- 選択日は内枠。今日より先に置いて、今日の塗りに負けるようにする -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.5" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ミニ月暦の前月・次月（.mini-hd .ib）。20x20 とツールバーより一回り小さい -->
    <Style x:Key="SmallIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

    <!--
        カレンダー／タスクリストの1行（.ck）。
        チェックを外すと色見本が枠だけになり、文字が沈む。四角いチェックボックスを置くより、
        色見本そのものが状態を示すほうが行が短く済む。
    -->
    <Style x:Key="SourceListRowStyle" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                    <!--
                        並べ替えの最中に、落とすとどこへ入るかを示す線。
                        面の上に重ねて出すので、行の高さは動かない。枠線で出すと
                        中身が 2px ずれて、掴むたびに行が揺れる
                    -->
                    <Border x:Name="DropAbove" Height="2" VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="Collapsed" Panel.ZIndex="1" />
                    <Border x:Name="DropBelow" Height="2" VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="Collapsed" Panel.ZIndex="1" />

                    <Border x:Name="RowBackground" Background="Transparent" Padding="0,3.5">
                        <DockPanel>
                            <Border x:Name="Swatch" DockPanel.Dock="Left"
                                    Width="11" Height="11" CornerRadius="3" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding SwatchColor, Converter={StaticResource HexBrush}}"
                                    BorderThickness="0" BorderBrush="{DynamicResource LineStrongBrush}" />

                            <!--
                                並べ替えの取っ手。ここを掴んだときだけ動かす。
                                行のどこでも掴めるようにすると、チェックを入り切りする
                                ふつうの押し下げと区別が付かない
                            -->
                            <Border x:Name="Grip" DockPanel.Dock="Right"
                                    Background="Transparent" Padding="4,0,0,0"
                                    Cursor="SizeNS" ToolTip="ドラッグで並べ替え">
                                <!-- 文字「⋮⋮」ではなく IconGrip（12@1.5）に揃える（項目6） -->
                                <Path Data="{StaticResource IconGrip}" Stretch="Uniform"
                                      Width="12" Height="12" VerticalAlignment="Center"
                                      Stroke="{DynamicResource LineStrongBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Border>

                            <!--
                                通知のベル。押すと、このカレンダーの予定を既定で
                                知らせるかどうかが切り替わる。予定ごとの指定があれば
                                そちらが勝つ。タスクリストには出さない
                            -->
                            <ToggleButton x:Name="Bell" DockPanel.Dock="Right"
                                          IsChecked="{Binding Notifies, Mode=TwoWay}"
                                          Cursor="Hand" Margin="4,0,0,0"
                                          Focusable="False"
                                          ToolTip="このカレンダーの予定を知らせるかどうか"
                                          Visibility="{Binding HasNotifyToggle,
                                                       Converter={StaticResource BoolToVisibility}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="2">
                                            <Path x:Name="Shape" Data="{StaticResource IconBellOff}"
                                                  Stretch="Uniform" Width="12" Height="12"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Stroke="{DynamicResource Ink3Brush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Shape" Property="Data"
                                                        Value="{StaticResource IconBell}" />
                                                <Setter TargetName="Shape" Property="Stroke"
                                                        Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shape" Property="Opacity" Value="0.7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!--
                                新しい予定の入れ先を示す印。右クリックから選び直せる。
                                どこに入るのかが一覧で分かる
                            -->
                            <Path x:Name="DefaultMark" DockPanel.Dock="Right"
                                  Data="{StaticResource IconStar}" Stretch="Uniform"
                                  Width="12" Height="12" Margin="4,0,0,0"
                                  VerticalAlignment="Center"
                                  Fill="{DynamicResource AccentBrush}"
                                  ToolTip="新しい予定はここに入ります"
                                  Visibility="Collapsed" />

                            <TextBlock x:Name="Label" Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                  </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DropHint}" Value="Above">
                            <Setter TargetName="DropAbove" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DropHint}" Value="Below">
                            <Setter TargetName="DropBelow" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                            <Setter TargetName="DefaultMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Swatch" Property="Background" Value="Transparent" />
                            <Setter TargetName="Swatch" Property="BorderThickness" Value="1.5" />
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger SourceName="Grip" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        節の見出しのすぐ下・一覧の上に置く「＋ 予定を追加」「✓＋ タスクを追加」の行（項目1）。
        右パネル・スリムパネルの両方で使う。ボタンらしい枠は持たず、一覧の1行として
        自然に並ぶ見せ方にする。カーソルを乗せたときだけ面が付く程度（RowDeleteButtonStyle
        などと同じ SunkenBrush のホバー）。横いっぱいに伸びて、行のどこを押しても効く
    -->
    <Style x:Key="SectionAddRowStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!-- 押した手応え（項目8と同じ流儀） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左パネル下の「実働日計算を開く」（.calcbtn）。幅いっぱい -->
    <Style x:Key="CalcButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!--
        編集画面の入力欄。ツールバーの .gbtn と同じ枠・角丸・高さに揃える。
        モックに編集画面は無いので、既存の部品の寸法に合わせて組み立てている。
    -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="5" Padding="9,0"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 複数行のメモ。高さだけ変えて、枠は入力欄と同じにする -->
    <Style x:Key="FieldNoteBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
        <Setter Property="Height" Value="64" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="5" Padding="9,5"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        日付欄。既定の DatePicker は枠も高さも周りと揃わないので、外側だけ差し替える。
        ポップアップの暦は既定のまま。ここを作り替えるのは別の仕事なので手を付けない。
    -->
    <!--
        日付欄の中の入力部分。
        DatePicker の中身は DatePickerTextBox という別のコントロールで、既定の
        テンプレートが白い面と黒い文字を自前で持っている。外側の色を変えても
        ここが残るので、テンプレートごと差し替える。
    -->
    <Style x:Key="FieldDatePickerTextBoxStyle" TargetType="primitives:DatePickerTextBox">
        <!--
            年・月・日を区切りで扱う。押したところがまるごと選ばれるので、そのまま
            打てば置き換わる。上下キーで増減、左右キーで隣の区切りへ
        -->
        <Setter Property="views:DateSegments.Enabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:DatePickerTextBox">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 無効時。FieldTextBoxStyle と同じく文字を補助色へ落とす（面は外側の FieldDatePickerStyle が持つ） -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <!-- 中の入力部分にも当てる。型で指すので、この欄の中だけに効く -->
        <Style.Resources>
            <Style TargetType="primitives:DatePickerTextBox"
                   BasedOn="{StaticResource FieldDatePickerTextBoxStyle}" />
        </Style.Resources>

        <!--
            無効時。FieldTextBoxStyle の無効表示に揃える（背景を沈め、枠と文字を補助色にし、
            カーソルを既定へ戻す）。通知・期限の付随欄が「押せるのに開かない」ように見える問題への対応
        -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 一覧に出す行 -->
    <Style x:Key="FieldComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 開閉ボタンの山形。既定のものは周りと太さが揃わない -->
    <Style x:Key="ComboToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path Data="M6 9l6 6 6-6" Stretch="Uniform" Width="11" Height="11"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource Ink3Brush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        選ぶだけの欄（カレンダー・タスクリスト・繰り返し）。
        既定のテンプレートは枠も高さも周りと揃わないので差し替える。
    -->
    <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="5"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}" />

                        <ToggleButton HorizontalAlignment="Stretch" Width="Auto" Background="Transparent"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <DockPanel Margin="9,0,4,0" IsHitTestVisible="False">
                            <Path DockPanel.Dock="Right" Data="M6 9l6 6 6-6" Stretch="Uniform"
                                  Width="11" Height="11" Margin="4,0,0,0"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource Ink3Brush}" VerticalAlignment="Center" />
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" />
                        </DockPanel>

                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" Margin="6,2,6,6">
                                <Border CornerRadius="8" Background="{DynamicResource PanelBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.25"
                                                          Direction="270" Color="#000000" />
                                    </Border.Effect>
                                </Border>
                                <Border MaxHeight="240"
                                        CornerRadius="8" Background="{DynamicResource PanelBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!--
                            無効時。FieldTextBoxStyle の無効表示に揃える。
                            期限を付けない・通知OFFのときの選択欄が押せるように見えてしまう問題への対応
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        打っても選んでもよい欄（時刻）。
        打ち込みは「9」「930」「9:30」のどれでも読むので、候補は目安として出すだけ。
    -->
    <Style x:Key="TimeComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="IsEditable" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Root" Grid.ColumnSpan="2" CornerRadius="5"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}" />

                        <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                 Margin="9,0,0,0" Padding="0"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource InkBrush}"
                                 CaretBrush="{DynamicResource InkBrush}"
                                 Typography.NumeralAlignment="Tabular" />

                        <ToggleButton Grid.Column="1" Style="{StaticResource ComboToggleStyle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />

                        <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" Margin="6,2,6,6">
                                <Border CornerRadius="8" Background="{DynamicResource PanelBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.25"
                                                          Direction="270" Color="#000000" />
                                    </Border.Effect>
                                </Border>
                                <Border MaxHeight="240"
                                        CornerRadius="8" Background="{DynamicResource PanelBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 期限の早入れ（今日・明日・来週）。小さめの枠線ボタン -->
    <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- 保存ボタン。押すべき先がひとつだと分かるようアクセントで塗る -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="5" Background="{DynamicResource AccentBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <!-- 押した手応え（項目8） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LineStrongBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 行に重ねる削除ボタン。並んでいるときは出さず、指した行にだけ出す -->
    <Style x:Key="RowDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTip" Value="削除" />
    </Style>

    <!--
        右上の同期表示。押すと同期する。
        ボタンらしく見せすぎると、ツールバーの中で目立ちすぎる。枠は乗せたときだけ出す。
    -->
    <Style x:Key="SyncStatusButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="5" Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- 繋いでいないときは押せない。押せないことを薄さで示す -->
                            <Setter Property="Opacity" Value="0.75" />
                            <Setter TargetName="Root" Property="Background" Value="Transparent" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ペインの境目（.splitter）。
        つまんで幅を変えられることが分かるよう、線の上に乗せて左右の矢印を出す。
        当たりは 6px。見えている線は 1px のままで、残りは透明な余白
    -->
    <Style x:Key="PaneSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Width" Value="6" />
        <!-- 向きは既定だと見た目から推し量られる。左右に動くことを明示しておく -->
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <Rectangle x:Name="Line" Width="1" Fill="{DynamicResource LineBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Width" Value="2" />
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Width" Value="2" />
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        右クリックメニューとツールチップ。
        暗黙スタイル（x:Key 無し）にする。ScrollBar・CheckBox（ふつうのチェックボックス）と
        同じ書き方で、アプリ全体の ContextMenu / MenuItem / Separator / ToolTip に効く。
        月ビューのチップ・左パネルの行・⚙ボタン・▥ボタンのメニューは自前で ContextMenu を
        組んでおり、ここに書かなければ Windows 既定の明色（白地）のまま出てしまう。

        ポップアップ（ComboBox・DatePicker系）と枠・背景の書きぶりを揃えている
        （BorderThickness 1 / LineStrongBrush / PanelBrush）。角丸はポップアップは 8、
        コントロール（ボタン・入力欄）は 5 のまま（項目7）。

        影は Windows 11 のフライアウトに揃えて柔らかく落とす。文字を載せる Border に
        直接 Effect を掛けると文字が滲む（docs/README.md）ため、後ろに影だけを持つ
        Border、前に中身を載せる Effect 無しの Border を Grid で重ねてある。
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!--
                        ContextMenu 自身の開閉・位置決めはフレームワークが Popup を
                        使ってやってくれる。ここに書くのは中身（枠と背景と影）だけでよい
                    -->
                    <Grid Margin="6">
                        <Border CornerRadius="8" Background="{DynamicResource PanelBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.25"
                                                  Direction="270" Color="#000000" />
                            </Border.Effect>
                        </Border>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- メニューの区切り線 -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource LineBrush}" />
        <Setter Property="Margin" Value="4,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        メニューの1行。
        ContextMenu からしか使わないので、Menu バーに出るときだけの見た目
        （TopLevelHeader のアイコン無し表示など）は考えない。IsCheckable の
        チェック印・サブメニュー（「詳細」のような入れ子）・無効表示の3つは扱う。

        サブメニューの開閉先は既定の名前どおり x:Name="PART_Popup" にしておく。
        MenuItem 自身がコードでこの名前を探して開閉・位置合わせに使うため、
        名前を変えると入れ子のメニューが正しく振る舞わない
    -->
    <Style TargetType="MenuItem">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="4,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>

                            <!-- チェック印。IsCheckable のときだけ出す -->
                            <Path x:Name="Check" Grid.Column="0" Data="{StaticResource IconCheck}"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                               RecognizesAccessKey="True"
                                               VerticalAlignment="Center" Margin="6,4,10,4" />

                            <!-- ショートカットキーの文字（Ctrl+Z など）。今のところ使っていないが受け皿は置く -->
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource Ink3Brush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />

                            <!-- サブメニューがあることを示す山形。「詳細」のような入れ子だけに出す -->
                            <Path x:Name="Arrow" Grid.Column="3" Data="{StaticResource IconChevronRight}"
                                  Width="9" Height="9" Stretch="Uniform"
                                  Stroke="{DynamicResource Ink3Brush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <Popup x:Name="PART_Popup" Placement="Right" Focusable="False"
                                   AllowsTransparency="True"
                                   HorizontalOffset="2" VerticalOffset="-6"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Grid Margin="6">
                                    <Border CornerRadius="8" Background="{DynamicResource PanelBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.25"
                                                              Direction="270" Color="#000000" />
                                        </Border.Effect>
                                    </Border>
                                    <Border CornerRadius="8" Padding="4"
                                            Background="{DynamicResource PanelBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                                        <StackPanel IsItemsHost="True" />
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- IsCheckable の後に置き、チェックが外れているときはこちらを勝たせる -->
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- 子を持つ行（TopLevelHeader・SubmenuHeader どちらも HasItems は True） -->
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ツールチップ。
        ポップアップ系（ComboBox・DatePicker）と同じ角丸・枠・背景に揃える。
        既定テンプレートに PART_ 付きの必須要素は無いので、ここは安全に差し替えられる
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,5" />
        <!--
            HasDropShadow は Windows のクラシックな落ち方（右下にずれた濃い影）で
            他のポップアップと揃わないため使わない。ContextMenu・ComboBox 系と同じ
            柔らかい影を DropShadowEffect で自前に描く（項目7）
        -->
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Margin="6">
                        <Border CornerRadius="8" Background="{DynamicResource PanelBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.25"
                                                  Direction="270" Color="#000000" />
                            </Border.Effect>
                        </Border>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
