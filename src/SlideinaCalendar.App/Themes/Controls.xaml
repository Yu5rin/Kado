<!--
    コントロールの見た目。寸法は mock-window.html の CSS から取る。

      .ib       28x28 / radius 5 / hover で面を沈める
      .gbtn     h28 / padding 0 11 / 枠 1px
      .seg      外枠 1px / radius 5 / ボタン h28 padding 0 13 / 選択中はアクセントで塗る
      .wdchip   面 ai-soft / radius 5 / padding 3 10 / 数字は 14px でアクセント色
      .search   h28 / 枠 1px / radius 5 / 幅 190
      .add      枠 1px / radius 5 / padding 6
      .calcbtn  幅いっぱい / 枠 1px / radius 5 / padding 6
      .box      15x15 / 枠 1.5px / radius 3.5
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters">

    <!--
        アイコンはここでも読み込む。別の辞書に置いた StaticResource は、
        親をたどれる保証が無い。Theme.xaml 側の読み込みと重なるが害はない。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:HexBrushConverter x:Key="HexBrush" />

    <!-- アイコンボタン -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 枠線だけのボタン（今日・実働日計算・＋予定） -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5"
                            BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ビュー切替のセグメント。
        RadioButton の既定テンプレートだと丸印が出てしまうので、丸ごと差し替える。
        選択中はアクセントで塗り、区切り線は右側に引く（最後だけ BorderThickness=0）。
    -->
    <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="MainView" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="{DynamicResource PanelBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{DynamicResource LineStrongBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- タスクのチェックボックス -->
    <Style x:Key="TaskCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="15" Height="15" CornerRadius="3.5"
                            Background="{DynamicResource PanelBrush}"
                            BorderThickness="1.5" BorderBrush="{DynamicResource LineStrongBrush}">
                        <Path x:Name="Mark" Data="{StaticResource IconCheck}"
                              Stroke="White" StrokeThickness="2.6" Visibility="Collapsed"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="9" Height="9" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DoneBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DoneBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 検索ボックス -->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="Width" Value="190" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="5" Background="{DynamicResource BackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}"
                            Padding="9,0">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="{StaticResource IconSearch}"
                                  Stroke="{DynamicResource Ink3Brush}" StrokeThickness="1.7"
                                  Stretch="Uniform" Width="14" Height="14"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Grid>
                                <!-- 空のときだけ出す。既定は隠しておき、トリガで出す -->
                                <TextBlock x:Name="Placeholder" Text="予定とタスクを検索"
                                           Foreground="{DynamicResource Ink3Brush}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ミニ月暦の1マス（.mg b）。
        10.5px / padding 2.5px 0 / radius 3。今日はアクセントで塗り、選択日は内枠で囲う。
    -->
    <Style x:Key="MiniDayStyle" TargetType="Button">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="3" Background="Transparent"
                            BorderThickness="0" BorderBrush="{DynamicResource AccentBrush}"
                            Padding="0,2.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SunkenBrush}" />
                        </Trigger>

                        <!-- 前後の月。薄くするだけで押せるようにはしておく -->
                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsSundayLike}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SundayBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SaturdayBrush}" />
                        </DataTrigger>

                        <!-- 選択日は内枠。今日より先に置いて、今日の塗りに負けるようにする -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.5" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ミニ月暦の前月・次月（.mini-hd .ib）。20x20 とツールバーより一回り小さい -->
    <Style x:Key="SmallIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <!--
        カレンダー／タスクリストの1行（.ck）。
        チェックを外すと色見本が枠だけになり、文字が沈む。四角いチェックボックスを置くより、
        色見本そのものが状態を示すほうが行が短く済む。
    -->
    <Style x:Key="SourceListRowStyle" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="0,3.5">
                        <DockPanel>
                            <Border x:Name="Swatch" DockPanel.Dock="Left"
                                    Width="11" Height="11" CornerRadius="3" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding SwatchColor, Converter={StaticResource HexBrush}}"
                                    BorderThickness="0" BorderBrush="{DynamicResource LineStrongBrush}" />

                            <TextBlock DockPanel.Dock="Right" Text="⋮⋮" FontSize="11"
                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{DynamicResource LineStrongBrush}" />

                            <TextBlock x:Name="Label" Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Swatch" Property="Background" Value="Transparent" />
                            <Setter TargetName="Swatch" Property="BorderThickness" Value="1.5" />
                            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 右ペイン下の「＋予定」「＋タスク」（.add）。横に伸びて2つで並ぶ -->
    <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- 左パネル下の「実働日計算を開く」（.calcbtn）。幅いっぱい -->
    <Style x:Key="CalcButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
