<!--
    ウィンドウモード（要件書 5.2）。構造も寸法も mock-window.html に合わせてある。

      .tbar   padding 9 12 / 下に 1px / 月 19px（年は 14px）/ seg / wdchip / 検索 / 同期 / 設定
      .side   216px / ミニ月暦・カレンダー一覧・タスクリスト・実働日計算
      .main   曜日ヘッダ＋グリッド＋凡例バー
      .detail 296px / 日付ヘッダ・予定・タスク・追加ボタン

    ビュー切替は月・週・日・年・一覧の5つ。半期は設けない（要件書 5.1）。
    5.2 の図には「半期」が残っているが、廃止前の名残。
    月以外はまだ中身が無いので、モックの無効表示（.seg button[disabled]）で出す。
-->
<Window x:Class="SlideinaCalendar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SlideinaCalendar.App.Views"
        xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
        Title="SlideinaCalendar" Height="760" Width="1180" MinWidth="880" MinHeight="520"
        Icon="/Assets/app.png"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource InkBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:MilestoneBrushConverter x:Key="MilestoneBrush" />
        <conv:DueEmphasisBrushConverter x:Key="DueEmphasisBrush" />
        <conv:EventColorBrushConverter x:Key="EventColorBrush" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:SyncStateBrushConverter x:Key="SyncStateBrush" />

        <!--
            カレンダー／タスクリストの行を右クリックしたときのメニュー。
            ContextMenu は画面の木から外れて出るので、祖先をたどっても Window に届かない。
            行の Tag に MainViewModel を入れておき、PlacementTarget 経由で引く。
        -->
        <ContextMenu x:Key="SourceRowMenu">
            <MenuItem Header="新しい予定の入れ先にする"
                      Command="{Binding PlacementTarget.Tag.SetDefaultCalendarCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="名前と色を変える"
                      Command="{Binding PlacementTarget.Tag.EditSourceCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <!--
                Google のものには削除を出さない。手元から消しても次の同期で戻ってくるうえ、
                中の予定は別のカレンダーへ移ったまま取り残される。見せない相手には
                チェックを外してもらう
            -->
            <Separator Visibility="{Binding PlacementTarget.DataContext.IsGoogle,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu},
                                    Converter={StaticResource InverseBoolToVisibility}}" />
            <MenuItem Header="削除"
                      Visibility="{Binding PlacementTarget.DataContext.IsGoogle,
                                   RelativeSource={RelativeSource AncestorType=ContextMenu},
                                   Converter={StaticResource InverseBoolToVisibility}}"
                      Command="{Binding PlacementTarget.Tag.DeleteSourceCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!--
            カレンダー／タスクリストの1行。「このアプリ」と「Google」で2つずつ
            並べるので、テンプレートはここに出して使い回す。
            色を選べるのはカレンダーだけなので、言い添える文だけ分けてある。
        -->
        <DataTemplate x:Key="CalendarRowTemplate">
            <ToggleButton Style="{StaticResource SourceListRowStyle}"
                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="OnSourceRowPressed"
                          PreviewMouseMove="OnSourceRowMoved"
                          DragOver="OnSourceRowDragOver"
                          DragLeave="OnSourceRowDragLeave"
                          Drop="OnSourceRowDropped"
                          ToolTip="右クリックで名前と色を変えられます"
                          Tag="{Binding DataContext,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                          ContextMenu="{StaticResource SourceRowMenu}" />
        </DataTemplate>

        <DataTemplate x:Key="TaskListRowTemplate">
            <ToggleButton Style="{StaticResource SourceListRowStyle}"
                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="OnSourceRowPressed"
                          PreviewMouseMove="OnSourceRowMoved"
                          DragOver="OnSourceRowDragOver"
                          DragLeave="OnSourceRowDragLeave"
                          Drop="OnSourceRowDropped"
                          ToolTip="右クリックで名前を変えられます"
                          Tag="{Binding DataContext,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                          ContextMenu="{StaticResource SourceRowMenu}" />
        </DataTemplate>

        <!-- 「このアプリ」「Google」の小見出し（.subsec） -->
        <Style x:Key="SourceGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
        </Style>


        <!--
            日付の行のラベルの右クリックメニュー。
            ContextMenu は画面の木から外れて出るので、Tag に MainViewModel を入れて
            PlacementTarget 経由で引く。
        -->
        <ContextMenu x:Key="MilestoneMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditMilestoneCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="削除"
                      Command="{Binding PlacementTarget.Tag.DeleteMilestoneCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- マイルストーンのラベル（.ms）。右ペインの見出しと日付ヘッダで使い回す -->
        <DataTemplate x:Key="MilestoneBadgeTemplate">
            <Border CornerRadius="3" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                    Background="{Binding Name, Converter={StaticResource MilestoneBrush}, ConverterParameter=Face}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource MilestoneMenu}"
                    MouseLeftButtonDown="OnMilestoneClicked"
                    Cursor="Hand" ToolTip="ダブルクリックで編集 ・ 右クリックでメニュー">
                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" LineHeight="15"
                           Foreground="{Binding Name, Converter={StaticResource MilestoneBrush}}" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 元に戻す・やり直しはツールバーに出さない。モックに無く、キーで足りる -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F5" Command="{Binding Sync.SyncNowCommand}" />
    </Window.InputBindings>

    <Grid PreviewMouseWheel="OnZoomWheel">
    <DockPanel>
        <!-- ツールバー（.tbar） -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <!--
                左（年月・送り・ビュー切り替え・実働日）と右（検索・同期・ピン・設定）を
                別の列に分ける。

                ひとつの DockPanel に混ぜていたら、窓が狭いときに左の中身が右へ
                はみ出して、ピンや設定の上に重なった。右側が押せないと、画面端に
                留めたあと戻す口が無くなる。列を分ければ、右は必ず場所を確保できる。
            -->
            <Grid Margin="12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" LastChildFill="False" ClipToBounds="True">

                <Button DockPanel.Dock="Left" Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ToggleSidePanelCommand}" ToolTip="サイドパネルの表示切替">
                    <Path Data="{StaticResource IconMenu}" Stretch="Uniform" Width="16" Height="16"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>

                <!-- 年は一段小さく薄く。月のほうを大きく出して視線を集める -->
                <TextBlock DockPanel.Dock="Left" MinWidth="118" Margin="8,0,0,0"
                           VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular">
                    <Run Text="{Binding TitleYear, Mode=OneWay}" FontSize="14" FontWeight="Medium"
                         Foreground="{DynamicResource Ink3Brush}" /><Run Text=" " /><Run
                         Text="{Binding TitleMonth, Mode=OneWay}" />
                </TextBlock>

                <Button DockPanel.Dock="Left" Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0"
                        Visibility="{Binding ShowsCalendarTools, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding PreviousCommand}" ToolTip="前の月">
                    <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform" Width="16" Height="16"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButtonStyle}"
                        Command="{Binding NextCommand}" ToolTip="次の月">
                    <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform" Width="16" Height="16"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>

                <Button DockPanel.Dock="Left" Content="今日" Margin="8,0,0,0"
                        Visibility="{Binding ShowsCalendarTools, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource GhostButtonStyle}" Command="{Binding TodayCommand}" />

                <!-- ビュー切替（.seg）。区切り線は右側、最後だけ引かない -->
                <Border DockPanel.Dock="Left" Margin="10,0,0,0" CornerRadius="5" ClipToBounds="True"
                        Visibility="{Binding ShowsCalendarTools, Converter={StaticResource BoolToVisibility}}"
                        BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                    <!--
                        粗いほうから細かいほうへ並べる。Ctrl＋ホイールはこの並びを
                        1つずつ動くので、ボタンの並びと動く向きが合っていないと迷う
                    -->
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="一覧" Style="{StaticResource SegmentButtonStyle}"
                                     ToolTip="予定とタスクを時系列で。予定のない日はまとめます"
                                     IsChecked="{Binding CurrentView, Mode=OneWay,
                                                 Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Agenda}"
                                     Command="{Binding SwitchViewCommand}"
                                     CommandParameter="Agenda" />
                        <ToggleButton Content="年" Style="{StaticResource SegmentButtonStyle}"
                                     ToolTip="年度（4月〜翌3月）。ホイールで年度を送ります"
                                     IsChecked="{Binding CurrentView, Mode=OneWay,
                                                 Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Year}"
                                     Command="{Binding SwitchViewCommand}"
                                     CommandParameter="Year" />
                        <ToggleButton Content="月" Style="{StaticResource SegmentButtonStyle}"
                                     IsChecked="{Binding CurrentView, Mode=OneWay,
                                                 Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Month}"
                                     Command="{Binding SwitchViewCommand}"
                                     CommandParameter="Month" />
                        <ToggleButton Content="週" Style="{StaticResource SegmentButtonStyle}"
                                     IsChecked="{Binding CurrentView, Mode=OneWay,
                                                 Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Week}"
                                     Command="{Binding SwitchViewCommand}"
                                     CommandParameter="Week" />
                        <ToggleButton Content="日" Style="{StaticResource SegmentButtonStyle}"
                                     BorderThickness="0"
                                     IsChecked="{Binding CurrentView, Mode=OneWay,
                                                 Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Day}"
                                     Command="{Binding SwitchViewCommand}"
                                     CommandParameter="Day" />
                    </StackPanel>
                </Border>

                <!--
                    実働日バッジ（.wdchip）。左パネルを閉じても実働日が読めるようにここに置く。

                -->
                <Border DockPanel.Dock="Left" Margin="12,0,0,0" CornerRadius="5" Padding="10,3"
                        VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding HasWorkingDayData, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource Ink2Brush}"
                               Typography.NumeralAlignment="Tabular">
                        <Run Text="実働 " /><Run Text="{Binding WorkingDayCountText, Mode=OneWay}"
                              FontSize="14" FontWeight="SemiBold"
                              Foreground="{DynamicResource AccentBrush}" /><Run Text=" 日" />
                    </TextBlock>
                </Border>
                <Border DockPanel.Dock="Left" Margin="6,0,0,0" CornerRadius="5" Padding="10,3"
                        VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding HasRemainingWorkingDays, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource Ink2Brush}"
                               Typography.NumeralAlignment="Tabular">
                        <Run Text="残り " /><Run Text="{Binding RemainingWorkingDaysText, Mode=OneWay}"
                              FontSize="14" FontWeight="SemiBold"
                              Foreground="{DynamicResource AccentBrush}" /><Run Text=" 日" />
                    </TextBlock>
                </Border>
                <TextBlock DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="実働日データ未登録" FontSize="11.5"
                           Foreground="{DynamicResource Ink3Brush}"
                           Visibility="{Binding HasWorkingDayData, Converter={StaticResource InverseBoolToVisibility}}" />

                </DockPanel>

                <!-- 右端。設定・ピン・同期・検索の順に並べる（右から左へ積む） -->
                <DockPanel Grid.Column="1" LastChildFill="False">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}"
                        ToolTip="取り込みと設定" Click="OnSettingsClicked">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="実働日ファイルを取り込む…（Excel）"
                                      Command="{Binding ImportWorkingDaysCommand}" />
                            <MenuItem Header="旧 inaCalendar のバックアップを取り込む…（JSON）"
                                      Command="{Binding ImportLegacyBackupCommand}" />
                            <MenuItem Header="配信元から実働日を取り込む"
                                      Command="{Binding FetchWorkingDayFeedCommand}"
                                      ToolTip="設定で決めた配信元（feed.json）から取りに行きます" />
                            <MenuItem Header="実働日を配信用に書き出す…（feed.json）"
                                      Command="{Binding ExportWorkingDayFeedCommand}"
                                      ToolTip="いまの実働日データを、配る側のファイルとして書き出します" />
                            <Separator />
                            <MenuItem Header="Google に接続…"
                                      Command="{Binding Sync.ConnectCommand}"
                                      ToolTip="ブラウザが開きます。許可するとカレンダーとタスクの同期が始まります" />
                            <MenuItem Header="今すぐ同期"
                                      Command="{Binding Sync.SyncNowCommand}"
                                      InputGestureText="F5" />
                            <MenuItem Header="Google との接続を切る"
                                      Command="{Binding Sync.DisconnectCommand}"
                                      ToolTip="こちらのデータは消えません。Google 側の許可を取り消します" />

                            <Separator />
                            <MenuItem Header="重複した予定を整理…"
                                      Command="{Binding RemoveDuplicatesCommand}"
                                      ToolTip="同じ日・同じ時刻・同じ名前の予定を1つにまとめます" />

                            <Separator />
                            <MenuItem Header="バックアップを保存…"
                                      Command="{Binding BackupCommand}"
                                      ToolTip="予定・タスク・設定・実働日データを1つのファイルに書き出します" />
                            <MenuItem Header="バックアップから復元…"
                                      Command="{Binding RestoreCommand}"
                                      ToolTip="いまの内容はすべて置き換わります。復元後にアプリを立ち上げ直します" />

                            <Separator />
                            <MenuItem Header="更新を確認…"
                                      Command="{Binding CheckForUpdateCommand}"
                                      ToolTip="新しい版があれば知らせます" />

                            <!--
                                自分の Google Cloud プロジェクトで使いたい人だけの項目。
                                ふつうは触らせない。アプリに焼き込んだ設定で繋がる
                            -->
                            <Separator />
                            <MenuItem Header="詳細">
                                <MenuItem Header="自分のクライアント設定を使う…（JSON）"
                                          Command="{Binding ImportGoogleClientCommand}"
                                          ToolTip="自分の Google Cloud プロジェクトで使いたいときだけ。ふつうは要りません" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="ショートカット…" Command="{Binding ShowShortcutsCommand}" />
                            <MenuItem Header="設定…" Command="{Binding OpenSettingsCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Data="{StaticResource IconSettings}" Stretch="Uniform" Width="16" Height="16"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>

                <!--
                    出しかたと、出すパネルの選び方。
                    ドック中は枠が消えるので、ここが唯一の戻り口になる
                -->
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}"
                        Margin="0,0,2,0" ToolTip="{Binding Shell.ModeLabel}"
                        Click="OnLayoutMenuClicked">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="ウィンドウ" Command="{Binding Shell.ToWindowCommand}"
                                      IsChecked="{Binding Shell.IsWindowMode, Mode=OneWay}"
                                      IsCheckable="True" />
                            <Separator />
                            <MenuItem Header="スライド（左端から出す）"
                                      Command="{Binding Shell.SlideLeftCommand}"
                                      ToolTip="普段は隠れていて、画面の左端にマウスを留めると出てきます" />
                            <MenuItem Header="スライド（右端から出す）"
                                      Command="{Binding Shell.SlideRightCommand}"
                                      ToolTip="普段は隠れていて、画面の右端にマウスを留めると出てきます" />
                            <Separator />
                            <MenuItem Header="出したまま固定する（画面を分割）"
                                      Command="{Binding Shell.TogglePinCommand}"
                                      IsChecked="{Binding Shell.IsPinned, Mode=OneWay}"
                                      IsCheckable="True"
                                      InputGestureText="Ctrl+Alt+P" />
                            <Separator />
                            <MenuItem Header="左パネル（ミニ月暦・カレンダー一覧）"
                                      Command="{Binding ToggleSidePanelCommand}"
                                      IsChecked="{Binding IsSidePanelOpen, Mode=OneWay}"
                                      IsCheckable="True" />
                            <MenuItem Header="中央（カレンダー）"
                                      Command="{Binding ToggleMainViewCommand}"
                                      IsChecked="{Binding IsMainViewOpen, Mode=OneWay}"
                                      IsCheckable="True" />
                            <MenuItem Header="右パネル（予定・タスク）"
                                      Command="{Binding ToggleDetailPaneCommand}"
                                      IsChecked="{Binding IsDetailPaneOpen, Mode=OneWay}"
                                      IsCheckable="True" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Data="{StaticResource IconPanes}" Stretch="Uniform" Width="16" Height="16"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>

                <!--
                    ピン。押すと画面端に寄り、画面を分割する。最大化した他のウィンドウと
                    重ならなくなる（要件書 2.2）。もう一度押すと元の出しかたに戻る。

                    常に出しておく。端へドラッグしてから押す作りにしていたが、Windows の
                    スナップ（端に寄せると画面の半分に広がる）と取り合いになって、
                    寄せてもピンが出ないことがあった。

                    ⚙ の左に置く。ドック中は枠が消えるので、ここが唯一の戻り口になる
                -->
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource IconToggleButtonStyle}"
                              x:Name="PinButton" Margin="0,0,2,0"
                              IsChecked="{Binding Shell.IsPinned, Mode=OneWay}"
                              Command="{Binding Shell.TogglePinCommand}"
                              ToolTip="{Binding Shell.PinLabel}">
                    <Path Data="{StaticResource IconPin}" Stretch="Uniform" Width="16" Height="16"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </ToggleButton>

                <!--
                    押すと同期する。繋いでいなければ押せない（⚙から接続する）。
                    丸印の色で状態を出す。文字は状態だけを出し、操作の結果は混ぜない
                -->
                <Button DockPanel.Dock="Right" Margin="0,0,8,0" Padding="6,2"
                        Style="{StaticResource SyncStatusButtonStyle}"
                        Command="{Binding Sync.SyncNowCommand}"
                        ToolTip="押すと今すぐ同期します">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                 Fill="{Binding Sync.State, Converter={StaticResource SyncStateBrush}}" />
                        <TextBlock Text="{Binding SyncStatusText}" FontSize="11.5"
                                   Foreground="{DynamicResource Ink3Brush}" />
                    </StackPanel>
                </Button>

                <!--
                    検索。打つたびに探し、下に結果を垂らす。
                    Popup にすると本体の配置を動かさずに重ねられる
                -->
                <Grid DockPanel.Dock="Right" Margin="0,0,8,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchKeyDown" />

                    <Popup IsOpen="{Binding IsSearching, Mode=OneWay}" PlacementTarget="{Binding ElementName=SearchBox}"
                           Placement="Bottom" AllowsTransparency="True" StaysOpen="True"
                           HorizontalOffset="0" VerticalOffset="3">
                        <Border MinWidth="320" MaxWidth="440" MaxHeight="420" CornerRadius="6"
                                Background="{DynamicResource PanelBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding SearchMessage}"
                                           Margin="12,10" FontSize="12"
                                           Foreground="{DynamicResource Ink3Brush}"
                                           Visibility="{Binding SearchMessage,
                                                        Converter={StaticResource NullToVisibility}}" />

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" Padding="12,7" Cursor="Hand"
                                                        Background="Transparent"
                                                        MouseLeftButtonDown="OnSearchResultClicked">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DateText}"
                                                                   FontSize="10.5" Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   Foreground="{DynamicResource Ink3Brush}" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource InkBrush}" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource Ink3Brush}"
                                                                       Visibility="{Binding Detail,
                                                                                    Converter={StaticResource NullToVisibility}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>

                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background"
                                                                Value="{DynamicResource SunkenBrush}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
                </DockPanel>
            </Grid>
        </Border>

        <!--
            狭いときは1列の形（サイドバー）に切り替える。同じ UI を縮小して
            使い回さない（要件書 5.1）
        -->
        <views:SidebarLayout x:Name="Sidebar"
                             Visibility="{Binding Shell.UsesSidebarLayout,
                                          Converter={StaticResource BoolToVisibility}}" />

        <!-- 3ペイン（.body） -->
        <Grid x:Name="WindowLayout"
              Visibility="{Binding Shell.UsesWindowLayout, Converter={StaticResource BoolToVisibility}}">
            <!--
                両端は手で決めた幅のまま置き、ウィンドウを広げたぶんは中央が受け取る。
                幅は境目をつまんで変えられる。実際の値はコードビハインドが入れる
                （左パネルを閉じているあいだは 0 にするため）。
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="216" MinWidth="160" MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DetailColumn" Width="296" MinWidth="200" MaxWidth="640" />
            </Grid.ColumnDefinitions>

            <!-- 左パネル（.side 216px） -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource LineBrush}"
                    Visibility="{Binding IsSidePanelOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <!-- 実働日計算（.wdbox）。パネルの下端に貼り付ける -->
                    <Border DockPanel.Dock="Bottom" Padding="12,10">
                        <Button Content="実働日計算を開く" Style="{StaticResource CalcButtonStyle}"
                                Command="{Binding OpenWorkingDayCalculatorCommand}" />
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- ミニ月暦（.mini）。中央とは別に月を送れる -->
                            <Border Padding="12,10,12,12"
                                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}"
                                    DataContext="{Binding MiniCalendar}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                Command="{Binding DataContext.MiniNextCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="次の月">
                                            <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform"
                                                  Width="12" Height="12" StrokeThickness="1.7"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                Command="{Binding DataContext.MiniPreviousCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="前の月">
                                            <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform"
                                                  Width="12" Height="12" StrokeThickness="1.7"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding WeekDayHeaders}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" Columns="7" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="9.5"
                                                           HorizontalAlignment="Center" Margin="0,0,0,2"
                                                           Foreground="{DynamicResource Ink3Brush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Days}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MiniDayStyle}"
                                                        Content="{Binding DayNumber}"
                                                        Command="{Binding DataContext.SelectDateCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Date}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- カレンダー一覧（.sec） -->
                            <Border Padding="12,10"
                                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}"
                                    Visibility="{Binding SourceLists.Calendars, Converter={StaticResource NullToVisibility}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,7">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                Command="{Binding AddCalendarCommand}"
                                                ToolTip="カレンダーを追加">
                                            <Path Data="{StaticResource IconPlus}" Stretch="Uniform"
                                                  Width="11" Height="11"
                                                  Stroke="{Binding Foreground,
                                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <TextBlock Text="カレンダー" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Ink3Brush}" />
                                    </DockPanel>
                                    <!--
                                        このアプリのものと Google のものを分けて並べる。
                                        混ざっていると、消してよいのはどれか、名前を変えたら
                                        相手にも伝わるのはどれかが読めない。
                                        繋いでいないうちは見出しを出さず、今までどおり1列で出す
                                    -->
                                    <TextBlock Text="このアプリ"
                                               Style="{StaticResource SourceGroupHeaderStyle}"
                                               Visibility="{Binding SourceLists.ShowsCalendarGroups,
                                                            Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding SourceLists.LocalCalendars}"
                                                  ItemTemplate="{StaticResource CalendarRowTemplate}" />

                                    <TextBlock Text="Google カレンダー" Margin="0,9,0,3"
                                               Style="{StaticResource SourceGroupHeaderStyle}"
                                               Visibility="{Binding SourceLists.ShowsCalendarGroups,
                                                            Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding SourceLists.GoogleCalendars}"
                                                  ItemTemplate="{StaticResource CalendarRowTemplate}" />
                                </StackPanel>
                            </Border>

                            <!-- タスクリスト（.sec） -->
                            <Border Padding="12,10"
                                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}"
                                    Visibility="{Binding SourceLists.TaskLists, Converter={StaticResource NullToVisibility}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,7">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                Command="{Binding AddTaskListCommand}"
                                                ToolTip="タスクリストを追加">
                                            <Path Data="{StaticResource IconPlus}" Stretch="Uniform"
                                                  Width="11" Height="11"
                                                  Stroke="{Binding Foreground,
                                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <TextBlock Text="タスクリスト" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Ink3Brush}" />
                                    </DockPanel>
                                    <TextBlock Text="このアプリ"
                                               Style="{StaticResource SourceGroupHeaderStyle}"
                                               Visibility="{Binding SourceLists.ShowsTaskListGroups,
                                                            Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding SourceLists.LocalTaskLists}"
                                                  ItemTemplate="{StaticResource TaskListRowTemplate}" />

                                    <TextBlock Text="Google ToDo" Margin="0,9,0,3"
                                               Style="{StaticResource SourceGroupHeaderStyle}"
                                               Visibility="{Binding SourceLists.ShowsTaskListGroups,
                                                            Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding SourceLists.GoogleTaskLists}"
                                                  ItemTemplate="{StaticResource TaskListRowTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 左パネルと中央の境目。閉じているあいだは出さない -->
            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitterStyle}"
                          Visibility="{Binding IsSidePanelOpen, Converter={StaticResource BoolToVisibility}}" />

            <!-- 中央（.main） -->
            <DockPanel Grid.Column="2" x:Name="MainPane"
                       Background="{DynamicResource BackgroundBrush}"
                       Visibility="{Binding IsMainViewOpen, Converter={StaticResource BoolToVisibility}}">
                <!-- 出しているビューだけを置く。畳んだビューは計算もしない -->
                <Grid>
                    <views:MonthView DataContext="{Binding Month}"
                                     Visibility="{Binding DataContext.IsMonthView,
                                                  RelativeSource={RelativeSource AncestorType=Window},
                                                  Converter={StaticResource BoolToVisibility}}" />
                    <views:WeekView DataContext="{Binding Week}"
                                    Visibility="{Binding DataContext.IsWeekView,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}" />
                    <views:DayView DataContext="{Binding Day}"
                                   Visibility="{Binding DataContext.IsDayView,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource BoolToVisibility}}" />
                    <views:YearView DataContext="{Binding Year}"
                                    Visibility="{Binding DataContext.IsYearView,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolToVisibility}}" />
                    <views:AgendaView DataContext="{Binding Agenda}"
                                      Visibility="{Binding DataContext.IsAgendaView,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>

            <!-- 中央と右ペインの境目 -->
            <GridSplitter Grid.Column="3" Style="{StaticResource PaneSplitterStyle}" />

            <!-- 右ペイン（.detail 296px） -->
            <Border Grid.Column="4" x:Name="DetailPane"
                    Visibility="{Binding IsDetailPaneOpen, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource PanelBrush}"
                    BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}"
                    DataContext="{Binding SelectedDay}">
                <Grid>
                    <!--
                        予定とタスクは上下に並べ、まとめてひとつのスクロールにする。
                        モックは節ごとに独立したスクロール領域だが、WPF で高さを等分すると
                        予定が少ない日に大きな空きができる。節が縦に続く見え方は変えずに、
                        内容に合わせて詰めるほうがモックの画面に近い。
                    -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 日付ヘッダ（.dhead）。実働日の通し番号を出す場所のひとつ（要件書 4.3） -->
                    <Border Grid.Row="0" Padding="14,11,14,9"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular" />
                                <ItemsControl ItemsSource="{Binding Milestones}"
                                              ItemTemplate="{StaticResource MilestoneBadgeTemplate}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <!-- 祝日名。予定ではなく日付の添え書きとして出す -->
                                <TextBlock Text="{Binding HolidayName}" FontSize="11.5" Margin="0,0,8,0"
                                           Foreground="{DynamicResource SundayBrush}"
                                           Visibility="{Binding HolidayName,
                                                       Converter={StaticResource NullToVisibility}}" />

                                <TextBlock Text="{Binding WorkingDayLabel}" FontSize="11.5"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Typography.NumeralAlignment="Tabular"
                                           Visibility="{Binding WorkingDayLabel, Converter={StaticResource NullToVisibility}}" />
                                <TextBlock Text="{Binding RemainingInMonthText}" FontSize="11.5" Margin="8,0,0,0"
                                           Foreground="{DynamicResource Ink3Brush}"
                                           Typography.NumeralAlignment="Tabular"
                                           Visibility="{Binding RemainingInMonthText, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 予定の見出し（.dsec） -->
                            <DockPanel Margin="14,9,14,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding EventCountText}" FontSize="11"
                                           Foreground="{DynamicResource Ink3Brush}"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="予定" FontSize="11" Foreground="{DynamicResource Ink3Brush}" />
                            </DockPanel>

                            <!-- 予定（.ev）。時刻38px＋帯3px＋タイトル13px＋補助行 -->
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Background="Transparent" Padding="14,6" Cursor="Hand"
                                                ToolTip="ダブルクリックで編集"
                                                MouseLeftButtonDown="OnEventRowClicked">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Width="38" Margin="0,2,9,0"
                                                           Text="{Binding TimeText}" FontSize="11"
                                                           TextAlignment="Right" VerticalAlignment="Top"
                                                           Foreground="{DynamicResource Ink2Brush}"
                                                           Typography.NumeralAlignment="Tabular" />
                                                <Border DockPanel.Dock="Left" Width="3" MinHeight="20" Margin="0,0,9,0"
                                                        CornerRadius="2"
                                                        Background="{Binding Color, Converter={StaticResource EventColorBrush}}" />

                                                <Button x:Name="Delete" DockPanel.Dock="Right" VerticalAlignment="Top"
                                                        Style="{StaticResource RowDeleteButtonStyle}"
                                                        Command="{Binding DataContext.DeleteEventCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconTrash}" Stretch="Uniform" Width="13" Height="13"
                                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" LineHeight="18"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource InkBrush}" />
                                                    <TextBlock Text="{Binding SubText}" FontSize="10.5" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource Ink3Brush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding SubText, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{DynamicResource SunkenBrush}" />
                                                <!-- 並んでいる間は出さない。行ごとにボタンが並ぶと読みにくい -->
                                                <Setter TargetName="Delete" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- タスクの見出し（.dsec）。「3 / 4」は完了した数と全体 -->
                            <DockPanel Margin="14,9,14,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TaskCountText}" FontSize="11"
                                           Foreground="{DynamicResource Ink3Brush}"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="タスク" FontSize="11" Foreground="{DynamicResource Ink3Brush}" />
                            </DockPanel>

                            <!-- タスク（.tk） -->
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Background="Transparent" Padding="14,6" Cursor="Hand"
                                                ToolTip="{Binding DueTooltip}"
                                                MouseLeftButtonDown="OnTaskRowClicked">
                                            <DockPanel>
                                                <!-- 完了の切り替えは画面を開かずにここで済ませる -->
                                                <CheckBox DockPanel.Dock="Left" Margin="0,2,9,0"
                                                          Style="{StaticResource TaskCheckBoxStyle}"
                                                          IsChecked="{Binding IsDone, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleTaskDoneCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />

                                                <Button x:Name="Delete" DockPanel.Dock="Right" VerticalAlignment="Top"
                                                        Style="{StaticResource RowDeleteButtonStyle}"
                                                        Command="{Binding DataContext.DeleteTaskCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconTrash}" Stretch="Uniform" Width="13" Height="13"
                                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>

                                                <StackPanel>
                                                    <TextBlock x:Name="TaskTitle" Text="{Binding Title}"
                                                               FontSize="13" LineHeight="18" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource InkBrush}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0"
                                                                Visibility="{Binding DueText, Converter={StaticResource NullToVisibility}}">
                                                        <TextBlock Text="{Binding DueText}" FontSize="10.5"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   Foreground="{Binding Emphasis, Converter={StaticResource DueEmphasisBrush}}" />
                                                        <TextBlock Text="{Binding DueSubText}" FontSize="10.5" Margin="7,0,0,0"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   Foreground="{DynamicResource Ink3Brush}"
                                                                   Visibility="{Binding DueSubText, Converter={StaticResource NullToVisibility}}" />
                                                    </StackPanel>

                                                    <!--
                                                        済んだタスクの結果。期限に間に合ったかどうかは
                                                        片付いたあとで振り返るときに要る
                                                    -->
                                                    <TextBlock x:Name="DoneNote" Text="{Binding DoneText}"
                                                               FontSize="10.5" Margin="0,1,0,0"
                                                               Typography.NumeralAlignment="Tabular"
                                                               Foreground="{DynamicResource Ink3Brush}"
                                                               Visibility="{Binding DoneText,
                                                                            Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- 遅れて済ませたものだけ色を変える。早い・期限どおりは静かに -->
                                            <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                <Setter TargetName="DoneNote" Property="Foreground"
                                                        Value="{DynamicResource SundayBrush}" />
                                            </DataTrigger>

                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{DynamicResource SunkenBrush}" />
                                                <Setter TargetName="Delete" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <!-- 済みは取り消し線で沈める -->
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter TargetName="TaskTitle" Property="Foreground"
                                                        Value="{DynamicResource DoneBrush}" />
                                                <Setter TargetName="TaskTitle" Property="TextDecorations"
                                                        Value="Strikethrough" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 追加（.dfoot） -->
                    <Border Grid.Row="2" Padding="12,9"
                            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
                        <StackPanel>
                            <!--
                                クイック入力。1行打って Enter で入る。
                                編集画面を開いて欄を埋めるより速い。読んだ内容は下に出す
                            -->
                            <TextBox Style="{StaticResource QuickInputBoxStyle}"
                                     Text="{Binding DataContext.QuickText,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="1行で予定を追加します（Enter）&#10;例: 明日15時 打合せ @会議室A"
                                     KeyDown="OnQuickKeyDown" />

                            <TextBlock Text="{Binding DataContext.QuickPreview,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="10.5" Margin="2,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Ink3Brush}"
                                       Visibility="{Binding DataContext.QuickPreview,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource NullToVisibility}}" />

                            <Border Height="9" />

                            <UniformGrid Rows="1" Columns="2">
                            <Button Style="{StaticResource AddButtonStyle}" Margin="0,0,3.5,0"
                                    Command="{Binding DataContext.AddEventCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Stretch="Uniform" Width="13" Height="13"
                                          Margin="0,0,6,0" StrokeThickness="1.9" StrokeStartLineCap="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="予定" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AddButtonStyle}" Margin="3.5,0,0,0"
                                    Command="{Binding DataContext.AddTaskCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Stretch="Uniform" Width="13" Height="13"
                                          Margin="0,0,6,0" StrokeThickness="1.9" StrokeStartLineCap="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="タスク" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>

        <!--
            ドック幅のグリップ（要件書 7.2）。
            端に寄せているあいだは枠を消しているので、OS の掴みしろが無い。
            画面の内側にあたる辺に、自前の掴みしろを置く。

            右に寄せていれば内側は左、左に寄せていれば内側は右。辺と逆になる。
        -->
        <Border x:Name="DockGrip" Width="5" Background="Transparent"
                HorizontalAlignment="Left" Cursor="SizeWE"
                ToolTip="ドラッグで幅を変えられます"
                MouseLeftButtonDown="OnGripPressed"
                MouseMove="OnGripDragging"
                MouseLeftButtonUp="OnGripReleased"
                Visibility="{Binding Shell.IsAtEdge, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Shell.IsAtLeft}" Value="True">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</Window>
