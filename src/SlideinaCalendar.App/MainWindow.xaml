<!--
    ウィンドウモード（要件書 5.2）。

    ┌──────────────────────────────────────────────┐
    │ ☰  2026年9月  ◀ ▶ 今日 │月 週 日 年 一覧│ 実働20/残6  ⚙ │
    ├────────┬──────────────────────┬────────────┤
    │ ミニ月暦   │                        │ 選択日ヘッダ    │
    │ タスクリスト │   本体ビュー              │ 予定           │
    │ 実働日計算  │                        │ タスク         │
    └────────┴──────────────────────┴────────────┘

    ビュー切替は月・週・日・年・一覧の5つ。半期は設けない（要件書 5.1）。
    5.2 の図には「半期」が残っているが、廃止前の名残。
-->
<Window x:Class="SlideinaCalendar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SlideinaCalendar.Presentation.ViewModels;assembly=SlideinaCalendar.Presentation"
        xmlns:views="clr-namespace:SlideinaCalendar.App.Views"
        xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
        Title="SlideinaCalendar" Height="720" Width="1180" MinWidth="880" MinHeight="520"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="12.5"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource InkBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:MilestoneBrushConverter x:Key="MilestoneBrush" />
        <conv:DueEmphasisBrushConverter x:Key="DueEmphasisBrush" />
        <conv:EventTimeConverter x:Key="EventTime" />

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ViewTabStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="View" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel Margin="8,6">
                <Button DockPanel.Dock="Left" Content="☰" Style="{StaticResource ToolButtonStyle}"
                        Command="{Binding ToggleSidePanelCommand}"
                        ToolTip="サイドパネルの表示切替" />

                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="6,0,10,0" Typography.NumeralAlignment="Tabular" />

                <Button DockPanel.Dock="Left" Content="◀" Style="{StaticResource ToolButtonStyle}"
                        Command="{Binding PreviousCommand}" ToolTip="前の月" />
                <Button DockPanel.Dock="Left" Content="▶" Style="{StaticResource ToolButtonStyle}"
                        Command="{Binding NextCommand}" ToolTip="次の月" />
                <Button DockPanel.Dock="Left" Content="今日" Style="{StaticResource ToolButtonStyle}"
                        Command="{Binding TodayCommand}" />

                <!-- ビュー切替。セグメント一本に統一する（要件書 5.2） -->
                <Border DockPanel.Dock="Left" Margin="12,0,0,0" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="月" Style="{StaticResource ViewTabStyle}" IsChecked="True" />
                        <RadioButton Content="週" Style="{StaticResource ViewTabStyle}" />
                        <RadioButton Content="日" Style="{StaticResource ViewTabStyle}" />
                        <RadioButton Content="年" Style="{StaticResource ViewTabStyle}" />
                        <RadioButton Content="一覧" Style="{StaticResource ViewTabStyle}" />
                    </StackPanel>
                </Border>

                <!-- 右寄せ。左パネルを閉じても実働日サマリーが読めるようここに置く -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="⤺" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding UndoCommand}" ToolTip="{Binding UndoLabel}" />
                    <Button Content="⤼" Style="{StaticResource ToolButtonStyle}"
                            Command="{Binding RedoCommand}" ToolTip="{Binding RedoLabel}" />
                    <Button Content="⚙" Style="{StaticResource ToolButtonStyle}" ToolTip="設定" />
                </StackPanel>

                <TextBlock Text="{Binding WorkingDaySummary}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource AccentBrush}"
                           Typography.NumeralAlignment="Tabular" />
            </DockPanel>
        </Border>

        <!-- 状態表示 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Margin="12,4"
                       Foreground="{DynamicResource Ink2Brush}" FontSize="11.5" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 左パネル。閉じると中央が広がる -->
                <ColumnDefinition x:Name="SideColumn" Width="220" MinWidth="0" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="300" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- 左：ミニ月暦・タスクリスト・実働日計算（Phase 3 では枠のみ） -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource LineBrush}"
                    Visibility="{Binding IsSidePanelOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="10">
                    <TextBlock Text="タスク" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Phase 3 の続きで実装" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

            <!-- 中央：本体ビュー -->
            <views:MonthView Grid.Column="1" DataContext="{Binding Month}" />

            <!-- 右：選択日。予定とタスクを上下に同時表示する（要件書 5.2） -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}"
                    BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}"
                    DataContext="{Binding SelectedDay}">
                <DockPanel Margin="12,10">
                    <!-- 選択日ヘッダ。ここは実働日の通し番号を出す場所（要件書 4.3） -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding WorkingDayLabel}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding WorkingDayLabel, Converter={StaticResource NullToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding Milestones}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="2" Padding="6,1" Margin="0,0,0,2"
                                            HorizontalAlignment="Left"
                                            Background="{Binding Converter={StaticResource MilestoneBrush}, ConverterParameter=Face}">
                                        <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                   Foreground="{Binding Converter={StaticResource MilestoneBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 予定 -->
                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Top" Text="予定" FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="11"
                                                       Foreground="{DynamicResource Ink2Brush}"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Text="{Binding Source.StartTime, Converter={StaticResource EventTime}}" />
                                            <Rectangle Grid.Column="1" Width="2.5" RadiusX="1" RadiusY="1"
                                                       Fill="{DynamicResource AccentBrush}" />
                                            <TextBlock Grid.Column="2" Margin="7,0,0,0"
                                                       Text="{Binding Source.Title}"
                                                       Style="{StaticResource BodyTextStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <Separator Grid.Row="1" Margin="0,6" Background="{DynamicResource LineBrush}" />

                        <!-- タスク -->
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Text="タスク" FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,5" ToolTip="{Binding DueTooltip}">
                                            <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}"
                                                      Content="{Binding Title}"
                                                      Foreground="{DynamicResource InkBrush}" />
                                            <TextBlock Text="{Binding DueText}" Margin="20,1,0,0"
                                                       FontSize="10.5"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{Binding Emphasis, Converter={StaticResource DueEmphasisBrush}}"
                                                       Visibility="{Binding DueText, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
