<!--
    月ビュー。マスの数は週の数で決まる（4〜6週）ので、行数は実行時に決める。

    実働日の通し番号はここには出さない（要件書 4.3）。マイルストーンのラベルと
    競合して密度が上がりすぎるため。出すのはツールバー・右ペイン・週ビューの
    日付ヘッダ・一覧ビューの日付列。
-->
<UserControl x:Class="SlideinaCalendar.App.Views.MonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:MilestoneBrushConverter x:Key="MilestoneBrush" />
        <conv:EventTimeConverter x:Key="EventTime" />

        <!-- 曜日の見出し -->
        <Style x:Key="WeekDayHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,4" />
        </Style>

        <!-- 予定のチップ。左の色帯で種類を示す -->
        <DataTemplate x:Key="EventChipTemplate">
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="2"
                    Margin="0,1,0,0" Padding="3,1"
                    BorderThickness="2.5,0,0,0" BorderBrush="{DynamicResource AccentBrush}">
                <TextBlock Text="{Binding Source.Title}" FontSize="10.5"
                           Foreground="{DynamicResource InkBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Source.Title}" />
            </Border>
        </DataTemplate>

        <!-- タスクは丸印を添えて予定と区別する -->
        <DataTemplate x:Key="TaskChipTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                <Ellipse Width="4" Height="4" Margin="1,0,3,0" VerticalAlignment="Center"
                         Stroke="{DynamicResource Ink3Brush}" StrokeThickness="1" />
                <TextBlock Text="{Binding Title}" FontSize="10.5"
                           Foreground="{DynamicResource Ink2Brush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
            </StackPanel>
        </DataTemplate>

        <!-- マイルストーン。日付番号の右に残る領域で中央寄せ（要件書 4.2） -->
        <DataTemplate x:Key="MilestoneTagTemplate">
            <Border CornerRadius="2" Padding="4,0" Margin="0,0,0,1" HorizontalAlignment="Stretch"
                    Background="{Binding Converter={StaticResource MilestoneBrush}, ConverterParameter=Face}">
                <TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center"
                           Foreground="{Binding Converter={StaticResource MilestoneBrush}}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- 曜日の見出し -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding WeekDayHeaders}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource WeekDayHeaderStyle}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- マス -->
        <ItemsControl ItemsSource="{Binding Cells}" Background="{DynamicResource LineBrush}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Cell" Margin="0,0,1,1" Padding="3,2"
                            Background="{DynamicResource PanelBrush}">
                        <StackPanel>
                            <!-- 日付とマイルストーン。日付は左に固定し、右に残る領域でラベルを中央寄せ -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="DayNumber" Grid.Column="0"
                                           Text="{Binding DayNumber}" FontSize="11.5" FontWeight="Medium"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource InkBrush}" />

                                <ItemsControl Grid.Column="1" Margin="4,0,0,0"
                                              ItemsSource="{Binding Milestones}"
                                              ItemTemplate="{StaticResource MilestoneTagTemplate}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Events}"
                                          ItemTemplate="{StaticResource EventChipTemplate}" />
                            <ItemsControl ItemsSource="{Binding Tasks}"
                                          ItemTemplate="{StaticResource TaskChipTemplate}" />
                        </StackPanel>
                    </Border>

                    <DataTemplate.Triggers>
                        <!-- 非稼働日は色を足さず背景を沈める（要件書 4.3） -->
                        <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                            <Setter TargetName="Cell" Property="Background"
                                    Value="{DynamicResource OffDayBrush}" />
                        </DataTrigger>

                        <!-- 前後の月にはみ出した日は控えめに -->
                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                            <Setter TargetName="Cell" Property="Opacity" Value="0.45" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsSunday}" Value="True">
                            <Setter TargetName="DayNumber" Property="Foreground"
                                    Value="{DynamicResource SundayBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                            <Setter TargetName="DayNumber" Property="Foreground"
                                    Value="{DynamicResource SaturdayBrush}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Cell" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="DayNumber" Property="FontWeight" Value="Bold" />
                            <Setter TargetName="DayNumber" Property="Foreground"
                                    Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Cell" Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
