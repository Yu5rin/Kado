<!--
    月ビュー。寸法と構造は mock-window.html の月グリッドに合わせてある。

      .cell   padding 3px 5px 4px / gap 2px / overflow hidden
      .drow   日付とマイルストーンを横に並べ、ラベルは残る領域で中央寄せ
      .dn     12px / weight 500 / 等幅数字
      .hol    10px / 日曜色
      .ms     10px / weight 600 / padding 0 5px / radius 3px
      .chip   11px / padding 1px 5px / radius 3px / 左に 3px の帯
      .more   10px / 補助色

    実働日の通し番号はここには出さない（要件書 4.3）。
-->
<UserControl x:Class="SlideinaCalendar.App.Views.MonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:MilestoneBrushConverter x:Key="MilestoneBrush" />
        <conv:EventColorBrushConverter x:Key="EventColorBrush" />
        <conv:EventColorFaceConverter x:Key="EventColorFace" />

        <!-- 曜日ヘッダ（.dow）。日曜は赤、土曜は青。週の開始曜日は設定で変わるので位置では決めない -->
        <DataTemplate x:Key="WeekDayHeaderTemplate">
            <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="11" Padding="0,5"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource Ink3Brush}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSunday}" Value="True">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SundayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SaturdayBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            マスに並ぶ予定・タスクの右クリックメニュー。
            ContextMenu は画面の木から外れて出るので、祖先をたどっても Window に届かない。
            行の Tag に MainViewModel を入れておき、PlacementTarget 経由で引く。
        -->
        <ContextMenu x:Key="EventChipMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="削除"
                      Command="{Binding PlacementTarget.Tag.DeleteChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <ContextMenu x:Key="TaskChipMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditTaskChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="削除"
                      Command="{Binding PlacementTarget.Tag.DeleteTaskChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- 予定のチップ。「09:00 計画レビュー」のように時刻を頭に付けて1行で出す -->
        <DataTemplate x:Key="EventChipTemplate">
            <!--
                ダブルクリックでその予定を開く。マス側の受け手が先に取ると
                「この日に予定を足す」になってしまうので、ここで止める
            -->
            <Border CornerRadius="3" Padding="5,1" Margin="0,2,0,0"
                    Background="{Binding Color, Converter={StaticResource EventColorFace}}"
                    BorderThickness="3,0,0,0"
                    BorderBrush="{Binding Color, Converter={StaticResource EventColorBrush}}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource EventChipMenu}"
                    MouseLeftButtonDown="OnEventChipClicked">
                <TextBlock Text="{Binding Label}" FontSize="11" LineHeight="16"
                           Foreground="{DynamicResource InkBrush}"
                           TextTrimming="CharacterEllipsis"
                           Typography.NumeralAlignment="Tabular"
                           ToolTip="{Binding Tooltip}" />
            </Border>
        </DataTemplate>

        <!-- タスクは帯を持たず、丸印を添えて予定と区別する -->
        <DataTemplate x:Key="TaskChipTemplate">
            <!-- 押せる面を作るため Background を敷く。透明でも当たり判定は残る -->
            <Border Background="Transparent" Margin="2,2,0,0"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource TaskChipMenu}"
                    MouseLeftButtonDown="OnTaskChipClicked">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center"
                             Stroke="{DynamicResource Ink3Brush}" StrokeThickness="1.5" />
                    <TextBlock Text="{Binding Title}" FontSize="11" LineHeight="16"
                               Foreground="{DynamicResource Ink2Brush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                </StackPanel>
            </Border>
        </DataTemplate>


        <!--
            日付の行のラベルの右クリックメニュー。
            ContextMenu は画面の木から外れて出るので、Tag に MainViewModel を入れて
            PlacementTarget 経由で引く。
        -->
        <ContextMenu x:Key="MilestoneMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditMilestoneCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="削除"
                      Command="{Binding PlacementTarget.Tag.DeleteMilestoneCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- マイルストーン。日付の右に残る領域で中央寄せ（要件書 4.2） -->
        <DataTemplate x:Key="MilestoneTagTemplate">
            <Border CornerRadius="3" Padding="5,0" HorizontalAlignment="Center"
                    Background="{Binding Name, Converter={StaticResource MilestoneBrush}, ConverterParameter=Face}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource MilestoneMenu}"
                    MouseLeftButtonDown="OnMilestoneClicked"
                    Cursor="Hand" ToolTip="ダブルクリックで編集 ・ 右クリックでメニュー">
                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" LineHeight="15"
                           Foreground="{Binding Name, Converter={StaticResource MilestoneBrush}}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <ItemsControl ItemsSource="{Binding WeekDayHeaders}"
                          ItemTemplate="{StaticResource WeekDayHeaderTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <ItemsControl x:Name="CellsHost" ItemsSource="{Binding Cells}"
                      SizeChanged="OnCellsResized"
                      Background="{DynamicResource LineBrush}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Cell" Margin="0,0,1,1" Padding="5,3,5,4"
                            Background="{DynamicResource PanelBrush}"
                            ClipToBounds="True" Cursor="Hand"
                            ToolTip="クリックで選択 ・ ダブルクリックで予定を追加&#10;予定やタスクは、ダブルクリックで編集・右クリックでメニュー"
                            MouseLeftButtonDown="OnCellClicked">
                        <!--
                            月ビューは日を選ぶための面でもある。押しても右ペインが動かないと、
                            ミニ月暦からしか日を選べない。InputBinding からは
                            RelativeSource の祖先をたどれないので、コードビハインドで受ける
                        -->
                        <StackPanel>
                            <!-- 日付とマイルストーン。日付は左に固定 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="DayNumber" Grid.Column="0"
                                           Text="{Binding DayNumber}"
                                           FontSize="12" FontWeight="Medium" LineHeight="16"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource InkBrush}" />

                                <ItemsControl Grid.Column="1" Margin="4,0,0,0"
                                              ItemsSource="{Binding Milestones}"
                                              ItemTemplate="{StaticResource MilestoneTagTemplate}" />
                            </Grid>

                            <!-- 祝日名。休みの理由が読めると予定を立てやすい -->
                            <TextBlock Text="{Binding HolidayName}" FontSize="10" LineHeight="13"
                                       Foreground="{DynamicResource SundayBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HolidayName, Converter={StaticResource NullToVisibility}}" />

                            <ItemsControl ItemsSource="{Binding Events}"
                                          ItemTemplate="{StaticResource EventChipTemplate}" />
                            <ItemsControl ItemsSource="{Binding Tasks}"
                                          ItemTemplate="{StaticResource TaskChipTemplate}" />

                            <!-- 入りきらなかった件数。隠れたまま気づけないのを防ぐ -->
                            <TextBlock Text="{Binding OverflowLabel}" FontSize="10" Margin="3,1,0,0"
                                       Foreground="{DynamicResource Ink3Brush}"
                                       Visibility="{Binding OverflowLabel, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <DataTemplate.Triggers>
                        <!--
                            実働日データを持つ日は、稼働する日と休業する日で面を分ける。
                            データを持たない日はどちらでもないので、そのままにしておく。
                            色を足すのではなく面の明るさで示す（要件書 4.3）
                        -->
                        <DataTrigger Binding="{Binding IsWorkingDayLit}" Value="True">
                            <Setter TargetName="Cell" Property="Background"
                                    Value="{DynamicResource WorkingDayBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                            <Setter TargetName="Cell" Property="Background"
                                    Value="{DynamicResource OffDayBrush}" />
                        </DataTrigger>

                        <!-- 前後の月は面を一段沈め、日付だけを薄くする。
                             セル全体を薄くすると予定まで読めなくなる -->
                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                            <Setter TargetName="Cell" Property="Background"
                                    Value="{DynamicResource SunkenBrush}" />
                            <Setter TargetName="DayNumber" Property="Opacity" Value="0.4" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                            <Setter TargetName="DayNumber" Property="Foreground"
                                    Value="{DynamicResource SaturdayBrush}" />
                        </DataTrigger>

                        <!--
                            祝日は日付そのものを赤にする（モックに合わせる）。土曜に重なっても
                            赤を採るので、土曜より後に置いてこちらを勝たせる
                        -->
                        <DataTrigger Binding="{Binding IsSundayLike}" Value="True">
                            <Setter TargetName="DayNumber" Property="Foreground"
                                    Value="{DynamicResource SundayBrush}" />
                        </DataTrigger>

                        <!-- 前後の月と同じ色にすると、載せているのか月の外なのか読めない -->
                        <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cell" Property="Background"
                                    Value="{DynamicResource CellHoverBrush}" />
                        </Trigger>

                        <!-- 今日は枠で囲む。内側に引くのでマスの大きさは変わらない -->
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Cell" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Cell" Property="Padding" Value="3,1,3,2" />
                            <Setter TargetName="DayNumber" Property="FontWeight" Value="Bold" />
                            <Setter TargetName="DayNumber" Property="Foreground"
                                    Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>

                        <!-- 休業日の面と近いと紛れるので、はっきり青に寄せた色を使う -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Cell" Property="Background"
                                    Value="{DynamicResource CellSelectedBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
