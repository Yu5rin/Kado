<!--
    画面の隅に出す知らせ。
    非 MSIX の配布で Windows のトーストを出すには AUMID の登録と COM
    アクティベーターが要る。そこまでせずとも用は足りるので、同じ配色の小窓を
    自前で出す。WinForms の NotifyIcon は、WPF と型がぶつかるので使わない。
-->
<Window x:Class="SlideinaCalendar.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{DynamicResource UiFontFamily}"
        Focusable="False" ShowActivated="False">

    <Border CornerRadius="10" Padding="20,16" Margin="12"
            Background="{DynamicResource PanelBrush}"
            BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
            Cursor="Hand" MouseLeftButtonDown="OnClicked">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <DockPanel>
            <!-- 閉じる。読み終わるのを待たずに消せるように -->
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0"
                    Style="{DynamicResource SmallIconButtonStyle}"
                    ToolTip="閉じる" Click="OnCloseClicked">
                <Path Data="{DynamicResource IconClose}" Stretch="Uniform" Width="9" Height="9"
                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                      Stroke="{DynamicResource Ink3Brush}" />
            </Button>

            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource InkBrush}" />
                <TextBlock x:Name="MessageText" FontSize="13" LineHeight="19" Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource Ink2Brush}" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
