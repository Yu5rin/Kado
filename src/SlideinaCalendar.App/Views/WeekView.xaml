<!--
    週ビュー。寸法は mock-window.html の .week に合わせてある。

      .wk-hd   46px ＋ 7列 / 曜日 10.5px ・ 日にち 16px ・ 実働日 9.5px
      .allday  終日レーン。ここのタスクを時間帯へドラッグして作業時間を確保する
      .hours   1時間 44px の時間軸。現在時刻は赤い線

    時刻の見出しと日付の列がずれないよう、見出し側にもスクロールバーぶんの幅を空ける。
-->
<UserControl x:Class="SlideinaCalendar.App.Views.WeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
             xmlns:views="clr-namespace:SlideinaCalendar.App.Views"
             AllowDrop="True" PreviewDragOver="OnDragMoving" PreviewDrop="OnDragFinished"
             PreviewMouseWheel="OnWheel"
             x:Name="Root"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:MilestoneBrushConverter x:Key="MilestoneBrush" />

        <!-- 日付の行のラベルの右クリックメニュー。Tag 経由で MainViewModel を引く -->
        <ContextMenu x:Key="MilestoneMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditMilestoneCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="削除"
                      Command="{Binding PlacementTarget.Tag.DeleteMilestoneCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <conv:TimelineOffsetToMarginConverter x:Key="TimelineOffsetToMargin" />


        <!--
            終日レーンの右クリックメニュー。ContextMenu は画面の木から外れて出るので、
            Tag に MainViewModel を入れておき、PlacementTarget 経由で引く。
        -->
        <ContextMenu x:Key="AllDayEventMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="削除"
                      Command="{Binding PlacementTarget.Tag.DeleteChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <ContextMenu x:Key="AllDayTaskMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditTaskChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="削除"
                      Command="{Binding PlacementTarget.Tag.DeleteTaskChipCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- 終日レーンのタスク。点線の丸印で予定と区別する -->
        <DataTemplate x:Key="AllDayTaskTemplate">
            <Border CornerRadius="3" Padding="5,1" Margin="0,0,0,2" Cursor="SizeAll"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                    ToolTip="ダブルクリックで編集 ・ 時間帯へドラッグすると作業時間を確保します"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource AllDayTaskMenu}"
                    MouseLeftButtonDown="OnAllDayTaskClicked"
                    MouseMove="OnAllDayDragging">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5" Height="5" Margin="0,0,4,0" VerticalAlignment="Center"
                             Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                    <TextBlock Text="{Binding Title}" FontSize="10.5"
                               Foreground="{DynamicResource InkBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AllDayEventTemplate">
            <Border CornerRadius="3" Padding="5,1" Margin="0,0,0,2" Cursor="Hand"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource AllDayEventMenu}"
                    MouseLeftButtonDown="OnAllDayEventClicked"
                    MouseMove="OnAllDayDragging"
                    Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="{Binding Label}" FontSize="10.5"
                           Foreground="{DynamicResource InkBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}" />
            </Border>
        </DataTemplate>

        <!-- 日付ヘッダ1つ分 -->
        <DataTemplate x:Key="DayHeaderTemplate">
            <!-- 見出しを押すと、その日を選ぶ。右ペインがその日に入れ替わる -->
            <Border x:Name="Head" Padding="0,5,0,6" Cursor="Hand"
                    Background="Transparent"
                    ToolTip="押すとその日を選びます"
                    MouseLeftButtonDown="OnDayHeaderClicked"
                    BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}">
                <StackPanel>
                    <!-- 曜日だけ。祝日名は日付の下に赤で添える（月ビューと揃える） -->
                    <TextBlock x:Name="DayName" Text="{Binding DayName}" FontSize="10.5"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Ink3Brush}" />

                    <Border x:Name="NumberFace" CornerRadius="13" Width="26" Height="26"
                            Background="Transparent" HorizontalAlignment="Center">
                        <TextBlock x:Name="DayNumber" Text="{Binding DayNumber}"
                                   FontSize="16" FontWeight="Medium"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </Border>

                    <!--
                        祝日名。予定としてではなく、日付の添え書きとして出す。
                        Google の「日本の祝日」カレンダーを引くと予定の並びに混ざる
                    -->
                    <TextBlock Text="{Binding HolidayName}" FontSize="9.5"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SundayBrush}"
                               Visibility="{Binding HolidayName, Converter={StaticResource NullToVisibility}}" />

                    <!--
                        実働日の通し番号はここには出さない。7日ぶん並ぶと数字が多すぎて、
                        日付そのものが読みにくくなる。日ビューと上部のバーには出る
                    -->

                    <ItemsControl ItemsSource="{Binding Milestones}" Margin="0,2,0,0"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="5,0" Margin="0,0,0,1"
                                        Cursor="Hand" ToolTip="ダブルクリックで編集 ・ 右クリックでメニュー"
                                        Tag="{Binding DataContext,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                        ContextMenu="{StaticResource MilestoneMenu}"
                                        MouseLeftButtonDown="OnMilestoneClicked"
                                        Background="{Binding Name, Converter={StaticResource MilestoneBrush},
                                                    ConverterParameter=Face}">
                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                               LineHeight="15"
                                               Foreground="{Binding Name,
                                                           Converter={StaticResource MilestoneBrush}}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWorkingDayLit}" Value="True">
                    <Setter TargetName="Head" Property="Background" Value="{DynamicResource WorkingDayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="Head" Property="Background" Value="{DynamicResource OffDayBrush}" />
                </DataTrigger>

                <!-- 選んでいる日。実働日の塗りより後に置いてこちらを勝たせる -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Head" Property="Background"
                            Value="{DynamicResource CellSelectedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                    <Setter TargetName="DayNumber" Property="Foreground" Value="{DynamicResource SaturdayBrush}" />
                    <Setter TargetName="DayName" Property="Foreground" Value="{DynamicResource SaturdayBrush}" />
                </DataTrigger>

                <!-- 祝日は曜日に関わらず赤。土曜より後に置いてこちらを勝たせる -->
                <DataTrigger Binding="{Binding IsSundayLike}" Value="True">
                    <Setter TargetName="DayNumber" Property="Foreground" Value="{DynamicResource SundayBrush}" />
                    <Setter TargetName="DayName" Property="Foreground" Value="{DynamicResource SundayBrush}" />
                </DataTrigger>

                <!-- 今日は日にちを丸で囲う -->
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="NumberFace" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="DayNumber" Property="Foreground" Value="White" />
                    <Setter TargetName="DayNumber" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="DayNumber" Property="FontSize" Value="14" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 終日レーン1つ分 -->
        <DataTemplate x:Key="AllDayCellTemplate">
            <Border x:Name="Cell" Padding="3" MinHeight="30" Background="Transparent"
                    BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}"
                    AllowDrop="True" DragOver="OnAllDayDragOver" Drop="OnAllDayDropped">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding AllDayEvents}"
                                  ItemTemplate="{StaticResource AllDayEventTemplate}" />
                    <ItemsControl ItemsSource="{Binding Tasks}"
                                  ItemTemplate="{StaticResource AllDayTaskTemplate}" />
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWorkingDayLit}" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource WorkingDayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource OffDayBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- 日付ヘッダ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="46" />
                <!-- 下のスクロールバーぶん。空けないと列が横にずれる -->
                <Border DockPanel.Dock="Right"
                        Width="{DynamicResource ScrollBarThickness}" />
                <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayHeaderTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="7" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 終日レーン。ここのタスクを下へドラッグして作業時間にする（要件書 5.4） -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineStrongBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Width="46" Text="終日" FontSize="9.5"
                           TextAlignment="Right" Padding="0,4,5,0"
                           Foreground="{DynamicResource Ink3Brush}" />
                <Border DockPanel.Dock="Right"
                        Width="{DynamicResource ScrollBarThickness}" />
                <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource AllDayCellTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="7" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 時間軸 -->
        <!-- 選んだ時間帯を、ここで測った高さに割り付ける -->
        <!-- バーは常に出す。上の段はこの幅ぶんを空けてあり、消えると列がずれる -->
        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="OnTimelineResized" PreviewMouseWheel="OnTimelineWheel">
            <Grid Height="{Binding TimelineHeight}">
                <DockPanel>
                    <ItemsControl DockPanel.Dock="Left" Width="46" ItemsSource="{Binding HourLabels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    高さは枠で取り、文字だけを線の上へずらす。
                                    文字に負の余白を付けると、その分だけ1行ずつ詰まって
                                    見出しと罫線が食い違っていく（24時間ぶんで2時間ずれる）
                                -->
                                <Border Height="{Binding DataContext.HourHeight, ElementName=Root}">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Top"
                                               FontSize="10"
                                               TextAlignment="Right" Padding="0,0,6,0" Margin="0,-5,0,0"
                                               Foreground="{DynamicResource Ink3Brush}"
                                               Typography.NumeralAlignment="Tabular" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" Columns="7" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:TimelineColumnView
                                    HourLabels="{Binding DataContext.HourLabels, ElementName=Root}"
                                    RowHeight="{Binding DataContext.HourHeight, ElementName=Root}"
                                    NowOffset="{Binding DataContext.NowOffset, ElementName=Root}"
                                    ShowNow="{Binding DataContext.ShowNowLine, ElementName=Root}"
                                    DayStartHour="{Binding DataContext.DayStartHour, ElementName=Root}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
