<!--
    年ビュー（要件書 5.1）。年度単位（4月〜翌3月）。

    ストリップ … 1行1か月、横に1〜31日。会社配布の実働日カレンダーと同じ形で、
                 休みの並びと繁閑が縦に揃って読める。右端に月の実働日数。
                 月末より後ろには枠を作らない（2月なら28日で打ち切る）。
    カレンダー … ミニカレンダー12枚。日付を引き当てる用途。

    切り替えはこのビューの中のボタンで行う。年ビューを見ているときにしか関係しない
    選び方なので、設定画面には出さない。

    上期・下期は行のまとまりで示すため、半期ビューは設けない。
-->
<UserControl x:Class="SlideinaCalendar.App.Views.YearView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
             Background="{DynamicResource BackgroundBrush}"
             PreviewMouseWheel="OnWheel">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:DayMarkBrushConverter x:Key="DayMarkBrush" />

        <!--
            カレンダー表示の印。マスが小さいので帯ではなく点にする。
            横に並べて、何件あるかも分かるようにする
        -->
        <!--
            カレンダー表示の予定1件ぶん。ストリップと同じ帯にする。点だと、色は
            分かっても「何件あるか」がつかめない
        -->
        <DataTemplate x:Key="GridMarkTemplate">
            <Border Height="2.5" CornerRadius="1.25" Margin="1.5,0.75"
                    Background="{Binding Converter={StaticResource DayMarkBrush}}" />
        </DataTemplate>

        <!-- 予定1件ぶんの帯。日付の上下に重ねる -->
        <DataTemplate x:Key="DayMarkTemplate">
            <Border Height="2" CornerRadius="1" Margin="0,0,0,1"
                    Width="{Binding DataContext.MarkWidth,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Background="{Binding Converter={StaticResource DayMarkBrush}}" />
        </DataTemplate>

        <!--
            マスの右クリックメニュー。
            ContextMenu は画面の木から外れて出るので、祖先をたどっても Window に
            届かない。Tag に MainViewModel を入れて PlacementTarget 経由で引く
        -->
        <ContextMenu x:Key="YearDayMenu">
            <MenuItem Header="この日に予定を追加"
                      Command="{Binding PlacementTarget.Tag.AddEventOnCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Date,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="この日の月を見る"
                      Command="{Binding PlacementTarget.Tag.ShowMonthOfCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Date,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="この日を1日で見る"
                      Command="{Binding PlacementTarget.Tag.ShowDayOfCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Date,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!--
            ストリップの1日。

            幅は画面に合わせて伸び縮みするが、同じ年度の中では全部同じ幅。月ごとに
            変えると 1日から31日までの位置が縦に揃わず、休みの並びが読めない。

            日付の上下に、その日の予定を細い帯で重ねる。狭いのでタイトルは出せないが、
            詰まっている日がどこかは一目で分かる（会社配布のカレンダーと同じ考え方）。
        -->
        <DataTemplate x:Key="StripDayTemplate">
            <Border x:Name="Cell" Margin="0,0,1,0" CornerRadius="2"
                    Width="{Binding DataContext.DayWidth,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Height="{Binding DataContext.DayHeight,
                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Background="{DynamicResource PanelBrush}"
                    Cursor="Hand" ToolTip="{Binding Tooltip}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource YearDayMenu}"
                    MouseLeftButtonDown="OnDayClicked">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Mark" Text="{Binding DayOfWeekMark}" FontSize="8"
                               HorizontalAlignment="Center" LineHeight="10"
                               Foreground="{DynamicResource Ink3Brush}" />

                    <!--
                        日付の上は「inaCalendar」の予定だけ。仕様期限などの区切りは
                        自分の用事とは意味が違うので、混ぜずに上下へ分ける
                    -->
                    <ItemsControl ItemsSource="{Binding TopMarks}" Margin="0,1,0,0"
                                  HorizontalAlignment="Center"
                                  ItemTemplate="{StaticResource DayMarkTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock x:Name="Number" Text="{Binding DayNumber}"
                               FontSize="{Binding DataContext.DayFontSize,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                               HorizontalAlignment="Center" LineHeight="14"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource InkBrush}" />

                    <!-- 日付の下はそれ以外の予定 -->
                    <ItemsControl ItemsSource="{Binding BottomMarks}" Margin="0,1,0,0"
                                  HorizontalAlignment="Center"
                                  ItemTemplate="{StaticResource DayMarkTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <!-- 休業日は面を沈める。色を足すのではなく明るさで示す（要件書 4.3） -->
                <DataTrigger Binding="{Binding IsOffDay}" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource OffDayBrush}" />
                    <Setter TargetName="Number" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Mark" Property="Opacity" Value="0.45" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                    <Setter TargetName="Mark" Property="Foreground"
                            Value="{DynamicResource SaturdayBrush}" />
                </DataTrigger>

                <!-- 祝日は土曜に重なっても赤を採るので、土曜より後に置く -->
                <DataTrigger Binding="{Binding IsSundayLike}" Value="True">
                    <Setter TargetName="Mark" Property="Foreground"
                            Value="{DynamicResource SundayBrush}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="Background"
                            Value="{DynamicResource CellSelectedBrush}" />
                </DataTrigger>

                <!-- 今日は枠で囲む。内側に引くのでマスの大きさは変わらない -->
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                    <Setter TargetName="Cell" Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Number" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="Number" Property="Foreground"
                            Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ストリップの1行（1か月） -->
        <DataTemplate x:Key="MonthStripTemplate">
            <Border x:Name="Row" Padding="6,3" CornerRadius="4" Margin="0,0,0,2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="40"
                               FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource InkBrush}" />

                    <!-- 右端に月の実働日数。会社配布のカレンダーと同じ位置 -->
                    <Border DockPanel.Dock="Right" Width="52" CornerRadius="4" Padding="6,2"
                            VerticalAlignment="Center" Margin="8,0,0,0"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock FontSize="11" HorizontalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource Ink2Brush}">
                            <Run Text="{Binding WorkingDayCountText, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}" /><Run Text=" 日" />
                        </TextBlock>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Days}"
                                  ItemTemplate="{StaticResource StripDayTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasToday}" Value="True">
                    <Setter TargetName="Row" Property="Background"
                            Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- カレンダー表示の1か月。日付を引き当てる用途なので、実働日は塗らない -->
        <DataTemplate x:Key="MonthGridTemplate">
            <!--
                1枚は入れ物いっぱいに広がる。中身を固定の大きさで組んで Viewbox で
                拡大する作りにしていたが、縦横の比が入れ物と合わず、幅に合わせると
                下が大きく余った。マスそのものを伸ばす。
            -->
            <Border Margin="0,0,10,10" Padding="8,6" CornerRadius="5"
                    Background="{DynamicResource PanelBrush}"
                    BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" FontSize="10.5" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource Ink3Brush}">
                            <Run Text="実働 " /><Run Text="{Binding WorkingDayCountText, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}" /><Run Text=" 日" />
                        </TextBlock>

                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" />
                    </DockPanel>

                    <!--
                        7列5行に等分する。ストリップと同じで1日から順に折り返すだけで、
                        曜日は揃えない（空の枠を置くと月によって右端がぶれる）。

                        行数を 5 で固定するのは、31日の月も28日の月も同じ高さのマスに
                        するため。任せると、短い月だけマスが縦に伸びて不揃いになる。
                        高さは入れ物から配られるので、縦に余ったぶんもマスが受け取る
                    -->
                    <ItemsControl ItemsSource="{Binding Days}"
                                  BorderThickness="1,1,0,0"
                                  BorderBrush="{DynamicResource LineBrush}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="5" Columns="7" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    マスは線で区切る。帯と日付が続けて並ぶので、
                                    区切りが無いと隣の日のものか下の週のものか分からない
                                -->
                                <Border x:Name="Cell" MinHeight="28"
                                        BorderThickness="0,0,1,1"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        Cursor="Hand" ToolTip="{Binding Tooltip}"
                                        Tag="{Binding DataContext,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                        ContextMenu="{StaticResource YearDayMenu}"
                                        MouseLeftButtonDown="OnDayClicked">
                                    <!--
                                        ストリップと同じ並び。実働日カレンダー
                                        （inaCalendar）の予定は日付の上、それ以外は
                                        日付の下。仕様期限や1次GOが日付の上に出て、
                                        自分の予定が下に付く。

                                        <b>帯は日付に寄せ、余白はマスの上下に逃がす。</b>
                                        上下の端に貼り付けていたら、下の帯が次の週の
                                        日付とくっついて見えた。ひとまとまりにすれば、
                                        どの日のものかが離れて見て分かる
                                    -->
                                    <StackPanel VerticalAlignment="Center" Margin="1,3,1,3">
                                        <ItemsControl ItemsSource="{Binding TopMarks}"
                                                      ItemTemplate="{StaticResource GridMarkTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <TextBlock x:Name="Number" Text="{Binding DayNumber}" FontSize="10.5"
                                                   HorizontalAlignment="Center" LineHeight="14"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{DynamicResource InkBrush}" />

                                        <ItemsControl ItemsSource="{Binding BottomMarks}"
                                                      ItemTemplate="{StaticResource GridMarkTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                                        <Setter TargetName="Number" Property="Foreground"
                                                Value="{DynamicResource SaturdayBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSundayLike}" Value="True">
                                        <Setter TargetName="Number" Property="Foreground"
                                                Value="{DynamicResource SundayBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Cell" Property="Background"
                                                Value="{DynamicResource CellSelectedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="Cell" Property="Background"
                                                Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter TargetName="Number" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="Number" Property="Foreground"
                                                Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- 年度の見出しと、出し方の切り替え -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="5" ClipToBounds="True"
                        BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                    <StackPanel Orientation="Horizontal">
                        <!--
                            出し方はアイコンだけにする。年度の見出しと実働日の数と
                            並ぶので、名前まで置くと帯の幅では入りきらない
                        -->
                        <ToggleButton Style="{StaticResource SegmentButtonStyle}" Padding="9,4"
                                     ToolTip="ストリップ：1行1か月。休みの並びと繁閑が縦に揃って読めます"
                                     IsChecked="{Binding Layout, Mode=OneWay,
                                                 Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Strip}"
                                     Command="{Binding SetLayoutCommand}"
                                     CommandParameter="Strip">
                            <Path Data="{StaticResource IconRows}" Stretch="Uniform"
                                  Width="15" Height="15"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource SegmentButtonStyle}" Padding="9,4"
                                     BorderThickness="0"
                                     ToolTip="カレンダー：ミニカレンダー12枚。日付を引き当てる用途"
                                     IsChecked="{Binding Layout, Mode=OneWay,
                                                 Converter={StaticResource EnumToBool},
                                                 ConverterParameter=Grid}"
                                     Command="{Binding SetLayoutCommand}"
                                     CommandParameter="Grid">
                            <Path Data="{StaticResource IconGrid}" Stretch="Uniform"
                                  Width="15" Height="15"
                                  Stroke="{Binding Foreground,
                                           RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Left" Text="{Binding HeaderText}" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource InkBrush}" />

                <TextBlock Text="{Binding WorkingDayTotalText}" FontSize="11.5" Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource Ink3Brush}" />
            </DockPanel>
        </Border>

        <!--
            細い帯として使っているときは、31日ぶんが横に入りきらない。切り捨てると
            月末が見えなくなるので、横にも送れるようにしておく
        -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Padding="12,10" SizeChanged="OnResized">
            <Grid>
                <!-- ストリップ。上期・下期を見出しで分ける -->
                <StackPanel Visibility="{Binding IsStrip, Converter={StaticResource BoolToVisibility}}">
                    <!--
                        日付の目盛り。1・5・10・15・20・25・30 の位置に数字を置く。
                        31 マスぶんの幅に合わせて動くので、下の行と縦に揃う
                    -->
                    <ItemsControl x:Name="Ruler" ItemsSource="{Binding RulerMarks}" Margin="46,0,0,2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="9"
                                           Margin="0,0,1,0"
                                           Width="{Binding DataContext.DayWidth,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource Ink3Brush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="上期（4〜9月）" FontSize="11" FontWeight="SemiBold"
                               Margin="6,0,0,4"
                               Foreground="{DynamicResource Ink3Brush}" />
                    <ItemsControl ItemsSource="{Binding FirstHalf}"
                                  ItemTemplate="{StaticResource MonthStripTemplate}" />

                    <TextBlock Text="下期（10〜3月）" FontSize="11" FontWeight="SemiBold"
                               Margin="6,12,0,4"
                               Foreground="{DynamicResource Ink3Brush}" />
                    <ItemsControl ItemsSource="{Binding SecondHalf}"
                                  ItemTemplate="{StaticResource MonthStripTemplate}" />
                </StackPanel>

                <!-- カレンダー12枚 -->
                <!--
                    カレンダー12枚。左から縦に 4〜6月、7〜9月、10〜12月、1〜3月。
                    四半期ごとに縦へ揃うので、期のまとまりが読める。入れ物は左から右へ
                    詰めるので、並べる順のほうを ViewModel で入れ替えてある
                -->
                <ItemsControl x:Name="GridHost" ItemsSource="{Binding GridMonths}"
                              ItemTemplate="{StaticResource MonthGridTemplate}"
                              Visibility="{Binding IsGrid, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding DataContext.GridColumns,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Rows="{Binding DataContext.GridRows,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
