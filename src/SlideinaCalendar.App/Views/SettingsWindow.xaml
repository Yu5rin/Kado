<!--
    設定。
    残す項目は要件書 5.5 で決まっている。ビュー別の表示項目 ON/OFF のような、
    レイアウトで解くべきものは置かない。通知は仕組みごと作るときに足す。

    保存ボタンは置かない。変えたその場で効き、そのまま保存される。
-->
<Window x:Class="SlideinaCalendar.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
        Title="設定" Width="420" SizeToContent="Height"
        Icon="/Assets/app.png"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="12.5"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource InkBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

        <!--
            選択肢の出し方。
            項目のどれを出すかを名前で指すやり方は、このアプリの ComboBox の
            テンプレートでは効かず、型の名前がそのまま出てしまう。決め打ちにする
        -->
        <DataTemplate x:Key="ChoiceTemplate">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>

        <!-- 節の見出し -->
        <Style x:Key="SectionHeadStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
        </Style>

        <!-- 項目の説明。何が変わるのかを一行で添える -->
        <Style x:Key="FieldNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,13,16,11"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock Text="設定" FontSize="15" FontWeight="SemiBold" />
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="閉じる"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsCancel="True" IsDefault="True" />

                <TextBlock Text="{Binding Message}" FontSize="11" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,10,0"
                           Foreground="{DynamicResource SundayBrush}"
                           Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />
            </DockPanel>
        </Border>

        <StackPanel Margin="16,14">
            <!-- 見え方 -->
            <TextBlock Text="見え方" Style="{StaticResource SectionHeadStyle}" />

            <TextBlock Text="配色" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                      ItemsSource="{Binding Themes}" ItemTemplate="{StaticResource ChoiceTemplate}"
                      SelectedValuePath="Value" SelectedValue="{Binding Theme}" />

            <Border Height="12" />

            <TextBlock Text="週の始まり" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                      ItemsSource="{Binding WeekStarts}" ItemTemplate="{StaticResource ChoiceTemplate}"
                      SelectedValuePath="Value" SelectedValue="{Binding WeekStart}" />
            <TextBlock Text="月ビューの列の並びと、ミニ月暦に効きます。" Style="{StaticResource FieldNoteStyle}" />

            <Border Height="18" />

            <!-- 数え方 -->
            <TextBlock Text="日数の数え方" Style="{StaticResource SectionHeadStyle}" />

            <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                      ItemsSource="{Binding DayCounts}" ItemTemplate="{StaticResource ChoiceTemplate}"
                      SelectedValuePath="Value" SelectedValue="{Binding CountInCalendarDays}" />
            <TextBlock Text="期限までの残り・遅れ・済んだタスクの結果に効きます。今月の実働日数と実働日計算は、いつも実働日で数えます。"
                       Style="{StaticResource FieldNoteStyle}" />

            <Border Height="18" />

            <!-- 時間軸 -->
            <TextBlock Text="週ビュー・日ビュー" Style="{StaticResource SectionHeadStyle}" />

            <TextBlock Text="表示時間帯" Style="{StaticResource FieldLabelStyle}" />
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="92" Style="{StaticResource FieldComboBoxStyle}"
                          ItemsSource="{Binding StartHours}" ItemTemplate="{StaticResource ChoiceTemplate}"
                          SelectedValuePath="Value" SelectedValue="{Binding DayStartHour}" />
                <TextBlock Text="〜" VerticalAlignment="Center" Margin="8,0" />
                <ComboBox Width="92" Style="{StaticResource FieldComboBoxStyle}"
                          ItemsSource="{Binding EndHours}" ItemTemplate="{StaticResource ChoiceTemplate}"
                          SelectedValuePath="Value" SelectedValue="{Binding DayEndHour}" />
            </StackPanel>
            <TextBlock Text="この範囲を縦いっぱいに割り付けます。狭めるほど1時間が高くなります。"
                       Style="{StaticResource FieldNoteStyle}" />

            <Border Height="12" />

            <TextBlock Text="1時間の高さ" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                      ItemsSource="{Binding HourHeights}" ItemTemplate="{StaticResource ChoiceTemplate}"
                      SelectedValuePath="Value" SelectedValue="{Binding HourHeight}" />
            <TextBlock Text="決め打ちにすると、入りきらないぶんはスクロールになります。"
                       Style="{StaticResource FieldNoteStyle}" />

            <Border Height="18" />

            <!-- 実働日データ -->
            <TextBlock Text="実働日データ" Style="{StaticResource SectionHeadStyle}" />

            <TextBlock Text="配信元（feed.json の URL）" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Style="{StaticResource FieldTextBoxStyle}"
                     Text="{Binding FeedUrl, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="1か所に置いたファイルを取りに行きます。https:// のみ。空なら取りに行きません。"
                       Style="{StaticResource FieldNoteStyle}" />

            <Border Height="8" />

            <CheckBox Content="1日に1回、自動で取りに行く" IsChecked="{Binding FeedAuto}" Cursor="Hand" />

            <Border Height="18" />

            <!-- 起動 -->
            <TextBlock Text="起動" Style="{StaticResource SectionHeadStyle}" />

            <TextBlock Text="起動したときに開くビュー" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                      ItemsSource="{Binding StartupViews}" ItemTemplate="{StaticResource ChoiceTemplate}"
                      SelectedValuePath="Value" SelectedValue="{Binding StartupView}" />

            <StackPanel Visibility="{Binding CanRunAtLogon, Converter={StaticResource BoolToVisibility}}">
                <Border Height="12" />
                <CheckBox Content="Windows にログオンしたときに起動する"
                          IsChecked="{Binding RunAtLogon}" Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
