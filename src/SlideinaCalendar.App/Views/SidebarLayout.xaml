<!--
    スリムパネル。4つ目のパネルとして、ほかと並べて置く。

    上にひと月の並び、下に選んだ日の予定とタスク。仕切りはドラッグで高さを
    変えられる。細いので月だけにしてある（週や日は時間軸が要るぶん、この幅では
    読めない）。マスには予定の名前を出さず、入っていることを色で示す。

    幅では切り替えない。出すかどうかは、ほかのパネルと同じく手で選ぶ。
-->
<UserControl x:Class="SlideinaCalendar.App.Views.SidebarLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
             xmlns:views="clr-namespace:SlideinaCalendar.App.Views"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:EventColorBrushConverter x:Key="EventColorBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:MilestoneBrushConverter x:Key="MilestoneBrush" />

        <!--
            予定行の右クリックメニュー。右ペイン・月ビューにある EventChipMenu 相当。
            ContextMenu は画面の木から外れて出るので、Tag に MainViewModel を入れて
            PlacementTarget 経由で引く。
        -->
        <ContextMenu x:Key="EventRowMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditEventCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="削除"
                      Command="{Binding PlacementTarget.Tag.DeleteEventCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- 日付の行のラベル（マイルストーン）の右クリックメニューは
             Themes/Controls.xaml の共有 MilestoneMenu を使う（項目13） -->
        <!--
            右ペインのタスク行（.tk）。「タスク」「期限なしのタスク」の両方の節で
            使い回す（項目B）。右ペインと見た目を揃える（項目13）。チェックの
            スタイルと済み色を右ペインと同じ TaskCheckBoxStyle / DoneBrush に統一する

            ゴミ箱ボタン（項目5）。右ペインの TaskRowTemplate（MainWindow.xaml）は
            指した行にだけゴミ箱を出すが、こちらは名前が似ているだけの別の
            DataTemplate（ResourceDictionary の scope が違うファイルなので、
            同じキーで直接は共有できない）として作られたときに、ゴミ箱ボタン
            そのものを持たずに終わっていた。右ペインの予定行・スリム自身の
            予定行（EventRowMenu のすぐ下）と同じ、Row に x:Name を付けて
            IsMouseOver で RowDeleteButtonStyle の Opacity を上げる形にそろえる
        -->
        <DataTemplate x:Key="SlimTaskRowTemplate">
            <Border x:Name="Row" Background="Transparent" Padding="0,4" Cursor="Hand"
                    MouseLeftButtonDown="OnTaskClicked">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0"
                              Style="{StaticResource TaskCheckBoxStyle}"
                              IsChecked="{Binding IsDone, Mode=OneWay}"
                              Command="{Binding DataContext.ToggleTaskDoneCommand,
                                        RelativeSource={RelativeSource
                                        AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />

                    <!-- 幅160pxまで細くなるので、20pxのボタン1つ・ホバーでだけ出す形にとどめる -->
                    <Button x:Name="Delete" DockPanel.Dock="Right"
                            Style="{StaticResource RowDeleteButtonStyle}"
                            Command="{Binding DataContext.DeleteTaskCommand,
                                      RelativeSource={RelativeSource
                                      AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Path Data="{StaticResource IconTrash}" Stretch="Uniform" Width="12" Height="12"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" x:Name="Title" Text="{Binding Title}" LineHeight="16"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}"
                                   Foreground="{DynamicResource InkBrush}" />
                        <!-- 期限なしのときは空行を残さない -->
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding DueText}"
                                   LineHeight="14"
                                   Foreground="{DynamicResource Ink3Brush}"
                                   Visibility="{Binding DueText,
                                                Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Title" Property="TextDecorations"
                            Value="Strikethrough" />
                    <Setter TargetName="Title" Property="Foreground"
                            Value="{DynamicResource DoneBrush}" />
                </DataTrigger>

                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background"
                            Value="{DynamicResource SunkenBrush}" />
                    <Setter TargetName="Delete" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!--
            選んでいる日と送り。ここは月だけを出すので、ビューの切り替えは置かない。
            実働日の通し番号は下の欄に出るので、ここでは繰り返さない
        -->
        <!--
            「ビュー見出し」の Padding を他ビューと揃える（項目20）。ただし文字サイズは
            14px のまま残す。ここは「今日」「◀」「▶」の3つのボタンと1行に同居しており、
            パネルは160〜200px まで細くなる。16px に上げるとボタンを押しのけて
            見出しが欠ける恐れがあり、WPF は Linux では確かめられないので寄せない
            （項目19の「判断に迷ったら寄せない」に倣う）
        -->
        <!--
            月カレンダーの折りたたみ（項目2）。見出しの行そのものを押せるようにする。
            「今日」「実働日計算」「◀ ▶」は Button なので、押したときのクリックは
            ButtonBase が自分で処理済みにしてここまで来ない（バブリングしない）。
            残りの余白か、下の年月の文字を押したときだけ切り替わる
        -->
        <Border DockPanel.Dock="Top" Padding="12,8"
                Background="{DynamicResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}"
                Cursor="Hand" MouseLeftButtonDown="OnMonthHeaderClicked"
                ToolTip="月カレンダーの折りたたみを切り替え">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!--
                        スリムパネルだけのときは、ツールバーの「今日」が出ていない。
                        ここが唯一の戻り口になる
                    -->
                    <Button Content="今日" Margin="0,0,6,0"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding TodayCommand}"
                            Visibility="{Binding ShowsSlimToday,
                                         Converter={StaticResource BoolToVisibility}}" />

                    <!--
                        実働日計算（項目10）。「今日」の隣に12pxのアイコンボタンで置く。
                        「＋予定／＋タスク」は、予定・タスクそれぞれの節の見出しの
                        すぐ下（一覧の上）に行として置いてある（項目1）
                    -->
                    <Button Style="{StaticResource SmallIconButtonStyle}" Margin="0,0,6,0"
                            Command="{Binding OpenWorkingDayCalculatorCommand}"
                            ToolTip="実働日計算を開く（Ctrl＋K）">
                        <Path Data="{StaticResource IconCalc}" Stretch="Uniform"
                              Width="12" Height="12"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>

                    <!-- アイコンの粒度を12px@1.5に揃える（項目11） -->
                    <Button Style="{StaticResource SmallIconButtonStyle}" ToolTip="前の月"
                            Command="{Binding SlimPreviousCommand}">
                        <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform"
                              Width="12" Height="12"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button Style="{StaticResource SmallIconButtonStyle}" ToolTip="次の月"
                            Command="{Binding SlimNextCommand}">
                        <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform"
                              Width="12" Height="12"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 開＝▾・畳＝▸。畳んだ状態は AppSettings に覚える（MainViewModel.IsSlimCalendarCollapsed） -->
                    <Path Data="{StaticResource IconChevronDown}" Stretch="Uniform"
                          Width="10" Height="10" Margin="0,0,6,0"
                          Stroke="{DynamicResource Ink3Brush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Visibility="{Binding IsSlimCalendarCollapsed,
                                       Converter={StaticResource InverseBoolToVisibility}}" />
                    <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform"
                          Width="10" Height="10" Margin="0,0,6,0"
                          Stroke="{DynamicResource Ink3Brush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Visibility="{Binding IsSlimCalendarCollapsed,
                                       Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="14" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource InkBrush}">
                        <Run Text="{Binding SlimTitleYear, Mode=OneWay}" FontSize="11" FontWeight="Medium"
                             Foreground="{DynamicResource Ink3Brush}" /><Run Text=" " /><Run
                             Text="{Binding SlimTitleMonth, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <!--
                    上下の割り振りは手で変えられる。まだ一度もつまんで変えていない
                    （AppSettings.HasSlimCalendarShare が false の）あいだは、既定を
                    固定割合にせず Height="Auto" のまま使う（項目5）。MonthView は
                    詰めた形のとき、曜日の見出し＋6週ぶんがちょうど収まる高さを
                    自分で MinHeight に持つ（MonthView.xaml.cs の FitCells）ので、
                    Auto 行はそれをそのまま初期の高さにする。固定割合だと画面の高さが
                    変わったとき「下に余白が余る」「6週目が切れる」が起きるが、Auto なら
                    幅が変わらない限り常にちょうど収まる。一度つまんで変えたら
                    SidebarLayout.xaml.cs の SaveShare がその割合を控え、次回からは
                    RestoreShare が Star 比で組む（ここでの Height 指定は初回だけの話）。

                    畳んでいる（IsSlimCalendarCollapsed）あいだは、SidebarLayout.xaml.cs の
                    ApplyCollapsedState が CalendarRow の Height／MinHeight を 0 にし、
                    MonthView と GridSplitter を Collapsed にする（項目2）。開いたときは
                    同じ場所から RestoreShare を呼び直すので、つまんで変えた高さ・
                    まだ変えていない Auto の高さのどちらも、畳む前と同じに戻る
                -->
                <RowDefinition x:Name="CalendarRow" Height="Auto" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="ListRow" Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <!--
                上：ひと月の並び。中央のカレンダーが何を出していても、ここは月。
                ここだけ別の月暦を持つので、中央とは独立して送れる
            -->
            <views:MonthView x:Name="SlimMonthView" Grid.Row="0" DataContext="{Binding SlimMonth}" />

            <!--
                畳んでいる間、仕切りが掴めてしまわないこと（項目2）。Visibility を
                Collapsed にするだけで当たり判定ごと消える（IsHitTestVisible を別に
                切る必要が無い）。IsEnabled も併せて落とし、フォーカスやキー操作からも外す
            -->
            <GridSplitter Grid.Row="1" x:Name="Split" Height="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource LineBrush}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                          Cursor="SizeNS" />

            <!--
                下：選んだ日の予定とタスク。

                タブで切り替えていたが、予定を見ているあいだタスクが見えない。
                右ペインと同じで、節を縦に続けてひとつのスクロールに入れる。
                どちらも一度に目に入る。
            -->
            <DockPanel Grid.Row="2" Background="{DynamicResource PanelBrush}">
                <!-- 選択した日の見出し。どの日の予定を見ているのか分からなくなる -->
                <Border DockPanel.Dock="Top" Padding="10,6,10,4"
                        DataContext="{Binding SelectedDay}">
                    <DockPanel>
                        <!--
                            日送り（項目4）。右ペイン（MainWindow.xaml の日付ヘッダ）と
                            同じ「◀ ▶」を、日付＋印（マイルストーン）の右に置く。中央の
                            カレンダーが出ていないとき（ShowsSlimDayNav）だけ出す。中央も
                            出ているときは、押すとそちらのビューを送ってしまい「日を
                            1日ずつ送る」にならないため（MainViewModel.GoToPrevious/Next の
                            分岐と同じ理由）。

                            DataContext はここでは SelectedDay なので、コマンドは
                            UserControl（＝この SidebarLayout、DataContext は
                            MainViewModel）から引く。新しい移動の仕組みは作らず、右ペインと
                            同じ PreviousCommand／NextCommand にそのまま繋ぐ
                        -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="4,0,0,0"
                                    Visibility="{Binding DataContext.ShowsSlimDayNav,
                                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                                 Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource SmallIconButtonStyle}" ToolTip="前の日"
                                    Command="{Binding DataContext.PreviousCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform"
                                      Width="12" Height="12"
                                      Stroke="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button Style="{StaticResource SmallIconButtonStyle}" ToolTip="次の日"
                                    Command="{Binding DataContext.NextCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform"
                                      Width="12" Height="12"
                                      Stroke="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>

                        <!--
                            日付の横は、実働日の通し番号ではなく実働日カレンダー
                            （inaCalendar）の中身。仕様期限や中日程は、その日に
                            何があるかを決める手がかりになる。通し番号はカレンダーの
                            マスと右ペインに出ている
                        -->
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Milestones}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        右ペイン・月ビューと同じ見た目なので、挙動も揃える。
                                        操作説明のツールチップは外した（項目12）。バッジの
                                        文字がそのままマイルストーン名なので、切れて読めなく
                                        なる題も無い
                                    -->
                                    <Border CornerRadius="3" Padding="5,0" Margin="4,0,0,0"
                                            Cursor="Hand"
                                            Tag="{Binding DataContext,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                            ContextMenu="{StaticResource MilestoneMenu}"
                                            MouseLeftButtonDown="OnMilestoneClicked"
                                            Background="{Binding Name,
                                                        Converter={StaticResource MilestoneBrush},
                                                        ConverterParameter=Face}">
                                        <TextBlock Style="{StaticResource MicroTextStyle}" Text="{Binding Name}"
                                                   FontWeight="SemiBold" LineHeight="15"
                                                   Foreground="{Binding Name,
                                                               Converter={StaticResource MilestoneBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--
                            項目3。右パネルの日付ヘッダ（MainWindow.xaml の .dhead）と
                            同じ SubheadingTextStyle（15px）に揃える。以前は BodyTextStyle
                            （12.5px）で1段小さかった。幅160pxまで細くなるが、
                            TextTrimming="CharacterEllipsis" は BodyTextStyle 由来で
                            そのまま効くので、切れる場合は省略記号で収まる
                        -->
                        <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="{Binding Title}" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource InkBrush}" />
                    </DockPanel>
                </Border>

                <!--
                    クイック入力（項目4）。以前は最下段のフッターにあり、一覧を挟んで
                    選んだ日から遠かった（「日を選ぶ→その日に何か足す」という動きに
                    合わない）。日付ヘッダのすぐ下・一覧の上へ移す。右ペイン
                    （MainWindow.xaml）とも置き場所を揃える。

                    DockPanel.Dock="Top" で固定するので、下のスクロール領域（一覧）が
                    伸び縮みしても位置は動かない。下端に罫線を引いて、ここから下が
                    一覧だとひと目で分かるまとまりにする（Themes/Controls.xaml の
                    LineBrush を他の見出し境界と同じ使い方で）。

                    「＋予定／＋タスク」のアイコンボタンは外した（項目1）。予定・タスク
                    それぞれの節の見出しのすぐ下に「＋ 予定を追加」「✓＋ タスクを追加」の
                    行を置いたので、同じことをする道が2つにならないようにする。外した
                    ぶん入力欄が広くなる（右マージンを59pxから無しへ）
                -->
                <Border DockPanel.Dock="Top" Padding="10,8"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
                    <StackPanel>
                        <TextBox x:Name="QuickInputBox" Style="{StaticResource QuickInputBoxStyle}"
                                 Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="1行で予定を追加します（Enter・Esc で打ちかけを消します）&#10;日付を書かなければ、選んでいる日に入ります&#10;（「明日」「来週」「3日後」などの相対語は今日基準）&#10;&#10;例: 明日15時 打合せ @会議室A&#10;　　来週の火曜 10時から11時半 面談&#10;　　来月15日 締切&#10;　　15時 打合せ（日付なし→いま選んでいる日）"
                                 KeyDown="OnQuickKeyDown" />

                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding QuickPreview}" Margin="2,3,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Ink3Brush}"
                                   Visibility="{Binding QuickPreview,
                                                Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,2,10,8"
                              DataContext="{Binding SelectedDay}">
                    <StackPanel>
                        <DockPanel Margin="0,2,0,2">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" DockPanel.Dock="Right" Text="{Binding EventCountText}"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource Ink3Brush}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="予定"
                                       Foreground="{DynamicResource Ink3Brush}" />
                        </DockPanel>

                        <!--
                            「＋ 予定を追加」（項目1）。作られる場所（この一覧）の真上に置く。
                            右パネル（MainWindow.xaml）と同じ形・同じ SectionAddRowStyle。
                            DataContext はここでは SelectedDay なので、コマンドは UserControl
                            （＝この SidebarLayout、DataContext は MainViewModel）から引く
                        -->
                        <Button Style="{StaticResource SectionAddRowStyle}" Padding="0,4"
                                Command="{Binding DataContext.AddEventCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconEventAdd}" Stretch="Uniform" Width="14" Height="14"
                                      Margin="0,0,8,0" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="予定を追加" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        右ペイン・月ビューと同じく、右クリックで編集・削除。ホバーでゴミ箱も出す。
                                        操作説明のツールチップは外した（項目12）。切れた題の全文は
                                        下のタイトルの ToolTip="{Binding Title}" で読める
                                    -->
                                    <Border x:Name="Row" Background="Transparent" Padding="0,4" Cursor="Hand"
                                            Tag="{Binding DataContext,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                            ContextMenu="{StaticResource EventRowMenu}"
                                            MouseLeftButtonDown="OnEventClicked">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="3" CornerRadius="2"
                                                    Margin="0,1,8,1"
                                                    Background="{Binding Color,
                                                                Converter={StaticResource EventColorBrush}}" />

                                            <Button x:Name="Delete" DockPanel.Dock="Right"
                                                    Style="{StaticResource RowDeleteButtonStyle}"
                                                    Command="{Binding DataContext.DeleteEventCommand,
                                                              RelativeSource={RelativeSource
                                                              AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconTrash}" Stretch="Uniform"
                                                      Width="12" Height="12"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Stroke="{Binding Foreground,
                                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>

                                            <TextBlock Style="{StaticResource CaptionTextStyle}" DockPanel.Dock="Left" Text="{Binding TimeText}"
                                                       Width="44" LineHeight="16"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{DynamicResource Ink2Brush}" />
                                            <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding Title}" LineHeight="16"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}"
                                                       Foreground="{DynamicResource InkBrush}" />
                                        </DockPanel>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource SunkenBrush}" />
                                            <Setter TargetName="Delete" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 0件のときは無言にしない（項目12） -->
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="予定はありません。" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ink3Brush}"
                                   Visibility="{Binding HasNoEvents, Converter={StaticResource BoolToVisibility}}" />

                        <DockPanel Margin="0,10,0,2">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" DockPanel.Dock="Right" Text="{Binding TaskCountText}"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource Ink3Brush}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="タスク"
                                       Foreground="{DynamicResource Ink3Brush}" />
                        </DockPanel>

                        <!-- 「✓＋ タスクを追加」（項目1）。予定の行と同じ理由・同じ形 -->
                        <Button Style="{StaticResource SectionAddRowStyle}" Padding="0,4"
                                Command="{Binding DataContext.AddTaskCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTaskAdd}" Stretch="Uniform" Width="14" Height="14"
                                      Margin="0,0,8,0" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="タスクを追加" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <ItemsControl ItemsSource="{Binding Tasks}"
                                      ItemTemplate="{StaticResource SlimTaskRowTemplate}" />

                        <!-- 0件のときは無言にしない（項目12） -->
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="タスクはありません。" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ink3Brush}"
                                   Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisibility}}" />

                        <!--
                            期限なしのタスク（項目B）。期限を付けずに作ったタスクは
                            右ペインの「タスク」にも検索にも出ず、保存されるのに
                            二度と見えなくなっていた。0件のときは節ごと畳む
                            （ShowsNoDueTasks）。行の見た目・挙動は上の「タスク」と
                            同じ SlimTaskRowTemplate を使い回す

                            この節には「＋ タスクを追加」の行を置いていない（項目1）。
                            0件のときは見出しごと畳むので、置いても「最初の1件を作る」
                            場面でだけ隠れて使えない（右パネルと同じ判断。MainWindow.xaml
                            を参照）。期限なしで作りたいときは、上の「タスクを追加」から
                            開いた編集画面で「期限を付ける」を外せばよい
                        -->
                        <StackPanel Visibility="{Binding ShowsNoDueTasks, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,10,0,2">
                                <TextBlock Style="{StaticResource CaptionTextStyle}" DockPanel.Dock="Right" Text="{Binding NoDueTaskCount}"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource Ink3Brush}" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="期限なしのタスク"
                                           Foreground="{DynamicResource Ink3Brush}" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding NoDueTasks}"
                                          ItemTemplate="{StaticResource SlimTaskRowTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
