<!--
    スリムパネル。4つ目のパネルとして、ほかと並べて置く。

    上にひと月の並び、下に選んだ日の予定とタスク。仕切りはドラッグで高さを
    変えられる。細いので月だけにしてある（週や日は時間軸が要るぶん、この幅では
    読めない）。マスには予定の名前を出さず、入っていることを色で示す。

    幅では切り替えない。出すかどうかは、ほかのパネルと同じく手で選ぶ。
-->
<UserControl x:Class="SlideinaCalendar.App.Views.SidebarLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
             xmlns:views="clr-namespace:SlideinaCalendar.App.Views"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:EventColorBrushConverter x:Key="EventColorBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:MilestoneBrushConverter x:Key="MilestoneBrush" />

        <!--
            予定行の右クリックメニュー。右ペイン・月ビューにある EventChipMenu 相当。
            ContextMenu は画面の木から外れて出るので、Tag に MainViewModel を入れて
            PlacementTarget 経由で引く。
        -->
        <ContextMenu x:Key="EventRowMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditEventCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="削除"
                      Command="{Binding PlacementTarget.Tag.DeleteEventCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- 日付の行のラベル（マイルストーン）の右クリックメニューは
             Themes/Controls.xaml の共有 MilestoneMenu を使う（項目13） -->
        <!--
            右ペインのタスク行（.tk）。「タスク」「期限なしのタスク」の両方の節で
            使い回す（項目B）。右ペインと見た目を揃える（項目13）。チェックの
            スタイルと済み色を右ペインと同じ TaskCheckBoxStyle / DoneBrush に統一する
        -->
        <DataTemplate x:Key="SlimTaskRowTemplate">
            <Border Background="Transparent" Padding="0,4" Cursor="Hand"
                    MouseLeftButtonDown="OnTaskClicked">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0"
                              Style="{StaticResource TaskCheckBoxStyle}"
                              IsChecked="{Binding IsDone, Mode=OneWay}"
                              Command="{Binding DataContext.ToggleTaskDoneCommand,
                                        RelativeSource={RelativeSource
                                        AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" x:Name="Title" Text="{Binding Title}" LineHeight="16"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}"
                                   Foreground="{DynamicResource InkBrush}" />
                        <!-- 期限なしのときは空行を残さない -->
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding DueText}"
                                   LineHeight="14"
                                   Foreground="{DynamicResource Ink3Brush}"
                                   Visibility="{Binding DueText,
                                                Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Title" Property="TextDecorations"
                            Value="Strikethrough" />
                    <Setter TargetName="Title" Property="Foreground"
                            Value="{DynamicResource DoneBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- フッター。右ペインと同じで、1行打って足せる。実働日計算もここから -->
        <Border DockPanel.Dock="Bottom" Padding="10,8"
                Background="{DynamicResource PanelBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <StackPanel>
                <TextBox x:Name="QuickInputBox" Style="{StaticResource QuickInputBoxStyle}"
                         Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="1行で予定を追加します（Enter・Esc で打ちかけを消します）&#10;日付を書かなければ、選んでいる日に入ります&#10;（「明日」「来週」「3日後」などの相対語は今日基準）&#10;&#10;例: 明日15時 打合せ @会議室A&#10;　　来週の火曜 10時から11時半 面談&#10;　　来月15日 締切&#10;　　15時 打合せ（日付なし→いま選んでいる日）"
                         KeyDown="OnQuickKeyDown" />

                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding QuickPreview}" Margin="2,3,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Ink3Brush}"
                           Visibility="{Binding QuickPreview,
                                        Converter={StaticResource NullToVisibility}}" />

                <UniformGrid Rows="1" Columns="2" Margin="0,7,0,0">
                    <Button Content="＋ 予定" Margin="0,0,3,0"
                            Style="{StaticResource CalcButtonStyle}"
                            Command="{Binding AddEventCommand}" />
                    <Button Content="＋ タスク" Margin="3,0,0,0"
                            Style="{StaticResource CalcButtonStyle}"
                            Command="{Binding AddTaskCommand}" />
                </UniformGrid>

                <Button Content="実働日計算を開く" Margin="0,7,0,0"
                        Style="{StaticResource CalcButtonStyle}"
                        Command="{Binding OpenWorkingDayCalculatorCommand}" />
            </StackPanel>
        </Border>

        <!--
            選んでいる日と送り。ここは月だけを出すので、ビューの切り替えは置かない。
            実働日の通し番号は下の欄に出るので、ここでは繰り返さない
        -->
        <!--
            「ビュー見出し」の Padding を他ビューと揃える（項目20）。ただし文字サイズは
            14px のまま残す。ここは「今日」「◀」「▶」の3つのボタンと1行に同居しており、
            パネルは160〜200px まで細くなる。16px に上げるとボタンを押しのけて
            見出しが欠ける恐れがあり、WPF は Linux では確かめられないので寄せない
            （項目19の「判断に迷ったら寄せない」に倣う）
        -->
        <Border DockPanel.Dock="Top" Padding="12,8"
                Background="{DynamicResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!--
                        スリムパネルだけのときは、ツールバーの「今日」が出ていない。
                        ここが唯一の戻り口になる
                    -->
                    <Button Content="今日" Margin="0,0,6,0"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding TodayCommand}"
                            Visibility="{Binding ShowsSlimToday,
                                         Converter={StaticResource BoolToVisibility}}" />

                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="前の月"
                            Command="{Binding SlimPreviousCommand}">
                        <Path Data="{StaticResource IconChevronLeft}" Stretch="Uniform"
                              Width="15" Height="15"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="次の月"
                            Command="{Binding SlimNextCommand}">
                        <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform"
                              Width="15" Height="15"
                              Stroke="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>

                <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="14" VerticalAlignment="Center" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource InkBrush}">
                    <Run Text="{Binding SlimTitleYear, Mode=OneWay}" FontSize="11" FontWeight="Medium"
                         Foreground="{DynamicResource Ink3Brush}" /><Run Text=" " /><Run
                         Text="{Binding SlimTitleMonth, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 上下の割り振りは手で変えられる。既定はカレンダーを広めに取る -->
                <RowDefinition x:Name="CalendarRow" Height="3*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="ListRow" Height="2*" MinHeight="120" />
            </Grid.RowDefinitions>

            <!--
                上：ひと月の並び。中央のカレンダーが何を出していても、ここは月。
                ここだけ別の月暦を持つので、中央とは独立して送れる
            -->
            <views:MonthView Grid.Row="0" DataContext="{Binding SlimMonth}" />

            <GridSplitter Grid.Row="1" x:Name="Split" Height="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource LineBrush}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                          Cursor="SizeNS" />

            <!--
                下：選んだ日の予定とタスク。

                タブで切り替えていたが、予定を見ているあいだタスクが見えない。
                右ペインと同じで、節を縦に続けてひとつのスクロールに入れる。
                どちらも一度に目に入る。
            -->
            <DockPanel Grid.Row="2" Background="{DynamicResource PanelBrush}">
                <!-- 選択した日の見出し。どの日の予定を見ているのか分からなくなる -->
                <Border DockPanel.Dock="Top" Padding="10,6,10,4"
                        DataContext="{Binding SelectedDay}">
                    <DockPanel>
                        <!--
                            日付の横は、実働日の通し番号ではなく実働日カレンダー
                            （inaCalendar）の中身。仕様期限や中日程は、その日に
                            何があるかを決める手がかりになる。通し番号はカレンダーの
                            マスと右ペインに出ている
                        -->
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Milestones}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        右ペイン・月ビューと同じ見た目なので、挙動も揃える。
                                        操作説明のツールチップは外した（項目12）。バッジの
                                        文字がそのままマイルストーン名なので、切れて読めなく
                                        なる題も無い
                                    -->
                                    <Border CornerRadius="3" Padding="5,0" Margin="4,0,0,0"
                                            Cursor="Hand"
                                            Tag="{Binding DataContext,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                            ContextMenu="{StaticResource MilestoneMenu}"
                                            MouseLeftButtonDown="OnMilestoneClicked"
                                            Background="{Binding Name,
                                                        Converter={StaticResource MilestoneBrush},
                                                        ConverterParameter=Face}">
                                        <TextBlock Style="{StaticResource MicroTextStyle}" Text="{Binding Name}"
                                                   FontWeight="SemiBold" LineHeight="15"
                                                   Foreground="{Binding Name,
                                                               Converter={StaticResource MilestoneBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding Title}" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource InkBrush}" />
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,2,10,8"
                              DataContext="{Binding SelectedDay}">
                    <StackPanel>
                        <DockPanel Margin="0,2,0,2">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" DockPanel.Dock="Right" Text="{Binding EventCountText}"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource Ink3Brush}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="予定"
                                       Foreground="{DynamicResource Ink3Brush}" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        右ペイン・月ビューと同じく、右クリックで編集・削除。ホバーでゴミ箱も出す。
                                        操作説明のツールチップは外した（項目12）。切れた題の全文は
                                        下のタイトルの ToolTip="{Binding Title}" で読める
                                    -->
                                    <Border x:Name="Row" Background="Transparent" Padding="0,4" Cursor="Hand"
                                            Tag="{Binding DataContext,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                            ContextMenu="{StaticResource EventRowMenu}"
                                            MouseLeftButtonDown="OnEventClicked">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="3" CornerRadius="2"
                                                    Margin="0,1,8,1"
                                                    Background="{Binding Color,
                                                                Converter={StaticResource EventColorBrush}}" />

                                            <Button x:Name="Delete" DockPanel.Dock="Right"
                                                    Style="{StaticResource RowDeleteButtonStyle}"
                                                    Command="{Binding DataContext.DeleteEventCommand,
                                                              RelativeSource={RelativeSource
                                                              AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconTrash}" Stretch="Uniform"
                                                      Width="12" Height="12"
                                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Stroke="{Binding Foreground,
                                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>

                                            <TextBlock Style="{StaticResource CaptionTextStyle}" DockPanel.Dock="Left" Text="{Binding TimeText}"
                                                       Width="44" LineHeight="16"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{DynamicResource Ink2Brush}" />
                                            <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding Title}" LineHeight="16"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}"
                                                       Foreground="{DynamicResource InkBrush}" />
                                        </DockPanel>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource SunkenBrush}" />
                                            <Setter TargetName="Delete" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 0件のときは無言にしない（項目12） -->
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="予定はありません。下の欄に1行打つと追加できます" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ink3Brush}"
                                   Visibility="{Binding HasNoEvents, Converter={StaticResource BoolToVisibility}}" />

                        <DockPanel Margin="0,10,0,2">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" DockPanel.Dock="Right" Text="{Binding TaskCountText}"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource Ink3Brush}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="タスク"
                                       Foreground="{DynamicResource Ink3Brush}" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Tasks}"
                                      ItemTemplate="{StaticResource SlimTaskRowTemplate}" />

                        <!-- 0件のときは無言にしない（項目12） -->
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="タスクはありません。下の欄に1行打つと追加できます" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ink3Brush}"
                                   Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisibility}}" />

                        <!--
                            期限なしのタスク（項目B）。期限を付けずに作ったタスクは
                            右ペインの「タスク」にも検索にも出ず、保存されるのに
                            二度と見えなくなっていた。0件のときは節ごと畳む
                            （ShowsNoDueTasks）。行の見た目・挙動は上の「タスク」と
                            同じ SlimTaskRowTemplate を使い回す
                        -->
                        <StackPanel Visibility="{Binding ShowsNoDueTasks, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,10,0,2">
                                <TextBlock Style="{StaticResource CaptionTextStyle}" DockPanel.Dock="Right" Text="{Binding NoDueTaskCount}"
                                           Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource Ink3Brush}" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="期限なしのタスク"
                                           Foreground="{DynamicResource Ink3Brush}" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding NoDueTasks}"
                                          ItemTemplate="{StaticResource SlimTaskRowTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
