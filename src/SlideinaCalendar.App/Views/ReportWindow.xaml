<!--
    取り込みの結果を見せる。
    ログが数十行になることがあるので、MessageBox ではなく折り返して読める窓にする。
-->
<Window x:Class="SlideinaCalendar.App.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/app.png"
        Width="560" Height="420" MinWidth="360" MinHeight="240"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="12.5"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource InkBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,13,16,11"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" />
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <Button Content="閉じる" Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Right" IsCancel="True" IsDefault="True" />
        </Border>

        <Border Margin="16,14" CornerRadius="5"
                Background="{DynamicResource BackgroundBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
            <TextBox x:Name="Body" IsReadOnly="True" BorderThickness="0" Padding="10,8"
                     Background="Transparent" Foreground="{DynamicResource InkBrush}"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Typography.NumeralAlignment="Tabular" />
        </Border>
    </DockPanel>
</Window>
