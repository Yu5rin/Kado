<!--
    カレンダー（タスクリスト）の編集画面。
    Google に繋がなくても、このアプリだけで分類を作れるようにするためのもの。
-->
<Window x:Class="SlideinaCalendar.App.Views.CalendarEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
        Title="{Binding HeaderText}" Width="380" SizeToContent="Height"
        Icon="/Assets/app.png"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource InkBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:HexBrushConverter x:Key="HexBrush" />
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,13,16,11"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock Text="{Binding HeaderText}" Style="{StaticResource SubheadingTextStyle}" FontWeight="SemiBold" />
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="キャンセル" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                            IsCancel="True" />
                    <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True" IsEnabled="{Binding CanSave}"
                            Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>

                <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,10,0"
                           Foreground="{DynamicResource SundayBrush}"
                           Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibility}}" />
            </DockPanel>
        </Border>

        <StackPanel Margin="16,14">
            <TextBlock Text="名前" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="NameBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsNameLocked}">
                <TextBox.Style>
                    <!-- 変えられないときは文字を薄くする。読んだりコピーはできる -->
                    <Style TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- なぜ変えられないのかを書く。灰色の欄だけでは理由が分からない -->
            <TextBlock Text="{Binding NameLockReason}" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Ink3Brush}"
                       Visibility="{Binding NameLockReason, Converter={StaticResource NullToVisibility}}" />

            <Border Height="12" />

            <!-- タスクリストは色を持たない。Google Tasks 側にも色の概念が無い -->
            <StackPanel Visibility="{Binding HasColor, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="色" Style="{StaticResource FieldLabelStyle}" />
                <ItemsControl ItemsSource="{Binding Colors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Color" Margin="0,0,8,8" ToolTip="{Binding Name}"
                                         Cursor="Hand"
                                         IsChecked="{Binding Value, Mode=OneWay,
                                                     Converter={StaticResource ColorChoiceIsSelected}}"
                                         Command="{Binding DataContext.PickColorCommand,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding Value}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Ring" Width="30" Height="30" CornerRadius="6"
                                                Padding="4" Background="Transparent"
                                                BorderThickness="2" BorderBrush="Transparent">
                                            <Border CornerRadius="3"
                                                    Background="{Binding Value,
                                                                Converter={StaticResource HexBrush}}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ring" Property="Background"
                                                        Value="{DynamicResource SunkenBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
