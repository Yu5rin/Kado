<!--
    予定の編集画面。モックに該当する画面は無いので、ツールバーや右ペインで使っている
    部品の寸法（枠 1px / 角丸 5 / 高さ 28 / 見出し 11px 補助色）に合わせて組んである。

    保存できない間はボタンを止め、理由を下に出す。押せない理由が分からないのが一番困る。
-->
<Window x:Class="SlideinaCalendar.App.Views.EventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
        xmlns:vm="clr-namespace:SlideinaCalendar.Presentation.ViewModels;assembly=SlideinaCalendar.Presentation"
        Title="{Binding HeaderText}" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="12.5"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource InkBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
    </Window.Resources>


    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,13,16,11"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock Text="{Binding HeaderText}" FontSize="15" FontWeight="SemiBold" />
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ValidationMessage}"
                           FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource SundayBrush}"
                           Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibility}}" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取り消し" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                            IsCancel="True" />
                    <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True" IsEnabled="{Binding CanSave}"
                            Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="16,14">
            <TextBlock Text="タイトル" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="TitleBox" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,12"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="日付" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker Style="{StaticResource FieldDatePickerStyle}"
                                SelectedDate="{Binding Date, Converter={StaticResource DateOnlyToDateTime}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <CheckBox Content="終日" Margin="0,0,0,6"
                              IsChecked="{Binding IsAllDay}" />
                    <CheckBox Content="複数日" IsChecked="{Binding IsMultiDay}" />
                </StackPanel>
            </Grid>

            <!-- 終日なら時刻は使わない。欄ごと畳んで、無効な入力欄を残さない -->
            <Grid Margin="0,0,0,12"
                  Visibility="{Binding IsAllDay, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="開始時刻" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource FieldTextBoxStyle}"
                             Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="終了時刻" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Style="{StaticResource FieldTextBoxStyle}"
                             Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,12"
                        Visibility="{Binding IsMultiDay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="終了日" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker Style="{StaticResource FieldDatePickerStyle}"
                            SelectedDate="{Binding EndDate, Converter={StaticResource DateOnlyToDateTime}}" />
            </StackPanel>

            <TextBlock Text="場所" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,12"
                     Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,0,0,12"
                  Visibility="{Binding Calendars, Converter={StaticResource NullToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="カレンダー" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                              ItemsSource="{Binding Calendars}"
                              SelectedItem="{Binding CalendarId}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="色" Style="{StaticResource FieldLabelStyle}" />
                    <Border CornerRadius="5" ClipToBounds="True"
                            BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="藍" Style="{StaticResource SegmentButtonStyle}"
                                         GroupName="Accent" Padding="11,0"
                                         IsChecked="{Binding Accent, Converter={StaticResource EnumToBool},
                                                     ConverterParameter=Default}" />
                            <RadioButton Content="緑" Style="{StaticResource SegmentButtonStyle}"
                                         GroupName="Accent" Padding="11,0"
                                         IsChecked="{Binding Accent, Converter={StaticResource EnumToBool},
                                                     ConverterParameter=Green}" />
                            <RadioButton Content="琥珀" Style="{StaticResource SegmentButtonStyle}"
                                         GroupName="Accent" Padding="11,0" BorderThickness="0"
                                         IsChecked="{Binding Accent, Converter={StaticResource EnumToBool},
                                                     ConverterParameter=Amber}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="メモ" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Style="{StaticResource FieldNoteBoxStyle}"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </DockPanel>
</Window>
