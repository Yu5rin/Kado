<!--
    予定の編集画面。項目は Google Calendar のイベントに合わせてある
    （タイトル＝summary／説明＝description／場所＝location／繰り返し＝recurrence）。

    入れやすさを優先した作り。
      ・日付欄は中身ぶんの幅に留め、時刻と横に並べる
      ・時刻は打っても選んでもよい。「9」「930」「9:30」のどれでも読む
      ・上下キーとホイールで15分ずつ動かせる
      ・終了の候補は「10:30（1時間30分）」と長さを添える
      ・開始を動かすと終了も同じ長さのまま付いてくる

    色の欄は置かない。所属カレンダーで決まるので1件ずつは選ばせない。
-->
<Window x:Class="SlideinaCalendar.App.Views.EventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
        Title="{Binding HeaderText}" Width="440" SizeToContent="Height"
        Icon="/Assets/app.png"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="12.5"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource InkBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,13,16,11"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock Text="{Binding HeaderText}" FontSize="15" FontWeight="SemiBold" />
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取り消し" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                            IsCancel="True" />
                    <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True" IsEnabled="{Binding CanSave}"
                            Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>

                <TextBlock Text="{Binding ValidationMessage}" FontSize="11" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,10,0"
                           Foreground="{DynamicResource SundayBrush}"
                           Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibility}}" />
            </DockPanel>
        </Border>

        <StackPanel Margin="16,14">
            <TextBlock Text="タイトル" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="TitleBox" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,12"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="終日" IsChecked="{Binding IsAllDay}" Margin="0,0,16,0" />
                <CheckBox Content="複数日にまたがる" IsChecked="{Binding IsMultiDay}" />
            </StackPanel>

            <!-- 単日：日付と時刻を横に並べる。日付欄は中身ぶんの幅で足りる -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                        Visibility="{Binding IsMultiDay, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="日付" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker Width="128" Style="{StaticResource FieldDatePickerStyle}"
                                SelectedDate="{Binding Date, Converter={StaticResource DateOnlyToDateTime}}" />
                </StackPanel>

                <StackPanel Margin="0,0,10,0"
                            Visibility="{Binding IsAllDay, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="開始" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Width="86" Style="{StaticResource TimeComboBoxStyle}"
                              ItemsSource="{Binding StartTimeOptions}"
                              Text="{Binding StartTimeText, UpdateSourceTrigger=LostFocus}"
                              PreviewKeyDown="OnTimeKeyDown" PreviewMouseWheel="OnTimeWheel"
                              ToolTip="「9」「930」「9:30」のどれでも入ります。上下キーで15分ずつ" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsAllDay, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="終了" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Tag="End" Width="86" Style="{StaticResource TimeComboBoxStyle}"
                              ItemsSource="{Binding EndTimeOptions}" DisplayMemberPath="Label"
                              Text="{Binding EndTimeText, UpdateSourceTrigger=LostFocus}"
                              PreviewKeyDown="OnTimeKeyDown" PreviewMouseWheel="OnTimeWheel"
                              ToolTip="長さから選べます。上下キーで15分ずつ" />
                </StackPanel>
            </StackPanel>

            <!-- 複数日：開始日と終了日を横に並べる -->
            <StackPanel Margin="0,0,0,12"
                        Visibility="{Binding IsMultiDay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="開始日" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker Width="128" Style="{StaticResource FieldDatePickerStyle}"
                                    SelectedDate="{Binding Date, Converter={StaticResource DateOnlyToDateTime}}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="終了日" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker Width="128" Style="{StaticResource FieldDatePickerStyle}"
                                    SelectedDate="{Binding EndDate, Converter={StaticResource DateOnlyToDateTime}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding IsAllDay, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="開始時刻" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Width="86" Style="{StaticResource TimeComboBoxStyle}"
                                  ItemsSource="{Binding StartTimeOptions}"
                                  Text="{Binding StartTimeText, UpdateSourceTrigger=LostFocus}"
                                  PreviewKeyDown="OnTimeKeyDown" PreviewMouseWheel="OnTimeWheel" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="終了時刻" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Tag="End" Width="86" Style="{StaticResource TimeComboBoxStyle}"
                                  ItemsSource="{Binding EndTimeOptions}" DisplayMemberPath="Label"
                                  Text="{Binding EndTimeText, UpdateSourceTrigger=LostFocus}"
                                  PreviewKeyDown="OnTimeKeyDown" PreviewMouseWheel="OnTimeWheel" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="繰り返し" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Width="176" Style="{StaticResource FieldComboBoxStyle}"
                              ItemsSource="{Binding RecurrenceOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Kind"
                              SelectedValue="{Binding Recurrence}" />
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="通知" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Width="140" Style="{StaticResource FieldComboBoxStyle}"
                              ItemsSource="{Binding NotifyOptions}"
                              SelectedValuePath="Value" SelectedValue="{Binding Notify}"
                              ToolTip="ふつうはカレンダー側（左の一覧のベル）で決めます">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Visibility="{Binding Calendars, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="カレンダー" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Width="176" Style="{StaticResource FieldComboBoxStyle}"
                              ItemsSource="{Binding Calendars}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding CalendarId}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="場所" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,12"
                     Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 資料や図面の置き場所。説明欄に書くと本文と混ざって拾いにくい -->
            <TextBlock Text="URL" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,12"
                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="説明" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Style="{StaticResource FieldNoteBoxStyle}"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </DockPanel>
</Window>
