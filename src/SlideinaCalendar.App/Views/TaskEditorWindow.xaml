<!--
    タスクの編集画面。予定の編集画面と同じ寸法で組んである。

    期限は「決まっていない」を持てる（要件書 3.1）。日付欄を空にはできないので、
    期限を付けるかどうかのチェックを別に置き、外すと日付欄を止める。
-->
<Window x:Class="SlideinaCalendar.App.Views.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
        Title="{Binding HeaderText}" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="12.5"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource InkBrush}">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
    </Window.Resources>


    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,13,16,11"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock Text="{Binding HeaderText}" FontSize="15" FontWeight="SemiBold" />
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,11"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ValidationMessage}"
                           FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource SundayBrush}"
                           Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibility}}" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取り消し" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                            IsCancel="True" />
                    <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True" IsEnabled="{Binding CanSave}"
                            Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="16,14">
            <TextBlock Text="タイトル" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="TitleBox" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,12"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="期限" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker Style="{StaticResource FieldDatePickerStyle}"
                                IsEnabled="{Binding HasDue}"
                                SelectedDate="{Binding Due, Converter={StaticResource DateOnlyToDateTime}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <CheckBox Content="期限を付ける" Margin="0,0,0,6" IsChecked="{Binding HasDue}" />
                    <CheckBox Content="完了" IsChecked="{Binding IsDone}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,12"
                        Visibility="{Binding TaskLists, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="タスクリスト" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                          ItemsSource="{Binding TaskLists}"
                          SelectedItem="{Binding TaskListId}" />
            </StackPanel>

            <TextBlock Text="メモ" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Style="{StaticResource FieldNoteBoxStyle}"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </DockPanel>
</Window>
