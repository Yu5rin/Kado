<!--
    時間軸の1列。週ビューと日ビューで使い回す。

      .hcell  1時間ぶんの高さ（週 44px ／ 日 56px）/ 下に 1px の罫線
      .eblk   左に 3px の帯 / radius 3 / padding 2 5 / 時刻は 9.5px
      .eblk.task  点線枠。予定ではなくタスクの作業時間（要件書 5.4）

    ブロックは Canvas ではなく余白で置く。横に伸ばしたいため。
-->
<UserControl x:Class="SlideinaCalendar.App.Views.TimelineColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlideinaCalendar.App.Converters"
             x:Name="Root">

    <UserControl.Resources>
        <conv:TimelineOffsetToMarginConverter x:Key="TimelineOffsetToMargin" />
        <conv:EventColorBrushConverter x:Key="EventColorBrush" />
        <conv:EventColorFaceConverter x:Key="EventColorFace" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!--
            時間軸に置かれた1件の右クリックメニュー。
            ContextMenu は画面の木から外れて出るので、祖先をたどっても Window に届かない。
            Tag に MainViewModel を入れておき、PlacementTarget 経由で引く。
        -->
        <ContextMenu x:Key="BlockMenu">
            <MenuItem Header="編集"
                      Command="{Binding PlacementTarget.Tag.EditBlockCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

            <!-- 作業時間ブロックは予定ではないので、ここからは消せない -->
            <Separator Visibility="{Binding PlacementTarget.DataContext.IsWorkBlock,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu},
                                    Converter={StaticResource InverseBoolToVisibility}}" />
            <MenuItem Header="削除"
                      Visibility="{Binding PlacementTarget.DataContext.IsWorkBlock,
                                   RelativeSource={RelativeSource AncestorType=ContextMenu},
                                   Converter={StaticResource InverseBoolToVisibility}}"
                      Command="{Binding PlacementTarget.Tag.DeleteBlockCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                         RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </UserControl.Resources>

    <Border x:Name="Column" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}">
        <Grid>
            <!-- 1時間ごとの罫線 -->
            <ItemsControl ItemsSource="{Binding HourLabels, ElementName=Root}" IsHitTestVisible="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="{Binding RowHeight, ElementName=Root}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource LineBrush}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                今の時刻。今日の列にだけ引く。
                線の左端に丸を置くのは、どの列の線なのかを一目で分かるようにするため。
                丸は線より背が高いので、上下にはみ出して描かれる
            -->
            <Grid VerticalAlignment="Top" Height="1.5" IsHitTestVisible="False" Panel.ZIndex="2"
                  Margin="{Binding NowOffset, ElementName=Root,
                           Converter={StaticResource TimelineOffsetToMargin}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsToday}" Value="True" />
                                    <Condition Binding="{Binding ShowNow, ElementName=Root}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="{DynamicResource NowLineBrush}" />
                <Ellipse Width="10" Height="10" Fill="{DynamicResource NowLineBrush}"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-5,0,0,0" />
            </Grid>

            <!-- 予定と作業時間ブロック。重ねて置くので入れ物は Grid -->
            <ItemsControl ItemsSource="{Binding Blocks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Block" VerticalAlignment="Top" CornerRadius="3" Padding="5,2"
                                Cursor="Hand" ToolTip="{Binding Tooltip}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                ContextMenu="{StaticResource BlockMenu}"
                                MouseLeftButtonDown="OnBlockClicked"
                                Height="{Binding Height}"
                                Margin="{Binding Top, Converter={StaticResource TimelineOffsetToMargin}}"
                                Background="{Binding Color, Converter={StaticResource EventColorFace}}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="{Binding Color, Converter={StaticResource EventColorBrush}}">
                            <!--
                                時刻は書かない。置かれている場所そのものが時刻なので、
                                短い予定だと時刻だけで埋まって題が読めなくなる。
                                正確な時刻はマウスを載せれば出る
                            -->
                            <StackPanel ClipToBounds="True">
                                <TextBlock Text="{Binding Title}" FontSize="11" LineHeight="14"
                                           Foreground="{DynamicResource InkBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- 作業時間ブロックは点線枠。予定に変換されたわけではない -->
                            <DataTrigger Binding="{Binding IsWorkBlock}" Value="True">
                                <Setter TargetName="Block" Property="Background"
                                        Value="{DynamicResource PanelBrush}" />
                                <Setter TargetName="Block" Property="BorderThickness" Value="1" />
                                <Setter TargetName="Block" Property="ToolTip"
                                        Value="タスクの作業時間。予定ではありません" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <!-- 稼働する日と休業する日で面を分ける（要件書 4.3） -->
                <DataTrigger Binding="{Binding IsWorkingDayLit}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WorkingDayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OffDayBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
</UserControl>
