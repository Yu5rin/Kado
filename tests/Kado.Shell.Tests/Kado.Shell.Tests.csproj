<Project Sdk="Microsoft.NET.Sdk">

  <!--
      Shell/ 配下の「純粋な計算」だけをテストする。

      App プロジェクト（src/Kado.App）は net10.0-windows（UseWPF）で、
      net10.0 のテストプロジェクトからは ProjectReference できない
      （tests/Kado.App.Tests の BackupWiringTests と同じ理由。
      実際に試すと NU1201 で復元が失敗する。net10.0-windows 側を UseWPF のまま
      参照させようとしても、今度は Windows でないと実行できない
      "Microsoft.WindowsDesktop.App" が無くてテストの実行自体が失敗する）。

      Win32 の宣言（NativeMethods.cs）や純粋な計算（ShellGeometry.cs）は
      WPF に一切依存しないので、ソースをファイルとしてリンクし、この
      net10.0 プロジェクトの一部として直にコンパイルする。実行できるのは
      Windows API を実際には呼ばない部分だけ（DllImport は宣言できるだけで、
      呼ばなければ Linux でもコンパイル・実行できる）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kado.Shell.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- DockEdge・ShellMode など、居かたの型だけを借りる -->
    <ProjectReference Include="..\..\src\Kado.Presentation\Kado.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Kado.App\Shell\NativeMethods.cs" Link="Shell\NativeMethods.cs" />
    <Compile Include="..\..\src\Kado.App\Shell\ShellGeometry.cs" Link="Shell\ShellGeometry.cs" />
    <Compile Include="..\..\src\Kado.App\Shell\PopupActivityTracker.cs" Link="Shell\PopupActivityTracker.cs" />
    <!-- AppBar が外れたときの受け方と終了印。WPF/Win32 に触れない部品だけ切り出してある -->
    <Compile Include="..\..\src\Kado.App\Shell\UndockReaction.cs" Link="Shell\UndockReaction.cs" />
    <Compile Include="..\..\src\Kado.App\Shell\WorkAreaMarker.cs" Link="Shell\WorkAreaMarker.cs" />
    <!-- 落ちる・使えなくなる筋を塞ぐ部品のうち、WPF に触れない判断だけを切り出したもの -->
    <Compile Include="..\..\src\Kado.App\Update\ExecutableSwap.cs" Link="Update\ExecutableSwap.cs" />
    <Compile Include="..\..\src\Kado.App\ActivationPipe.cs" Link="ActivationPipe.cs" />
    <Compile Include="..\..\src\Kado.App\StartupArguments.cs" Link="StartupArguments.cs" />
    <Compile Include="..\..\src\Kado.App\Shell\TrayPolicy.cs" Link="Shell\TrayPolicy.cs" />
    <Compile Include="..\..\src\Kado.App\Shell\SessionEndRules.cs" Link="Shell\SessionEndRules.cs" />
    <Compile Include="..\..\src\Kado.App\Shell\FrontMessageBox.cs" Link="Shell\FrontMessageBox.cs" />
    <Compile Include="..\..\src\Kado.App\Google\TokenFileQuarantine.cs" Link="Google\TokenFileQuarantine.cs" />
    <!-- 編集ウィンドウを帯の隣へ置く位置計算。Window/Win32 に依存しないので同じ手が使える -->
    <Compile Include="..\..\src\Kado.App\Editing\EditorWindowPlacement.cs" Link="Editing\EditorWindowPlacement.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
